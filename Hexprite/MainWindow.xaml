<Window x:Class="Hexprite.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        xmlns:vm="clr-namespace:Hexprite.ViewModels"
        xmlns:views="clr-namespace:Hexprite.Views"
        xmlns:converters="clr-namespace:Hexprite.Converters"
        Title="Hexprite"
        MinHeight="650"
        MinWidth="550"
        Height="780"
        Width="1150"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowDrop="True"
        Drop="Window_Drop"
        AllowsTransparency="False"
        core:WindowChromeHelper.ForceRoundedCorners="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ThemeAwareLogoConverter x:Key="ThemeAwareLogoConverter" />
    </Window.Resources>


    <Border Style="{StaticResource MainWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════
     CUSTOM TITLE BAR (menu + caption buttons)
     ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Surface.MenuBar}">
                <DockPanel Margin="0,0,0,1"
                           LastChildFill="True">

                    <!-- 1. CAPTION BUTTONS: Docked Right FIRST so they are never clipped -->
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                MinWidth="10"
                                HorizontalAlignment="Right"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionMinimize_Click"
                                ToolTip="Minimize"
                                Width="44"
                                Height="34"
                                Style="{StaticResource CaptionButtonStyle}">
                            <TextBlock Text="&#xE921;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10" />
                        </Button>
                        <Button Click="CaptionMaximize_Click"
                                ToolTip="Maximize"
                                Width="44"
                                Height="34"
                                Style="{StaticResource CaptionButtonStyle}">
                            <TextBlock x:Name="MaximizeIcon"
                                       Text="&#xE922;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10" />
                        </Button>
                        <Button Click="CaptionClose_Click"
                                ToolTip="Close"
                                Width="44"
                                Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10" />
                        </Button>
                    </StackPanel>

                    <!-- 2. APP ICON: Docked Left -->
                    <Border DockPanel.Dock="Left"
                            Margin="10,0,6,0"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Hexprite;component/Assets/LogoMark.png"
                                        Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>

                    <!-- 3. MENU BAR: Docked Left (will clip if the window is too small) -->
                    <Menu DockPanel.Dock="Left"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center">
                        <MenuItem Header="_File">
                            <MenuItem Header="_New Document"
                                      Command="{Binding NewDocumentCommand}"
                                      InputGestureText="Ctrl+N" />
                            <MenuItem Header="_Open"
                                      Command="{Binding OpenCommand}"
                                      InputGestureText="Ctrl+O" />
                            <MenuItem Header="Open _Recent"
                                      ItemsSource="{Binding RecentFiles}"
                                      IsEnabled="{Binding HasRecentFiles}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding FileName}" />
                                        <Setter Property="ToolTip" Value="{Binding FullPath}" />
                                        <Setter Property="Command" Value="{Binding DataContext.OpenRecentFileCommand, ElementName=RootWindow}" />
                                        <Setter Property="CommandParameter" Value="{Binding FullPath}" />
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                            <MenuItem Header="_Import">
                                <MenuItem Header="From _Code…"
                                          Command="{Binding ImportFromCodeMenuCommand}" />
                                <MenuItem Header="From _File…"
                                          Command="{Binding ImportFromFileMenuCommand}" />
                                <MenuItem Header="Import _Bitmap..."
                                          Command="{Binding ImportBitmapMenuCommand}" />
                                <MenuItem Header="Import _Sprite Sheet / Animation Strip..."
                                          Command="{Binding ImportSpriteSheetMenuCommand}" />
                                <MenuItem Header="Import from _Flipper Zero..."
                                          Command="{Binding ImportFlipperMenuCommand}" />
                                <MenuItem Header="Import _XBM File..."
                                          Command="{Binding ImportXbmMenuCommand}" />
                            </MenuItem>
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="_Save"
                                      Command="{Binding SaveCommand}"
                                      InputGestureText="Ctrl+S" />
                            <MenuItem Header="Save _As..."
                                      Command="{Binding SaveAsCommand}"
                                      InputGestureText="Ctrl+Shift+S" />
                            <MenuItem Header="E_xport As..."
                                      Command="{Binding ExportAsMenuCommand}" />
                            <MenuItem Header="Copy _Generated Code"
                                      Command="{Binding CopyExportCodeMenuCommand}" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="Export to _Flipper Zero..."
                                      Command="{Binding ExportFlipperMenuCommand}" />
                            <MenuItem Header="_Push to Flipper Zero (USB)..."
                                      Command="{Binding DeployFlipperUsbCommand}" />
                            <MenuItem Header="Export to _XBM File..."
                                      Command="{Binding ExportXbmMenuCommand}" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="_Close Tab"
                                      Command="{Binding CloseTabCommand}"
                                      InputGestureText="Ctrl+W" />
                        </MenuItem>
                        <MenuItem Header="_Edit" IsEnabled="{Binding HasOpenDocument}">
                            <MenuItem Header="_Undo"
                                      Command="{Binding ActiveDocument.UndoCommand}"
                                      InputGestureText="Ctrl+Z" />
                            <MenuItem Header="_Redo"
                                      Command="{Binding ActiveDocument.RedoCommand}"
                                      InputGestureText="Ctrl+Y" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="Cu_t"
                                      Command="{Binding ActiveDocument.CutSelectionCommand}"
                                      InputGestureText="Ctrl+X" />
                            <MenuItem Header="_Copy"
                                      Command="{Binding ActiveDocument.CopySelectionCommand}"
                                      InputGestureText="Ctrl+C" />
                            <MenuItem Header="_Paste"
                                      Command="{Binding ActiveDocument.PasteCommand}"
                                      InputGestureText="Ctrl+V" />
                            <MenuItem Header="Select _All"
                                      Command="{Binding ActiveDocument.SelectAllCommand}"
                                      InputGestureText="Ctrl+A" />
                            <MenuItem Header="D_eselect"
                                      Command="{Binding ActiveDocument.DeselectCommand}"
                                      InputGestureText="Ctrl+D" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="_Invert"
                                      Command="{Binding ActiveDocument.InvertCommand}"
                                      InputGestureText="Ctrl+I" />
                            <MenuItem Header="O_utline..."
                                      Command="{Binding ActiveDocument.OutlineCommand}" />
                            <MenuItem Header="_Clear Canvas"
                                      Command="{Binding ActiveDocument.ClearCommand}" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="Insert _Flipper Template">
                                <MenuItem Header="Status _Header Bar (128x12)" Command="{Binding ApplyFlipperTemplateCommand}" CommandParameter="HeaderBar" />
                                <MenuItem Header="_Dialog / Alert Box" Command="{Binding ApplyFlipperTemplateCommand}" CommandParameter="DialogBox" />
                                <MenuItem Header="_List View Layout" Command="{Binding ApplyFlipperTemplateCommand}" CommandParameter="ListView" />
                                <MenuItem Header="_10x10 App Icon Frame Guide" Command="{Binding ApplyFlipperTemplateCommand}" CommandParameter="AppIconGuide" />
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="_Image" IsEnabled="{Binding HasOpenDocument}">
                            <MenuItem Header="Canvas _Size..."
                                      Command="{Binding ResizeCanvasCommand}" />
                            <MenuItem Header="_Rotate Canvas">
                                <MenuItem Header="90° _Clockwise"
                                          Command="{Binding ActiveDocument.RotateCanvasCWCommand}" />
                                <MenuItem Header="90° Counter_clockwise"
                                          Command="{Binding ActiveDocument.RotateCanvasCCWCommand}" />
                                <MenuItem Header="_180°"
                                          Command="{Binding ActiveDocument.RotateCanvas180Command}" />
                            </MenuItem>
                            <MenuItem Header="_Flip Canvas">
                                <MenuItem Header="_Horizontal"
                                          Command="{Binding ActiveDocument.FlipCanvasHorizontalCommand}" />
                                <MenuItem Header="_Vertical"
                                          Command="{Binding ActiveDocument.FlipCanvasVerticalCommand}" />
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="_Select" IsEnabled="{Binding HasOpenDocument}">
                            <MenuItem Header="_Transform"
                                      Command="{Binding ActiveDocument.BeginSelectionTransformCommand}"
                                      InputGestureText="Ctrl+T" />
                            <MenuItem Header="_Flip Selection">
                                <MenuItem Header="_Horizontal"
                                          Command="{Binding ActiveDocument.FlipSelectionHorizontalCommand}" />
                                <MenuItem Header="_Vertical"
                                          Command="{Binding ActiveDocument.FlipSelectionVerticalCommand}" />
                            </MenuItem>
                            <MenuItem Header="_Delete Selection"
                                      Command="{Binding ActiveDocument.DeleteSelectionCommand}"
                                      InputGestureText="Del" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="D_eselect"
                                      Command="{Binding ActiveDocument.DeselectCommand}"
                                      InputGestureText="Ctrl+D" />
                        </MenuItem>
                        <MenuItem Header="_Animation" IsEnabled="{Binding HasOpenDocument}">
                            <MenuItem Header="Toggle Animation Mode" Command="{Binding ActiveDocument.ToggleAnimationCommand}" />
                            <MenuItem Header="Play / Pause" Command="{Binding ActiveDocument.TogglePlaybackCommand}" InputGestureText="Space" />
                            <MenuItem Header="Toggle Onion Skin" Command="{Binding ActiveDocument.ToggleOnionSkinCommand}" InputGestureText="O" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="Previous Frame" InputGestureText="," />
                            <MenuItem Header="Next Frame" InputGestureText="." />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="Add Frame" Command="{Binding ActiveDocument.AddFrameCommand}" InputGestureText="Alt+N" />
                            <MenuItem Header="Duplicate Frame" Command="{Binding ActiveDocument.DuplicateFrameCommand}" />
                            <MenuItem Header="Delete Frame" Command="{Binding ActiveDocument.DeleteFrameCommand}" />
                            <MenuItem Header="Clear Frame" Command="{Binding ActiveDocument.ClearFrameCommand}" />
                        </MenuItem>
                        <MenuItem Header="_View">
                            <MenuItem Header="Show _Grid"
                                      IsCheckable="True"
                                      IsChecked="{Binding ActiveDocument.ShowGridLines}"
                                      IsEnabled="{Binding HasOpenDocument}" />
                            <MenuItem Header="Show _Brush Outline"
                                      IsCheckable="True"
                                      IsChecked="{Binding ActiveDocument.IsBrushCursorVisible}"
                                      IsEnabled="{Binding HasOpenDocument}" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="Zoom _In"
                                      Command="{x:Static NavigationCommands.IncreaseZoom}"
                                      InputGestureText="Ctrl++" />
                            <MenuItem Header="Zoom _Out"
                                      Command="{x:Static NavigationCommands.DecreaseZoom}"
                                      InputGestureText="Ctrl+-" />
                            <MenuItem Header="_Reset Zoom"
                                      Command="{x:Static NavigationCommands.Zoom}"
                                      InputGestureText="Ctrl+0" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="_Theme">
                                <MenuItem Header="_Dim"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsDimTheme, Mode=OneWay}"
                                          Command="{Binding SwitchThemeCommand}"
                                          CommandParameter="Dim" />
                                <MenuItem Header="_Light"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                          Command="{Binding SwitchThemeCommand}"
                                          CommandParameter="Light" />
                                <MenuItem Header="_Dark"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                          Command="{Binding SwitchThemeCommand}"
                                          CommandParameter="Dark" />
                                <MenuItem Header="_Flipper"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsFlipperTheme, Mode=OneWay}"
                                          Command="{Binding SwitchThemeCommand}"
                                          CommandParameter="Flipper" />
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="_Tools">
                            <MenuItem Header="Sprite Sheet _Slicer Studio..."
                                      Command="{Binding OpenSpriteSheetSlicerCommand}" />
                            <MenuItem Header="Display _Simulation (OLED / LCD / e-Paper)..."
                                      Command="{Binding OpenDisplaySimulationCommand}" />
                            <MenuItem Header="Flipper _Live Screen Mirror (USB)..."
                                      Command="{Binding OpenFlipperScreenMirrorCommand}" />
                            <MenuItem Header="_Push to Flipper Zero (USB)..."
                                      Command="{Binding DeployFlipperUsbCommand}" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="Flipper _Schedule Matrix..."
                                      Command="{Binding OpenFlipperScheduleMatrixCommand}" />
                            <MenuItem Header="Flipper _Matrix Simulator..."
                                      Command="{Binding OpenFlipperMatrixSimulatorCommand}" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="_Pop-Out Code Viewer..."
                                      Command="{Binding OpenCodeViewerCommand}" />
                            <MenuItem Header="_Copy Generated Code"
                                      Command="{Binding CopyExportCodeMenuCommand}" />
                        </MenuItem>
                        <MenuItem Header="_Window">
                            <MenuItem Header="Tool _Sidebar"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsToolSidebarVisible, Mode=TwoWay}" />
                            <MenuItem Header="_Layers Panel"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsLayersPanelVisible, Mode=TwoWay}" />
                            <MenuItem Header="_Right Sidebar"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsRightSidebarVisible, Mode=TwoWay}" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="_Timeline"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsTimelineVisible, Mode=TwoWay}" />
                            <MenuItem Header="_Status Bar"
                                      IsCheckable="True"
                                      IsChecked="{Binding IsStatusBarVisible, Mode=TwoWay}" />
                        </MenuItem>
                        <MenuItem Header="_Help">
                            <MenuItem Header="_Check for Updates..."
                                      Command="{Binding CheckForUpdatesCommand}" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="_Documentation"
                                      Command="{Binding OpenDocumentationCommand}"
                                      InputGestureText="F1" />
                            <MenuItem Header="_Keyboard Shortcuts"
                                      Command="{Binding OpenKeyboardShortcutsCommand}"
                                      InputGestureText="Ctrl+/" />
                            <MenuItem Header="_Privacy Settings..."
                                      Command="{Binding OpenPrivacySettingsCommand}" />
                            <MenuItem Header="Send _Feedback..."
                                      Command="{Binding SendFeedbackCommand}" />
                            <MenuItem Header="_Report a Bug..."
                                      Command="{Binding ReportBugCommand}" />
                            <Separator Style="{StaticResource MenuSeparatorStyle}" />
                            <MenuItem Header="_About Hexprite"
                                      Command="{Binding ShowAboutCommand}" />
                        </MenuItem>
                    </Menu>
 
                    <!-- 4. DRAGGABLE TITLE BAR AREA: Fills remaining space in the middle -->
                    <Border Background="Transparent" />

                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
             UPDATE NOTIFICATION BANNER
             ═══════════════════════════════════════════════════════════════ -->
            <Border x:Name="UpdateBanner"
                    Grid.Row="1"
                    Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource Brush.Surface.Elevated}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                    BorderThickness="0,0,0,1"
                    Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="&#xE74A;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource Brush.Accent.Base}" />

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontSize="12">
                        <Run Text="Hexprite" />
                        <Run Text="{Binding AvailableUpdate.LatestVersionDisplay, FallbackValue=''}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Accent.Base}" />
                        <Run Text="is available." />
                    </TextBlock>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="Download"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding DownloadInstallerCommand}"
                                ToolTip="Download update installer"
                                Margin="0,0,6,0"
                                MinHeight="22"
                                Padding="10,2"
                                FontSize="11" />
                        <Button Content="View Release"
                                Style="{StaticResource ModernButtonStyle}"
                                Command="{Binding ViewReleaseCommand}"
                                ToolTip="View release notes on GitHub"
                                Margin="0,0,8,0"
                                MinHeight="22"
                                Padding="10,2"
                                FontSize="11" />
                        <Button Style="{StaticResource CaptionCloseButtonStyle}"
                                Command="{Binding DismissUpdateCommand}"
                                ToolTip="Dismiss"
                                Width="22"
                                Height="22">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="9" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ═══════════════════════════════════════════════════════════════
             TAB BAR
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface.MenuBar}"
                BorderBrush="{DynamicResource Brush.Border.Separator}"
                BorderThickness="0,0,0,1"
                Padding="8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Active Files Dropdown Button -->
                <ToggleButton x:Name="ActiveFilesButton"
                              Grid.Column="1"
                              Width="28"
                              Margin="6,2,0,2"
                              Padding="0"
                              VerticalAlignment="Stretch"
                              ClickMode="Press"
                              Click="OpenTabsButton_Click"
                              Visibility="{Binding HasOpenDocument, Converter={StaticResource BooleanToVisibilityConverter}}"
                              ToolTip="Active Files">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <!-- Down Chevron Icon -->
                    <TextBlock Text="&#xE70D;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    <ToggleButton.ContextMenu>
                        <ContextMenu x:Name="ActiveFilesMenu"
                                     ItemsSource="{Binding OpenDocuments}"
                                     Placement="Bottom"
                                     Closed="ActiveFilesMenu_Closed">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <EventSetter Event="Click" Handler="DropdownTabItem_Click" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Border x:Name="Border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderThickness="0"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}"
                                                        Margin="4,2">
                                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.Surface.Selected}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Highlight}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                            <ContextMenu.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="200" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Document Icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="&#xE7C3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}" />
                                        
                                        <!-- Title -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Title}" 
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}" />
                                        
                                        <!-- Close Button -->
                                        <Button Grid.Column="2"
                                                x:Name="CloseBtn"
                                                Content="&#xE711;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="8"
                                                Padding="4"
                                                Width="22" Height="22"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                Click="DropdownTabClose_Click"
                                                Tag="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource Brush.Text.Muted}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Elevated}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ContextMenu.ItemTemplate>
                        </ContextMenu>
                    </ToggleButton.ContextMenu>
                </ToggleButton>

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="TabBar_PreviewMouseWheel">
                  <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding OpenDocuments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TabBorder"
                                    Margin="0,2,2,2"
                                    CornerRadius="6"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Close Tab"
                                                  Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Close Other Tabs"
                                                  Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator Style="{StaticResource MenuSeparatorStyle}" />
                                        <MenuItem Header="Close All Tabs"
                                                  Command="{Binding PlacementTarget.Tag.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}" />
                                            </DataTrigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                            </MultiTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,2,4,2">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,6,0" />
                                        <Button x:Name="CloseBtn"
                                                Content="✕"
                                                FontSize="10"
                                                Padding="0"
                                                MinWidth="20" MinHeight="20"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                Click="TabClose_Click"
                                                Tag="{Binding}"
                                                Opacity="0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="3"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Status.Danger}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                    <!-- Active tab accent indicator -->
                                    <Border x:Name="ActiveIndicator" Grid.Row="1"
                                            Height="2" CornerRadius="1"
                                            Margin="4,0,4,2"
                                            Opacity="0"
                                            Background="{DynamicResource Brush.Accent.Base}"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                                    <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
                                </DataTrigger>
                                <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- New tab button -->
                <Button Content="+"
                        FontSize="12"
                        FontWeight="Bold"
                        Padding="8,3"
                        Margin="0,2,0,2"
                        VerticalAlignment="Center"
                        Command="{Binding NewDocumentCommand}"
                        ToolTip="New canvas (Ctrl+N)">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
              </StackPanel>
            </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             MAIN CONTENT AREA
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3"
              DataContext="{Binding ActiveDocument}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- SPRITE EDITOR UI -->
            <Grid x:Name="SpriteEditorGrid" Grid.RowSpan="2" Margin="4,4,4,4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static core:DocumentMode.Sprite}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="CanvasColumn"
                                      Width="*"
                                      MinWidth="380" />
                    <ColumnDefinition x:Name="LeftSplitterColumn" Width="4" />
                    <ColumnDefinition x:Name="LayersColumn"
                                      Width="220"
                                      MinWidth="150"
                                      MaxWidth="450" />
                    <ColumnDefinition x:Name="RightSplitterColumn" Width="4" />
                    <ColumnDefinition x:Name="RightSidebarColumn"
                                      Width="300"
                                      MinWidth="240"
                                      MaxWidth="460" />
                </Grid.ColumnDefinitions>

                <views:ToolSidebarPanel x:Name="ToolSidebar" Grid.Row="0" Grid.Column="0" Margin="0,2,4,2"
                                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />

                <views:CanvasPanel x:Name="Canvas" Grid.Row="0" Grid.Column="1" 
                                   Margin="2,2,2,2"
                                   ZoomInClicked="BtnZoomIn_Click"
                                   ZoomOutClicked="BtnZoomOut_Click"
                                   ZoomResetClicked="BtnZoomReset_Click" />

                <Thumb x:Name="LeftPanelSplitter"
                       Grid.Row="0" Grid.Column="2"
                       Width="4"
                       HorizontalAlignment="Stretch"
                       DragStarted="PanelSplitter_DragStarted"
                       DragDelta="PanelSplitter_DragDelta"
                       DragCompleted="PanelSplitter_DragCompleted"
                       Cursor="SizeWE">
                    <Thumb.Style>
                        <Style TargetType="Thumb">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource Brush.Accent.Base}" Opacity="0" x:Name="Bg" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Thumb.Style>
                </Thumb>

                <views:LayersPanel x:Name="LayersPanel" Grid.RowSpan="2" Grid.Column="3" Margin="0" />

                <Thumb x:Name="RightPanelSplitter"
                       Grid.RowSpan="2"
                       Grid.Column="4"
                       Width="4"
                       HorizontalAlignment="Stretch"
                       DragStarted="PanelSplitter_DragStarted"
                       DragDelta="PanelSplitter_DragDelta"
                       DragCompleted="PanelSplitter_DragCompleted"
                       Cursor="SizeWE">
                    <Thumb.Style>
                        <Style TargetType="Thumb">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource Brush.Accent.Base}" Opacity="0" x:Name="Bg" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Thumb.Style>
                </Thumb>

                <views:SidebarPanel x:Name="RightSidebarPanel" Grid.RowSpan="2" Grid.Column="5" Margin="0" />

                <views:TimelinePanel x:Name="TimelinePanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,4,4" />
            </Grid>

            <!-- FONT EDITOR UI -->
            <Grid x:Name="FontEditorGrid" Grid.RowSpan="2" Margin="4,4,4,4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static core:DocumentMode.Font}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:FontEditorPanel />
            </Grid>

            <!-- ASSET PACK / SCHEDULE MATRIX EDITOR UI -->
            <Grid x:Name="AssetPackEditorGrid" Grid.RowSpan="2" Margin="4,4,4,4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="{x:Static core:DocumentMode.AssetPack}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:AssetPackEditorPanel DataContext="{Binding MatrixViewModel}" />
            </Grid>
        </Grid>
        <!-- /Main content -->

        <views:StatusBarPanel x:Name="StatusBarPanel" Grid.Row="4" DataContext="{Binding ActiveDocument}" />

        <!-- ═══════════════════════════════════════════════════════════════
             WELCOME SCREEN (shown when no documents are open)
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Grid.RowSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasOpenDocument}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,20,24,24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="580">
                <!-- App branding -->
                <Image Width="190"
                       Height="44"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Source>
                        <Binding Path="DataContext.CurrentThemeName" RelativeSource="{RelativeSource AncestorType=Window}" FallbackValue="pack://application:,,,/Assets/Logo.png">
                            <Binding.Converter>
                                <converters:ThemeAwareLogoConverter />
                            </Binding.Converter>
                        </Binding>
                    </Image.Source>
                </Image>
                <TextBlock Text="Pixel art &amp; animation toolkit for embedded displays" 
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Muted}" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28" />

                <!-- ── 1. CREATE NEW ── -->
                <TextBlock Text="CREATE NEW"
                           Style="{StaticResource WelcomeSectionHeaderStyle}"
                           HorizontalAlignment="Center"/>
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <!-- Sprite Canvas Card -->
                    <Button Style="{StaticResource WelcomeCardStyle}"
                            Command="{Binding NewDocumentCommand}"
                            CommandParameter="Sprite:Monochrome:128x64"
                            ToolTip="Create 128×64 Monochrome Sprite Canvas">
                        <StackPanel>
                            <TextBlock Text="SPRITE CANVAS" 
                                       FontSize="9.5" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource Brush.Accent.Base}" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Pixel Art &amp; Animation" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Brush.Text.Primary}" 
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="128 × 64 Default" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource Brush.Text.Muted}" 
                                       Margin="0,0,0,8"/>
                            <Border Style="{StaticResource FileBadgeStyle}" HorizontalAlignment="Left">
                                <TextBlock Text="MONO / COLOR" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Font Editor Card -->
                    <Button Style="{StaticResource WelcomeCardStyle}"
                            Command="{Binding NewDocumentCommand}"
                            CommandParameter="Font:Monochrome:8x8"
                            ToolTip="Create 8×8 Monochrome Font Editor">
                        <StackPanel>
                            <TextBlock Text="FONT EDITOR" 
                                       FontSize="9.5" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource Brush.Accent.Base}" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Bitmap Glyph Matrix" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Brush.Text.Primary}" 
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="8 × 8 Default" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource Brush.Text.Muted}" 
                                       Margin="0,0,0,8"/>
                            <Border Style="{StaticResource FileBadgeStyle}" HorizontalAlignment="Left">
                                <TextBlock Text="HEXPFONT / BDF" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Flipper Asset Pack Card -->
                    <Button Style="{StaticResource WelcomeCardStyle}"
                            Command="{Binding NewAssetPackCommand}"
                            ToolTip="Create Flipper Zero Dolphin Schedule Matrix Pack">
                        <StackPanel>
                            <TextBlock Text="ASSET PACK" 
                                       FontSize="9.5" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource Brush.Accent.Base}" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Schedule Matrix" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Brush.Text.Primary}" 
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="30 × 15 Balancer" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource Brush.Text.Muted}" 
                                       Margin="0,0,0,8"/>
                            <Border Style="{StaticResource FileBadgeStyle}" HorizontalAlignment="Left">
                                <TextBlock Text="HEXPACK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Button Content="Custom Size…"
                        Command="{Binding NewDocumentCommand}"
                        HorizontalAlignment="Center"
                        Style="{StaticResource QuickStartButtonStyle}"
                        Margin="0,0,0,16"
                        Padding="14,4"
                        FontSize="11"/>

                <!-- Divider -->
                <Border Height="1" 
                        Background="{DynamicResource Brush.Border.Separator}" 
                        Margin="40,0,40,16"/>

                <!-- ── 2. RECENT FILES / OPEN ── -->
                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Recent items list (shown only when recent files exist) -->
                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,10"
                                Visibility="{Binding HasRecentFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="RECENT FILES"
                                   Style="{StaticResource WelcomeSectionHeaderStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding WelcomeRecentFiles}"
                                      Margin="4,0,4,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RecentFileButtonStyle}"
                                            Command="{Binding DataContext.OpenRecentFileCommand, ElementName=RootWindow}"
                                            CommandParameter="{Binding FullPath}"
                                            ToolTip="{Binding FullPath}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open"
                                                          Command="{Binding DataContext.OpenRecentFileCommand, ElementName=RootWindow}"
                                                          CommandParameter="{Binding FullPath}" />
                                                <MenuItem Header="Open Containing Folder"
                                                          Command="{Binding DataContext.OpenContainingFolderCommand, ElementName=RootWindow}"
                                                          CommandParameter="{Binding FullPath}" />
                                                <MenuItem Header="Copy Full Path"
                                                          Command="{Binding DataContext.CopyRecentFilePathCommand, ElementName=RootWindow}"
                                                          CommandParameter="{Binding FullPath}" />
                                                <Separator />
                                                <MenuItem Header="Remove from Recent"
                                                          Command="{Binding DataContext.RemoveRecentFileCommand, ElementName=RootWindow}"
                                                          CommandParameter="{Binding FullPath}" />
                                                <MenuItem Header="Clear Recent List"
                                                          Command="{Binding DataContext.ClearRecentFilesCommand, ElementName=RootWindow}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid Margin="6,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding FileName}" 
                                                       FontSize="12"
                                                       FontWeight="Medium" 
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       TextTrimming="CharacterEllipsis" 
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" 
                                                    Style="{StaticResource FileBadgeStyle}" 
                                                    Margin="8,0">
                                                <TextBlock Text="{Binding FormatBadge}" 
                                                           FontSize="9" 
                                                           FontWeight="Bold" 
                                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding RelativeTime}" 
                                                       Foreground="{DynamicResource Brush.Text.Muted}" 
                                                       FontSize="11" 
                                                       MinWidth="64"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    ToolTip="Remove from recent files"
                                                    Command="{Binding DataContext.RemoveRecentFileCommand, ElementName=RootWindow}"
                                                    CommandParameter="{Binding FullPath}"
                                                    Style="{StaticResource CompactIconButtonStyle}"
                                                    FontSize="8"
                                                    Width="18"
                                                    Height="18"
                                                    MinWidth="18"
                                                    MinHeight="18"
                                                    Margin="8,0,0,0"
                                                    Opacity="0.5"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Open File & Import uniform buttons grid -->
                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,2,0,0">
                        <Button Content="Open File…" 
                                Command="{Binding OpenCommand}" 
                                Height="32"
                                FontSize="11"
                                ToolTip="Open any supported Hexprite file, project, or asset pack"
                                Style="{StaticResource AccentButtonStyle}"
                                Margin="3,0" />
                        <Button Content="Import File…"
                                Command="{Binding ImportFromFileMenuCommand}"
                                Height="32"
                                FontSize="11"
                                ToolTip="Import sprite from C/C++/Arduino/Python source file"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="3,0" />
                        <Button Content="Import Bitmap…"
                                Command="{Binding ImportBitmapMenuCommand}"
                                Height="32"
                                FontSize="11"
                                ToolTip="Import PNG, GIF, BMP, or JPG image with 1-bit dithering"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="3,0" />
                        <Button Content="Import Flipper…"
                                Command="{Binding ImportFlipperMenuCommand}"
                                Height="32"
                                FontSize="11"
                                ToolTip="Import Flipper Zero animation (meta.txt) or bitmap (.bm)"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="3,0" />
                        <Button Content="Import Code…"
                                Command="{Binding ImportFromCodeMenuCommand}"
                                Height="32"
                                FontSize="11"
                                ToolTip="Paste C/C++ array or hex bytes from clipboard"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="3,0" />
                    </UniformGrid>
                </Grid>

                <!-- Divider -->
                <Border Height="1" 
                        Background="{DynamicResource Brush.Border.Separator}" 
                        Margin="40,0,40,16"/>

                <!-- ── 3. SHORTCUT HINTS ── -->
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,2,0,0">
                    <Border Style="{StaticResource KeyCapBadgeStyle}">
                        <TextBlock Text="Ctrl+N" FontSize="10" FontFamily="{DynamicResource Font.Code}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                    </Border>
                    <TextBlock Text="New" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <Border Style="{StaticResource KeyCapBadgeStyle}">
                        <TextBlock Text="Ctrl+O" FontSize="10" FontFamily="{DynamicResource Font.Code}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                    </Border>
                    <TextBlock Text="Open" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#80000000"
              Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Importing image..." 
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"/>
            </StackPanel>
        </Grid>

        </Grid>
    </Border>
</Window>