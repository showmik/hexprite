<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UserSecretsId>hexprite-9c4e2b1a-7d8f-4e3c-9a1b-6f5e4d3c2b1a</UserSecretsId>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
		<IsPackable>false</IsPackable>

		<!-- App Metadata for the .exe properties -->
		<Product>Hexprite</Product>
		<Company>Intisar</Company>
		<Description>Graphics editor for embedded displays</Description>
		<Version>0.3.0-beta</Version>
		<Copyright>Copyright (c) 2026 Intisar Bin Naim</Copyright>
		<PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

		<!-- Single File Publish Rules -->
		<PublishSingleFile Condition="'$(PublishProtocol)' != ''">true</PublishSingleFile>
		<SelfContained Condition="'$(PublishProtocol)' != ''">true</SelfContained>
		<IncludeNativeLibrariesForSelfExtract Condition="'$(PublishProtocol)' != ''">true</IncludeNativeLibrariesForSelfExtract>

		<!-- Build Quality & Analysis -->
		<AnalysisLevel>latest-recommended</AnalysisLevel>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<Deterministic>true</Deterministic>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Assets\favicon.ico" />
		<EmbeddedResource Include="Assets\HexpritePreview\**\*" LogicalName="EmbeddedAssets/HexpritePreview/%(RecursiveDir)%(Filename)%(Extension)" />
		<EmbeddedResource Include="Assets\HexpritePreview-Standalone-Arduino\**\*" LogicalName="EmbeddedAssets/HexpritePreview-Standalone-Arduino/%(RecursiveDir)%(Filename)%(Extension)" />
		<EmbeddedResource Include="Assets\HexpritePreview-Standalone-PlatformIO\**\*" LogicalName="EmbeddedAssets/HexpritePreview-Standalone-PlatformIO/%(RecursiveDir)%(Filename)%(Extension)" />
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- MVVM & Framework -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<!-- Configuration & Dependency Injection -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
	</ItemGroup>

	<!-- Logging & Telemetry -->
	<ItemGroup>
		<PackageReference Include="Sentry" Version="6.11.1" />
		<PackageReference Include="Sentry.Serilog" Version="6.11.1" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
		<PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<!-- Hardware & System -->
	<ItemGroup>
		<PackageReference Include="System.IO.Ports" Version="10.0.12" />
		<PackageReference Include="System.Management" Version="10.0.12" />
	</ItemGroup>

	<!-- Code Analyzers -->
	<ItemGroup>
		<PackageReference Include="Meziantou.Analyzer" Version="3.0.266">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="SonarAnalyzer.CSharp" Version="10.34.0.3385">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<!-- WPF Embedded Resources -->
	<ItemGroup>
		<Resource Include="Assets\*.cur" />
		<Resource Include="Assets\AppIcon.png" />
		<Resource Include="Assets\Logo.png" />
		<Resource Include="Assets\LogoLight.png" />
		<Resource Include="Assets\LogoMark.png" />
		<Resource Include="Assets\Fonts\*.ttf" />
		<Resource Include="Assets\Fonts\*.otf" />
	</ItemGroup>

	<!-- Solution Documentation Items -->
	<ItemGroup>
		<None Include="..\LICENSE" />
		<None Include="..\README.md" />
	</ItemGroup>

</Project>