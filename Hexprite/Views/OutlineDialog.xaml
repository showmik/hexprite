<Window x:Class="Hexprite.Views.OutlineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        xmlns:behaviors="clr-namespace:Hexprite.Behaviors"
        Title="Outline"
        Width="360" Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        core:WindowChromeHelper.ForceRoundedCorners="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="8,0,0,0" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionClose_Click" ToolTip="Close" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="OUTLINE"
                           Style="{StaticResource HeaderStyle}"
                           FontSize="14"
                           Margin="0,0,0,12" />

                <!-- Outline Shape -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Shape"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               Width="70" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbCircle"
                                     GroupName="OutlineShape"
                                     Content="Circle"
                                     IsChecked="True"
                                     Style="{StaticResource ChipButtonStyle}" />
                        <RadioButton x:Name="RbSquare"
                                     GroupName="OutlineShape"
                                     Content="Square"
                                     Style="{StaticResource ChipButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Padding -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Padding"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               Width="70" />
                    <Slider x:Name="SliderPadding"
                            Width="150"
                            Minimum="0" Maximum="16"
                            Value="1"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            VerticalAlignment="Center"
                            ValueChanged="SliderPadding_ValueChanged" />
                    <TextBox x:Name="TxtPadding"
                             Text="1"
                             Width="50" Height="28"
                             Style="{StaticResource NumericTextBoxStyle}"
                             behaviors:NumericScrubBehavior.MinValue="0"
                             behaviors:NumericScrubBehavior.MaxValue="16"
                             PreviewTextInput="NumberOnly"
                             LostFocus="TxtPadding_LostFocus"
                             Margin="8,0,0,0" />
                    <TextBlock Text="px"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>

                <!-- Thickness -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Thickness"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               Width="70" />
                    <Slider x:Name="SliderThickness"
                            Width="150"
                            Minimum="1" Maximum="16"
                            Value="1"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            VerticalAlignment="Center"
                            ValueChanged="SliderThickness_ValueChanged" />
                    <TextBox x:Name="TxtThickness"
                             Text="1"
                             Width="50" Height="28"
                             Style="{StaticResource NumericTextBoxStyle}"
                             behaviors:NumericScrubBehavior.MinValue="1"
                             behaviors:NumericScrubBehavior.MaxValue="16"
                             PreviewTextInput="NumberOnly"
                             LostFocus="TxtThickness_LostFocus"
                             Margin="8,0,0,0" />
                    <TextBlock Text="px"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>

                <!-- Placement -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Placement"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               Width="70" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbOutside"
                                     GroupName="OutlinePlacement"
                                     Content="Outside"
                                     IsChecked="True"
                                     Style="{StaticResource ChipButtonStyle}" />
                        <RadioButton x:Name="RbInside"
                                     GroupName="OutlinePlacement"
                                     Content="Inside"
                                     Style="{StaticResource ChipButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- OK / Cancel -->
                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Width="90" MinHeight="30"
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="0,0,8,0"
                            Click="Cancel_Click" />
                    <Button Content="Apply"
                            Width="120" MinHeight="30"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Apply_Click"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
