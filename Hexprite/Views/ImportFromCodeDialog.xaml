<Window x:Class="Hexprite.Views.ImportFromCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        xmlns:behaviors="clr-namespace:Hexprite.Behaviors"
        Title="Import from Code"
        Width="820" Height="600"
        MinWidth="700" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        core:WindowChromeHelper.ForceRoundedCorners="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hexprite;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="Font.Primary">Segoe UI</FontFamily>
            <FontFamily x:Key="Font.Code">Consolas</FontFamily>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                        <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Brush.Accent.Base}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionClose_Click" ToolTip="Close" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN CONTENT (2-COLUMN STUDIO) -->
            <Grid Grid.Row="1" Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="270" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: CODE STUDIO & PARAMETERS -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header & Actions -->
                        <RowDefinition Height="*" />    <!-- Code Editor with Watermark -->
                        <RowDefinition Height="Auto" /> <!-- Dimension controls & Presets -->
                        <RowDefinition Height="Auto" /> <!-- Format Dropdown -->
                        <RowDefinition Height="Auto" /> <!-- Status Card -->
                        <RowDefinition Height="Auto" /> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header Row with Format Badge & Clear -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Text="IMPORT FROM CODE"
                                       Style="{StaticResource HeaderStyle}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="Paste C/C++ array, Arduino sketch, binary literals, or hex code"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="11" />
                        </StackPanel>

                        <Button x:Name="BtnClear"
                                Grid.Column="2"
                                Content="Clear"
                                ToolTip="Clear code editor"
                                Height="24"
                                Padding="10,0"
                                FontSize="11"
                                Style="{StaticResource ModernButtonStyle}"
                                VerticalAlignment="Center"
                                Click="BtnClear_Click" />
                    </Grid>

                    <!-- Code Editor with Watermark -->
                    <Border Grid.Row="1"
                            Style="{StaticResource CodeEditorBorderStyle}"
                            Margin="0,0,0,10">
                        <Grid>
                            <TextBox x:Name="TxtCode"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="{DynamicResource Font.Code}"
                                     FontSize="12"
                                     Background="Transparent"
                                     Foreground="{DynamicResource Brush.Code.Punctuation}"
                                     BorderThickness="0"
                                     Padding="10"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextChanged="TxtCode_TextChanged" />

                            <TextBlock x:Name="TxtWatermark"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       Opacity="0.45"
                                       FontFamily="{DynamicResource Font.Code}"
                                       FontSize="11"
                                       Margin="12,11,0,0"
                                       Text="const uint8_t sprite[] = {&#x0a;    0b00111100, //   ****&#x0a;    0b01000010, //  *    *&#x0a;    0b10100101, // * *  * *&#x0a;    0b10000001, // *      *&#x0a;    0b10100101, // * *  * *&#x0a;    0b10011001, // *  **  *&#x0a;    0b01000010, //  *    *&#x0a;    0b00111100  //   ****&#x0a;};" />
                        </Grid>
                    </Border>

                    <!-- Dimension Controls Card -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Brush.Border.Base}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Width / Height Inputs + Swap + Detection Hint -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Width"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBox x:Name="TxtWidth"
                                         Grid.Column="1"
                                         Text="8"
                                         Width="50" Height="26"
                                         Style="{StaticResource NumericTextBoxStyle}"
                                         behaviors:NumericScrubBehavior.MinValue="1"
                                         behaviors:NumericScrubBehavior.MaxValue="512"
                                         PreviewTextInput="NumberOnly"
                                         TextChanged="Dimension_TextChanged"
                                         Margin="0,0,6,0" />

                                <Button x:Name="BtnSwap"
                                        Grid.Column="2"
                                        ToolTip="Swap Width and Height"
                                        Width="26" Height="26"
                                        Padding="0"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="BtnSwap_Click"
                                        Margin="0,0,8,0">
                                    <Path Data="M 1,4.5 L 11,4.5 M 8,1.5 L 11,4.5 L 8,7.5 M 11,8.5 L 1,8.5 M 4,5.5 L 1,8.5 L 4,11.5"
                                          Stroke="{DynamicResource Brush.Text.Primary}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Button>

                                <TextBlock Grid.Column="3"
                                           Text="Height"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBox x:Name="TxtHeight"
                                         Grid.Column="4"
                                         Text="8"
                                         Width="50" Height="26"
                                         Style="{StaticResource NumericTextBoxStyle}"
                                         behaviors:NumericScrubBehavior.MinValue="1"
                                         behaviors:NumericScrubBehavior.MaxValue="512"
                                         PreviewTextInput="NumberOnly"
                                         TextChanged="Dimension_TextChanged"
                                         Margin="0,0,10,0" />

                                <TextBlock x:Name="TxtDetectionHint"
                                           Grid.Column="5"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="(auto-detected)" />
                            </Grid>

                            <!-- Quick Presets Row -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Presets:"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />

                                <Button Content="Auto" ToolTip="Reset to auto-detected dimensions"
                                        Height="22" MinHeight="0" Padding="8,0" FontSize="10"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="PresetAuto_Click" Margin="0,0,4,0" />
                                <Button Content="8×8"
                                        Height="22" MinHeight="0" Padding="8,0" FontSize="10"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="Preset8x8_Click" Margin="0,0,4,0" />
                                <Button Content="16×16"
                                        Height="22" MinHeight="0" Padding="8,0" FontSize="10"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="Preset16x16_Click" Margin="0,0,4,0" />
                                <Button Content="32×32"
                                        Height="22" MinHeight="0" Padding="8,0" FontSize="10"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="Preset32x32_Click" Margin="0,0,4,0" />
                                <Button Content="128×64"
                                        Height="22" MinHeight="0" Padding="8,0" FontSize="10"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="Preset128x64_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Format Override Row -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Format"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Width="50"
                                   Margin="0,0,6,0" />
                        <ComboBox x:Name="CboFormat"
                                  Grid.Column="1"
                                  Height="28"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  SelectionChanged="CboFormat_SelectionChanged">
                            <ComboBoxItem Content="Adafruit GFX / Standard C (MSB-first)" Tag="AdafruitGfx" IsSelected="True" />
                            <ComboBoxItem Content="u8g2 drawXBM (LSB-first, bit-reversed)" Tag="U8g2DrawXBM" />
                            <ComboBoxItem Content="Raw Binary / Bit Grid" Tag="RawBinary" />
                            <ComboBoxItem Content="LiquidCrystal 1602 Custom Char (5×8)" Tag="LiquidCrystalChar" />
                            <ComboBoxItem Content="2D Pixel Array / Matrix (1 byte/px)" Tag="Indexed2D" />
                        </ComboBox>
                    </Grid>

                    <!-- Detection Status Card -->
                    <Border x:Name="BorderStatusCard"
                            Grid.Row="4"
                            Background="{DynamicResource Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Brush.Border.Base}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtStatusIcon"
                                       Grid.Column="0"
                                       Text="ℹ"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtStats"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="Paste code above to begin." />
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Width="90" Height="30"
                                Style="{StaticResource ModernButtonStyle}"
                                Margin="0,0,8,0"
                                Click="Cancel_Click" />
                        <Button x:Name="BtnImport"
                                Content="Import"
                                Width="120" Height="30"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="Import_Click"
                                IsDefault="True"
                                IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <!-- RIGHT COLUMN: HARDWARE PREVIEW & INSPECTOR -->
                <Border Grid.Column="1"
                        Background="{DynamicResource Brush.Surface.Panel}"
                        BorderBrush="{DynamicResource Brush.Border.Base}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Preview Header & Dimension badge -->
                            <RowDefinition Height="*" />    <!-- Screen Bezel & Canvas Image -->
                            <RowDefinition Height="Auto" /> <!-- Palette Switcher -->
                            <RowDefinition Height="Auto" /> <!-- Toggles (Grid & Invert) -->
                        </Grid.RowDefinitions>

                        <!-- Preview Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="PREVIEW"
                                       Style="{StaticResource HeaderStyle}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Background="{DynamicResource Brush.Surface.Base}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2">
                                <TextBlock x:Name="TxtPreviewDimBadge"
                                           Text="0 × 0 px"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Muted}" />
                            </Border>
                        </Grid>

                        <!-- Simulated OLED/LCD Bezel -->
                        <Border Grid.Row="1"
                                Background="#0A0D12"
                                BorderBrush="{DynamicResource Brush.Border.Base}"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Padding="8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Grid>
                                <!-- Placeholder when empty -->
                                <TextBlock x:Name="TxtNoPreview"
                                           Text="No Preview"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           Opacity="0.4"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                <!-- Live Bitmap Image -->
                                <Image x:Name="ImgPreview"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />

                                <!-- Frame Navigation Toolbar (Visible when multi-frame animation) -->
                                <Border x:Name="BorderFrameNav"
                                        VerticalAlignment="Bottom"
                                        Background="#D80A0D12"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                        BorderThickness="0,1,0,0"
                                        CornerRadius="0,0,4,4"
                                        Margin="-8,-8,-8,-8"
                                        Padding="6,4"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnPrevFrame"
                                                Grid.Column="0"
                                                ToolTip="Previous frame"
                                                Width="26" Height="24" MinHeight="0"
                                                Padding="0"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="BtnPrevFrame_Click">
                                            <Path Data="M 7,3 L 3,7.5 L 7,12"
                                                  Stroke="{DynamicResource Brush.Text.Primary}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="10" Height="10"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Button>

                                        <TextBlock x:Name="TxtFrameNavIndicator"
                                                   Grid.Column="1"
                                                   Text="Frame 1 of 1"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                        <Button x:Name="BtnNextFrame"
                                                Grid.Column="2"
                                                ToolTip="Next frame"
                                                Width="26" Height="24" MinHeight="0"
                                                Padding="0"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Margin="0,0,4,0"
                                                Click="BtnNextFrame_Click">
                                            <Path Data="M 3,3 L 7,7.5 L 3,12"
                                                  Stroke="{DynamicResource Brush.Text.Primary}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="10" Height="10"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Button>

                                        <Button x:Name="BtnPlayAnimation"
                                                Grid.Column="3"
                                                ToolTip="Play / Pause animation preview"
                                                Width="26" Height="24" MinHeight="0"
                                                Padding="0"
                                                Style="{StaticResource ModernButtonStyle}"
                                                Click="BtnPlayAnimation_Click">
                                            <Path x:Name="IconPlayPause"
                                                  Data="M 4,3 L 13,8.5 L 4,14 Z"
                                                  Fill="{DynamicResource Brush.Text.Primary}"
                                                  Width="10" Height="10"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Palette Selector -->
                        <StackPanel Grid.Row="2" Margin="0,10,0,10">
                            <TextBlock Text="COLOR SIMULATION"
                                       Style="{StaticResource HeaderStyle}"
                                       FontSize="10"
                                       Margin="0,0,0,6" />
                            <UniformGrid Columns="2" Rows="2">
                                <Button x:Name="BtnPalWhite"
                                        Content="OLED White"
                                        ToolTip="White monochrome OLED"
                                        Height="26" MinHeight="0" Padding="0" FontSize="10.5"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="Palette_Click" Tag="WhiteOled"
                                        Margin="0,0,3,3" />
                                <Button x:Name="BtnPalAmber"
                                        Content="Amber Glow"
                                        ToolTip="Amber glow / Flipper zero"
                                        Height="26" MinHeight="0" Padding="0" FontSize="10.5"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="Palette_Click" Tag="AmberGlow"
                                        Margin="3,0,0,3" />
                                <Button x:Name="BtnPalGreen"
                                        Content="Matrix Green"
                                        ToolTip="Matrix LCD green"
                                        Height="26" MinHeight="0" Padding="0" FontSize="10.5"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="Palette_Click" Tag="MatrixGreen"
                                        Margin="0,3,3,0" />
                                <Button x:Name="BtnPalCyan"
                                        Content="Cyan Blue"
                                        ToolTip="Cyan blue OLED"
                                        Height="26" MinHeight="0" Padding="0" FontSize="10.5"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Click="Palette_Click" Tag="CyanBlue"
                                        Margin="3,3,0,0" />
                            </UniformGrid>
                        </StackPanel>

                        <!-- Toggles: Show Grid & Invert Pixels -->
                        <StackPanel Grid.Row="3">
                            <CheckBox x:Name="ChkPixelGrid"
                                      Content="Pixel Grid Overlay"
                                      Foreground="{DynamicResource Brush.Text.Primary}"
                                      FontSize="11"
                                      IsChecked="True"
                                      Margin="0,0,0,6"
                                      Checked="ChkDisplayOption_Changed"
                                      Unchecked="ChkDisplayOption_Changed" />

                            <CheckBox x:Name="ChkInvert"
                                      Content="Invert Pixels (Bit Polarity)"
                                      Foreground="{DynamicResource Brush.Text.Primary}"
                                      FontSize="11"
                                      Checked="ChkDisplayOption_Changed"
                                      Unchecked="ChkDisplayOption_Changed" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
