<Window x:Class="Hexprite.Views.HardwarePreviewWiringDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        xmlns:vm="clr-namespace:Hexprite.ViewModels"
        Title="Configure Hardware Preview Wiring &amp; Pins"
        Width="860" Height="620"
        MinHeight="500" MinWidth="740"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        core:WindowChromeHelper.ForceRoundedCorners="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="🔌 " FontSize="12"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="12" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionMaximize_Click" ToolTip="Maximize / Restore" Width="44" Height="34"
                                Style="{StaticResource CaptionButtonStyle}">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Click="CaptionClose_Click" ToolTip="Close" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content: 2 Columns -->
            <Grid Grid.Row="1" Margin="16,12,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Settings -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Panel}"
                        BorderBrush="{DynamicResource Brush.Border.Separator}"
                        BorderThickness="1" CornerRadius="6" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Firmware Notice Banner -->
                            <Border Background="#152196F3" BorderBrush="#302196F3" BorderThickness="1" CornerRadius="5" Padding="8,7" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="💡 Microcontroller Firmware" FontWeight="SemiBold" FontSize="10" Foreground="#64B5F6" Margin="0,0,0,3"/>
                                    <TextBlock Text="Pins and baud rate are compiled into the Arduino sketch. Saving updates the sketch in AppData. You must upload the sketch via Arduino IDE for physical board changes to take effect."
                                               TextWrapping="Wrap" FontSize="9.5" Foreground="{DynamicResource Brush.Text.Muted}" LineHeight="13"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="BOARD &amp; INTERFACE" Style="{StaticResource HeaderStyle}" FontSize="11" Margin="0,0,0,10"/>

                            <!-- Target Board -->
                            <TextBlock Text="Target Board Preset" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding BoardPresets}"
                                      SelectedItem="{Binding SelectedBoardPreset, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}" Height="28" Margin="0,0,0,10"/>

                            <!-- Display Model -->
                            <TextBlock Text="Display Controller &amp; Size" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding DisplayModels}"
                                      SelectedItem="{Binding SelectedDisplayModel, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}" Height="28" Margin="0,0,0,10"/>

                            <!-- Serial Baud Rate -->
                            <TextBlock Text="Serial Baud Rate" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableBaudRates}"
                                          SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}"
                                          Style="{StaticResource ModernComboBoxStyle}" Height="28"/>
                                <Button Grid.Column="1" Content="⚡"
                                        Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                                        ToolTip="Auto-detect board baud rate by probing standard speeds"
                                        Command="{Binding AutoDetectBaudRateCommand}"
                                        Style="{StaticResource ModernButtonStyle}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Interface Type (Segmented Chip Selector) -->
                            <TextBlock Text="Interface" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource Brush.Surface.Base}"
                                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                                    BorderThickness="1" CornerRadius="5" Padding="2" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Content="I2C (2-Wire)"
                                                 IsChecked="{Binding IsI2c, Mode=OneWay}" GroupName="InterfaceType"
                                                 Style="{StaticResource ChipButtonStyle}" Margin="0"
                                                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                 Padding="0,5" FontSize="11"
                                                 Checked="I2cRadio_Checked"/>
                                    <RadioButton Grid.Column="1" Content="SPI (4-Wire)"
                                                 IsChecked="{Binding IsSpi, Mode=OneWay}" GroupName="InterfaceType"
                                                 Style="{StaticResource ChipButtonStyle}" Margin="2,0,0,0"
                                                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                 Padding="0,5" FontSize="11"
                                                 Checked="SpiRadio_Checked"/>
                                </Grid>
                            </Border>

                            <Separator Background="{DynamicResource Brush.Border.Separator}" Margin="0,2,0,12"/>

                            <!-- I2C Options -->
                            <StackPanel Visibility="{Binding IsI2c, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="I2C PIN CONFIGURATION" Style="{StaticResource HeaderStyle}" FontSize="10" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SDA Pin" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding SdaPin, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBoxStyle}" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SCL Pin" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding SclPin, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBoxStyle}" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="I2C Address" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding I2cAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBoxStyle}" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox IsChecked="{Binding UseSoftwareI2c, Mode=TwoWay}"
                                          Content="Use Software I2C (any digital pins on AVR)"
                                          FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}"
                                          Margin="0,0,0,6"/>
                            </StackPanel>

                            <!-- SPI Options -->
                            <StackPanel Visibility="{Binding IsSpi, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="SPI PIN CONFIGURATION" Style="{StaticResource HeaderStyle}" FontSize="10" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CS Pin" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding CsPin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DC Pin" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding DcPin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="RST Pin" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding RstPin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SCK / D0 (Clock)" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding ClkPin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="MOSI / D1 (Data)" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding MosiPin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Validation Warning / Error / Canvas Warning -->
                            <Border Background="#25FF5722" BorderBrush="#FF5722" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,0"
                                    Visibility="{Binding HasCanvasBufferWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding CanvasBufferWarning}" TextWrapping="Wrap" FontSize="10.5" Foreground="#FFAB91"/>
                            </Border>

                            <Border Background="#25FF9800" BorderBrush="#FF9800" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,0"
                                    Visibility="{Binding HasValidationWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ValidationWarning}" TextWrapping="Wrap" FontSize="10.5" Foreground="#FFCC80"/>
                            </Border>

                            <Border Background="#25F44336" BorderBrush="#F44336" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,0"
                                    Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ValidationError}" TextWrapping="Wrap" FontSize="10.5" Foreground="#EF9A9A"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right Column: Tabbed Wiring Guide & Code Preview -->
                <TabControl Grid.Column="2" Background="{DynamicResource Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Brush.Border.Separator}"
                            BorderThickness="1">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" Padding="10,6" Margin="0,0,2,0" Background="Transparent" CornerRadius="4,4,0,0">
                                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                              ContentSource="Header" Margin="8,2"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab 1: Wiring Guide -->
                    <TabItem Header="🔌 Wiring Guide">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Wire up your display to the microcontroller as shown below:"
                                       FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,10"/>

                            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Base}" CornerRadius="6"
                                    BorderBrush="{DynamicResource Brush.Border.Separator}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Table Header -->
                                    <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border.Separator}" BorderThickness="0,0,0,1"
                                            Background="{DynamicResource Brush.Surface.Panel}" Padding="10,6" CornerRadius="5,5,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="DISPLAY PIN" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBlock Grid.Column="2" Text="BOARD PIN" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBlock Grid.Column="3" Text="FUNCTION / PURPOSE" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Table Rows -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6">
                                        <ItemsControl ItemsSource="{Binding WireMappings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Brush.Border.Separator}" BorderThickness="0,0,0,1" Padding="4,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"
                                                                         Stroke="#60FFFFFF" StrokeThickness="1">
                                                                    <Ellipse.Fill>
                                                                        <SolidColorBrush Color="{Binding WireColor}"/>
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                                <TextBlock Text="{Binding DisplayPin}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="➜" Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="2" Background="#18FFFFFF" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding BoardPin}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Accent.Primary}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="2" Text="💡 Tip: Make sure GND is shared between the board and display, and VCC is matched (3.3V or 5V)."
                                       FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,8,0,0"/>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Arduino Sketch -->
                    <TabItem Header="📄 Arduino Sketch (.ino)">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Standalone companion sketch configured with your pins:"
                                               FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBlock Text="Upload directly via Arduino IDE to preview without any extra project code."
                                               FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Separator}"
                                            BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="C++ / INO" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    </Border>
                                    <Button Content="🚀 Open in Arduino IDE" Command="{Binding OpenInArduinoIdeCommand}"
                                            Style="{StaticResource ModernButtonStyle}" Padding="10,4" FontSize="10.5" Margin="0,0,6,0"
                                            ToolTip="Directly open the sketch in your default Arduino IDE or editor"/>
                                    <Button Content="📋 Copy" Command="{Binding CopySketchCommand}"
                                            Style="{StaticResource ModernButtonStyle}" Padding="10,4" FontSize="10.5" Margin="0,0,6,0"/>
                                    <Button Content="💾 Export..." Command="{Binding ExportSketchCommand}"
                                            Style="{StaticResource ModernButtonStyle}" Padding="10,4" FontSize="10.5"/>
                                </StackPanel>
                            </Grid>

                            <TextBox Grid.Row="1" Text="{Binding GeneratedSketch, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas, Courier New, monospace" FontSize="10.5"
                                     Background="{DynamicResource Brush.Surface.Base}"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     BorderBrush="{DynamicResource Brush.Border.Separator}"
                                     BorderThickness="1"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     Padding="8"/>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: PlatformIO Project -->
                    <TabItem Header="⚡ PlatformIO">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="PlatformIO standalone companion project (VS Code / CLI):"
                                               FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBlock Text="Auto-configured with your board preset environment and display pin definitions."
                                               FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Separator}"
                                            BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="CONFIG.H / INI" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    </Border>
                                    <Button Content="🚀 Open Project Folder" Command="{Binding OpenPlatformIOFolderCommand}"
                                            Style="{StaticResource ModernButtonStyle}" Padding="10,4" FontSize="10.5" Margin="0,0,6,0"
                                            ToolTip="Open the PlatformIO project folder in Explorer / VS Code"/>
                                    <Button Content="📋 Copy config.h" Command="{Binding CopyPlatformIOConfigCommand}"
                                            Style="{StaticResource ModernButtonStyle}" Padding="10,4" FontSize="10.5" Margin="0,0,6,0"/>
                                    <Button Content="📋 Copy platformio.ini" Command="{Binding CopyPlatformIOIniCommand}"
                                            Style="{StaticResource ModernButtonStyle}" Padding="10,4" FontSize="10.5"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- config.h Column -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="src/config.h (Display &amp; Pins)" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1" Text="{Binding GeneratedPlatformIOConfig, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas, Courier New, monospace" FontSize="10"
                                             Background="{DynamicResource Brush.Surface.Base}"
                                             Foreground="{DynamicResource Brush.Text.Primary}"
                                             BorderBrush="{DynamicResource Brush.Border.Separator}"
                                             BorderThickness="1"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" AcceptsTab="True"
                                             Padding="8"/>
                                </Grid>

                                <!-- platformio.ini Column -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="platformio.ini (Board Environments)" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1" Text="{Binding GeneratedPlatformIOIni, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas, Courier New, monospace" FontSize="10"
                                             Background="{DynamicResource Brush.Surface.Base}"
                                             Foreground="{DynamicResource Brush.Text.Primary}"
                                             BorderBrush="{DynamicResource Brush.Border.Separator}"
                                             BorderThickness="1"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" AcceptsTab="True"
                                             Padding="8"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Tab 4: Library Snippet -->
                    <TabItem Header="📦 Library Snippet">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Add to your existing sketch to enable live preview without losing your code:"
                                               FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBlock Text="Place includes at top, constructor in global scope, and update() in loop()."
                                               FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Separator}"
                                            BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="C++ / HEADER" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    </Border>
                                    <Button Content="📋 Copy Snippet" Command="{Binding CopySnippetCommand}"
                                            Style="{StaticResource ModernButtonStyle}" Padding="10,4" FontSize="10.5"/>
                                </StackPanel>
                            </Grid>

                            <TextBox Grid.Row="1" Text="{Binding GeneratedSnippet, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas, Courier New, monospace" FontSize="10.5"
                                     Background="{DynamicResource Brush.Surface.Base}"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     BorderBrush="{DynamicResource Brush.Border.Separator}"
                                     BorderThickness="1"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     Padding="8"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Bottom Actions Bar -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                               Foreground="#81C784" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="📁 Open Sketch Folder" Click="OpenSketchFolder_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="12,6" FontSize="11" Margin="0,0,8,0"
                                ToolTip="Open the AppData folder containing the generated Arduino sketch"/>
                        <Button Content="Cancel" Click="Cancel_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="14,6" FontSize="11" Margin="0,0,8,0" IsCancel="True"/>
                        <Button Content="Save &amp; Update Sketch" Click="Done_Click"
                                Style="{StaticResource AccentButtonStyle}" Padding="16,6" FontSize="11" FontWeight="SemiBold" IsDefault="True"
                                ToolTip="Saves preferences, updates standalone sketch in AppData, and updates preview settings"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
