<UserControl x:Class="Hexprite.Views.AssetPackEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Hexprite.ViewModels"
             xmlns:flipper="clr-namespace:Hexprite.ViewModels.Flipper"
             xmlns:views="clr-namespace:Hexprite.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=flipper:FlipperScheduleMatrixViewModel}"
             Background="{DynamicResource Brush.Surface.Base}"
             FontFamily="{DynamicResource Font.Primary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hexprite;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Segmented Radio Button Style for View Mode Switcher -->
            <Style x:Key="SegmentedRadioButtonStyle" TargetType="{x:Type RadioButton}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource ModernFocusVisual}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Base}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom GridSplitter Style with Center Grip Indicator -->
            <Style x:Key="ModernGridSplitterStyle" TargetType="{x:Type GridSplitter}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ShowsPreview" Value="False"/>
                <Setter Property="Cursor" Value="SizeWE"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Border x:Name="GripBar" Width="2" Height="36" Background="{DynamicResource Brush.Border.Base}" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GripBar" Property="Background" Value="{DynamicResource Brush.Accent.Base}"/>
                                    <Setter TargetName="GripBar" Property="Width" Value="3"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="GripBar" Property="Background" Value="{DynamicResource Brush.Accent.Base}"/>
                                    <Setter TargetName="GripBar" Property="Width" Value="4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom ListBoxItem Style for Scheduled Animation Entries -->
            <Style x:Key="ScheduleEntryListItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="ItemBorder"
                                    Background="{DynamicResource Brush.Surface.Panel}"
                                    BorderBrush="{DynamicResource Brush.Border.Base}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Surface.Active}"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Themed High-Visibility ProgressBar Style -->
            <Style x:Key="HighVisibilityProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Base}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    ClipToBounds="True">
                                <Grid x:Name="PART_Track">
                                    <Border x:Name="PART_Indicator"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}"
                                            CornerRadius="2"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER & TOOLBAR -->
        <Grid Grid.Row="0" Margin="14,10,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Title, Badges, and Primary Launchers -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="📊 Dolphin Schedule Matrix" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCoverageBadge" Text="{Binding CoverageBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Success}"/>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EntryCountBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModeBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding ValidationStatusText}">
                        <TextBlock Text="{Binding ValidationStatusText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                    </Border>

                    <!-- View Switcher Segmented Control -->
                    <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="📊 Matrix Studio" IsChecked="{Binding IsMatrixStudioView, Mode=OneWay}" Command="{Binding SetViewModeCommand}" CommandParameter="MatrixStudio" Style="{StaticResource SegmentedRadioButtonStyle}" Height="26" Padding="10,0" FontSize="11" FontWeight="SemiBold" ToolTip="Interactive heatmap canvas &amp; bounds editor"/>
                            <RadioButton Content="📋 Data Table" IsChecked="{Binding IsDataGridRosterView, Mode=OneWay}" Command="{Binding SetViewModeCommand}" CommandParameter="DataGridRoster" Style="{StaticResource SegmentedRadioButtonStyle}" Height="26" Padding="10,0" FontSize="11" FontWeight="SemiBold" ToolTip="Dense spreadsheet roster for managing 40+ animations"/>
                            <RadioButton Content="🖼️ Sprite Gallery" IsChecked="{Binding IsSpriteGalleryView, Mode=OneWay}" Command="{Binding SetViewModeCommand}" CommandParameter="SpriteGallery" Style="{StaticResource SegmentedRadioButtonStyle}" Height="26" Padding="10,0" FontSize="11" FontWeight="SemiBold" ToolTip="Visual gallery card grid of all animation sprites"/>
                            <RadioButton Content="🎮 Simulator" IsChecked="{Binding IsDeviceSimulatorView, Mode=OneWay}" Command="{Binding SetViewModeCommand}" CommandParameter="DeviceSimulator" Style="{StaticResource SegmentedRadioButtonStyle}" Height="26" Padding="10,0" FontSize="11" FontWeight="SemiBold" ToolTip="Embedded virtual Flipper Zero device simulator &amp; RNG state tester"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Primary Launchers (Right) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Mode Toggle Button -->
                    <Button Content="{Binding ModeBadgeText}" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="12,0" Margin="0,0,6,0" FontSize="11" ToolTip="Toggle between Stock (L1-3) and Extended (L1-30) firmware modes" Command="{Binding ToggleModeCommand}"/>

                    <!-- Auto Balance Dropdown Menu -->
                    <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Menu Background="Transparent">
                            <MenuItem Header="⚡ Auto-Balance ▾" Height="26" Padding="10,0" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="11">
                                <MenuItem Header="Linear Level Progression" Command="{Binding AutoBalanceStrategyCommand}" CommandParameter="LinearLevels" ToolTip="Evenly distribute animations across all levels"/>
                                <MenuItem Header="Mood Tiers (Happy / Neutral / Angry)" Command="{Binding AutoBalanceStrategyCommand}" CommandParameter="MoodTiers" ToolTip="Partition animations across emotional mood ranges"/>
                                <MenuItem Header="Stage Evolution (Baby / Teen / Adult)" Command="{Binding AutoBalanceStrategyCommand}" CommandParameter="StageEvolution" ToolTip="Group animations into Baby, Teen, and Adult life stages"/>
                                <MenuItem Header="Fill Gaps Only" Command="{Binding AutoBalanceStrategyCommand}" CommandParameter="FillGapsOnly" ToolTip="Expand entries to cover 0% deadzones without changing overall layout"/>
                            </MenuItem>
                        </Menu>
                    </Border>

                    <Button x:Name="BtnOpenSim" Content="🐬 Open Simulator" Style="{StaticResource AccentButtonStyle}" Height="28" Padding="14,0" FontWeight="Bold" FontSize="11" Command="{Binding OpenSimulatorCommand}" ToolTip="Switch to the embedded virtual device simulator tab"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Subtitle description (Left) & Secondary Action Toolbar (Right) -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="2D Level vs Mood probability visualizer &amp; manifest.txt generator for Flipper Zero."
                           FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↩️" Style="{StaticResource ModernButtonStyle}" Width="28" Height="26" Padding="0" Margin="0,0,3,0" ToolTip="Undo (Ctrl+Z)" Command="{Binding UndoCommand}"/>
                    <Button Content="↪️" Style="{StaticResource ModernButtonStyle}" Width="28" Height="26" Padding="0" Margin="0,0,6,0" ToolTip="Redo (Ctrl+Y)" Command="{Binding RedoCommand}"/>
                    <Button Content="➕ Add Active Tab" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11" ToolTip="Add currently active canvas document to schedule matrix" Command="{Binding AddActiveCanvasTabCommand}"/>
                    <Button Content="🔄 Sync Tabs" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11" ToolTip="Sync animations from currently open Hexprite workspace tabs" Command="{Binding SyncFromWorkspaceCommand}"/>
                    <Button Content="📥 Import .hexp" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11" ToolTip="Import one or more .hexp animation files into this pack" Command="{Binding ImportHexpCommand}"/>
                    <Button Content="📁 Import Folder" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11" ToolTip="Import animations from a Flipper directory tree or folder of images" Command="{Binding ImportFolderCommand}"/>
                    <Button Content="🗜️ Import Zip" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11" ToolTip="Import animations from a Flipper asset pack .zip archive" Command="{Binding ImportZipCommand}"/>
                    <Button Content="📤 Export .hexp" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11" ToolTip="Export all pack animations to standalone .hexp files" Command="{Binding ExportAllHexpCommand}"/>
                    <Button Content="📂 Import Manifest" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11" ToolTip="Import existing manifest.txt into this pack" Command="{Binding ImportManifestCommand}"/>
                    <Button Content="💾 Export Manifest" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11" ToolTip="Export manifest.txt for Flipper hardware" Command="{Binding ExportManifestCommand}"/>
                    <Button Content="📦 Export Pack Folder" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11" ToolTip="Export full Flipper Zero asset pack directory tree" Command="{Binding ExportAssetPackDirectoryCommand}"/>
                    <Button Content="🗜️ Export Pack (.zip)" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11" ToolTip="Export full Flipper Zero asset pack as .zip archive" Command="{Binding ExportAssetPackZipCommand}"/>
                    <Button Content="📋 Copy Manifest" Style="{StaticResource ModernButtonStyle}" Height="26" Padding="8,0" FontSize="11" ToolTip="Copy raw manifest.txt to clipboard" Command="{Binding CopyManifestCommand}"/>
                </WrapPanel>
            </Grid>
        </Grid>

        <!-- 2. MAIN BODY: Multi-View Dynamic Host -->
        <Grid Grid.Row="1" Margin="14,0,14,8">

            <!-- ═══════════════════════════════════════════════════════════════
                 VIEW 1: MATRIX STUDIO (Heatmap Canvas + Splitter + Inspector)
                 ═══════════════════════════════════════════════════════════════ -->
            <Grid Visibility="{Binding IsMatrixStudioView, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" MinWidth="400"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="9*" MinWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Interactive Heatmap Matrix Grid -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Active Target Animation / Region Selection HUD Banner -->
                        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Target Animation or Region Mode Status -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Mode 1: Animation Target Active -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding SelectedEntry.EntryColorHex}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="🎯 Target:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedEntry.Name}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                        <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedEntry.BoundsText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        </Border>
                                        <TextBlock Text="• Drag grid to reassign range" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Mode 2: Region Selection / Inspection Active (No animation selected) -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasNoSelectedEntry, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                        <TextBlock Text="🔍 Region Mode" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                                        <TextBlock Text="• Drag on grid to select region for inspection, or click an animation to edit" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: Action Buttons (Drag Mode Toggle, Deselect) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Drag Mode Toggle Button -->
                                    <Button Content="{Binding DragModeBadgeText}" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="8,0" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold" ToolTip="{Binding DragModeTooltip}" Command="{Binding ToggleDragModeCommand}"/>

                                    <!-- Deselect Button (Visible when SelectedEntry != null) -->
                                    <Button Content="✕ Deselect" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="8,0" FontSize="10" ToolTip="Clear target animation (Esc)" Command="{Binding DeselectEntryCommand}" Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Top Stage Evolution Bands (Baby / Teen / Adult) -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="1" Margin="1,0,1,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColStageBaby" Width="9*"/>
                                    <ColumnDefinition x:Name="ColStageTeen" Width="10*"/>
                                    <ColumnDefinition x:Name="ColStageAdult" Width="11*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BorderStageBaby" Grid.Column="0"
                                        Background="{DynamicResource Brush.Stage.Baby.Bg}"
                                        BorderBrush="{DynamicResource Brush.Stage.Baby}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="1,0"
                                        ToolTip="Baby Stage: Levels 1–9">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Brush.Stage.Baby}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtStageBaby" Text="👶 Baby" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Stage.Baby}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="BorderStageTeen" Grid.Column="1"
                                        Background="{DynamicResource Brush.Stage.Teen.Bg}"
                                        BorderBrush="{DynamicResource Brush.Stage.Teen}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="1,0"
                                        ToolTip="Teen Stage: Levels 10–19">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Brush.Stage.Teen}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtStageTeen" Text="👦 Teen" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Stage.Teen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="BorderStageAdult" Grid.Column="2"
                                        Background="{DynamicResource Brush.Stage.Adult.Bg}"
                                        BorderBrush="{DynamicResource Brush.Stage.Adult}"
                                        BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="1,0"
                                        ToolTip="Adult Stage: Levels 20–30">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Brush.Stage.Adult}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtStageAdult" Text="🐬 Adult" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Stage.Adult}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Horizontal Level Axis Ticks (1 .. MaxLevel) -->
                        <Grid Grid.Row="2" Height="16" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Canvas x:Name="LevelAxisCanvas" Grid.Column="1" Margin="1,0,1,0"
                                    ClipToBounds="True" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                        </Grid>

                        <!-- Matrix Canvas with Vertical Mood Axis (0 .. 14) -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,1,4,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="18"/>
                                </Grid.ColumnDefinitions>

                                <!-- 3 Tier Emoji Cards -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="5*"/>
                                        <RowDefinition Height="5*"/>
                                        <RowDefinition Height="5*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Mood.Happy}" BorderThickness="1" CornerRadius="4" Margin="0,1" VerticalAlignment="Stretch" ToolTip="Happy (Mood 0-4)">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="😊" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="0-4" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Mood.Happy}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Mood.Neutral}" BorderThickness="1" CornerRadius="4" Margin="0,1" VerticalAlignment="Stretch" ToolTip="Neutral / OK (Mood 5-9)">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="😐" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="5-9" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Mood.Neutral}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Mood.Angry}" BorderThickness="1" CornerRadius="4" Margin="0,1" VerticalAlignment="Stretch" ToolTip="Angry / Butthurt (Mood 10-14)">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="😡" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock Text="10-14" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Mood.Angry}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Discrete 0-14 Row Indicators Canvas -->
                                <Canvas x:Name="MoodAxisCanvas" Grid.Column="1" Margin="1,0,0,0"
                                        ClipToBounds="True" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                            </Grid>

                            <!-- Interactive 2D Matrix Canvas -->
                            <Border Grid.Column="1" Background="{DynamicResource Brush.Canvas.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <Canvas x:Name="MatrixCanvas" ClipToBounds="True"
                                        Focusable="True"
                                        FocusVisualStyle="{StaticResource ModernFocusVisual}"
                                        UseLayoutRounding="True"
                                        SnapsToDevicePixels="True"
                                        ToolTip="Click to inspect, drag a box on the grid to set range, right-click for options"
                                        MouseMove="MatrixCanvas_MouseMove"
                                        MouseLeave="MatrixCanvas_MouseLeave"
                                        MouseLeftButtonDown="MatrixCanvas_MouseLeftButtonDown"
                                        MouseLeftButtonUp="MatrixCanvas_MouseLeftButtonUp"
                                        MouseRightButtonDown="MatrixCanvas_MouseRightButtonDown"
                                        LostMouseCapture="MatrixCanvas_LostMouseCapture"
                                        KeyDown="MatrixCanvas_KeyDown">
                                    <Canvas.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="🎮 Test in Simulator"
                                                      Command="{Binding TestCellInSimulatorCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="🎨 Open Animation in Canvas"
                                                      Command="{Binding OpenCellAnimationCommand}"
                                                      Visibility="{Binding HasSelectedCellCoverage, Converter={StaticResource BoolToVis}}"/>
                                            <MenuItem Header="✨ Create Animation for This Gap"
                                                      Command="{Binding CreateTabForGapCommand}"
                                                      Visibility="{Binding HasSelectedCellGap, Converter={StaticResource BoolToVis}}"/>
                                            <MenuItem Header="➕ Add New Animation for This State"
                                                      Command="{Binding CreateTabForGapCommand}"
                                                      Visibility="{Binding HasSelectedCellCoverage, Converter={StaticResource BoolToVis}}"/>
                                            <Separator/>
                                            <MenuItem Header="🎯 Set Selected Animation to This Cell"
                                                      Command="{Binding SetBoundsToClickedCellCommand}"
                                                      IsEnabled="{Binding HasSelectedEntry}"/>
                                            <Separator/>
                                            <MenuItem Header="⚡ Auto-Balance Matrix"
                                                      Command="{Binding AutoBalanceCommand}"/>
                                        </ContextMenu>
                                    </Canvas.ContextMenu>
                                </Canvas>
                            </Border>
                        </Grid>

                        <!-- Color Legend Bar & Solo Mode Toggle -->
                        <Border Grid.Row="4" Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,8,2" ToolTip="0% coverage - Flipper has no animation for this state">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Brush.Matrix.GapFill}" BorderBrush="{DynamicResource Brush.Matrix.GapStroke}" BorderThickness="1" Margin="0,0,4,0"/>
                                        <TextBlock Text="Gap (0%)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,8,2" ToolTip="1 animation - 100% dedicated playback">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#00E5FF" Margin="0,0,4,0"/>
                                        <TextBlock Text="1x Solo" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,8,2" ToolTip="2 animations - Balanced 2-way rotation">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#39FF14" Margin="0,0,4,0"/>
                                        <TextBlock Text="2x Shared" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,8,2" ToolTip="3 animations - 3-way rotation">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#FFB300" Margin="0,0,4,0"/>
                                        <TextBlock Text="3x Multi" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,8,2" ToolTip="4 or more animations competing for this state">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="#FF3366" Margin="0,0,4,0"/>
                                        <TextBlock Text="4x+ Heavy" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,8,2" ToolTip="Active selected animation bounds">
                                        <Border Width="10" Height="10" CornerRadius="2" BorderBrush="#FF8200" BorderThickness="1.5" Background="#14FF8200" Margin="0,0,4,0"/>
                                        <TextBlock Text="Bounds" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,8,2" ToolTip="Cells associated with the active selected animation (highlighted with orange accent border and ★)">
                                        <Border Width="11" Height="11" CornerRadius="2" BorderBrush="#FFA000" BorderThickness="1.5" Background="#33FFA000" Margin="0,0,4,0">
                                            <TextBlock Text="★" FontSize="7" FontWeight="Bold" Foreground="#FFA000" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                        <TextBlock Text="★ Selected Animation" FontSize="10" FontWeight="SemiBold" Foreground="#FFA000" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Solo Mode Toggle -->
                                <ToggleButton Grid.Column="1" Content="👁️ Solo Selected" IsChecked="{Binding IsSoloModeActive, Mode=TwoWay}"
                                              Style="{StaticResource ModernToggleButtonStyle}" Height="24" Padding="10,0" FontSize="10" FontWeight="SemiBold"
                                              ToolTip="Dim all other animations and isolate the active animation's boundary footprint"/>
                            </Grid>
                        </Border>

                        <!-- Hover / Click Status Pill -->
                        <Border Grid.Row="5" Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ℹ️ " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCellHoverInfo" Text="{Binding CellHoverInfoText}" ToolTip="{Binding CellHoverInfoText}" FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="{DynamicResource Font.Code}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- GridSplitter between Matrix and Inspector -->
                <GridSplitter Grid.Column="1" Width="6" Style="{StaticResource ModernGridSplitterStyle}"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                <!-- Right Inspector: Animation Entries Editor & State Breakdown -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,2,0">
                    <StackPanel>
                        <!-- Top: Scheduled Animations List with High-Density Sorting & Filtering -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Title Row & Controls -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="SCHEDULED ANIMATIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FilterCountText, StringFormat=' ({0})'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="▲" Style="{StaticResource ModernButtonStyle}" Height="24" Width="24" Padding="0" Margin="0,0,2,0" FontSize="10" ToolTip="Previous Animation (Ctrl+Up)" Command="{Binding SelectPreviousEntryCommand}"/>
                                        <Button Content="▼" Style="{StaticResource ModernButtonStyle}" Height="24" Width="24" Padding="0" Margin="0,0,6,0" FontSize="10" ToolTip="Next Animation (Ctrl+Down)" Command="{Binding SelectNextEntryCommand}"/>
                                        <Button Content="➕ Add" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="8,0" Margin="0,0,4,0" FontSize="10" Command="{Binding AddEntryCommand}"/>
                                        <Button Content="📋 Clone" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="8,0" Margin="0,0,4,0" FontSize="10" Command="{Binding DuplicateEntryCommand}"/>
                                        <Button Content="🗑️ Delete" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="8,0" FontSize="10" Command="{Binding DeleteEntryCommand}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Search & Quick Filters -->
                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11"
                                             Text="{Binding SearchFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search animations by name or details"/>
                                    <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" Height="26" MinWidth="85" Margin="4,0,0,0" Padding="8,2,24,2" FontSize="11"
                                              ItemsSource="{Binding StageFilters}"
                                              SelectedItem="{Binding SelectedStageFilter, Mode=TwoWay}"
                                              ToolTip="Filter by Stage"/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource ModernComboBoxStyle}" Height="26" MinWidth="85" Margin="4,0,0,0" Padding="8,2,24,2" FontSize="11"
                                              ItemsSource="{Binding MoodFilters}"
                                              SelectedItem="{Binding SelectedMoodFilter, Mode=TwoWay}"
                                              ToolTip="Filter by Mood"/>
                                    <Button Grid.Column="3" Content="✕" Style="{StaticResource ModernButtonStyle}"
                                            Height="26" Width="26" Margin="4,0,0,0" Padding="0" FontSize="10"
                                            Command="{Binding ResetFiltersCommand}"
                                            ToolTip="Clear search and reset filters"
                                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                                </Grid>

                                <!-- Sort and Group Dropdowns Row -->
                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,0">
                                        <TextBlock Text="Sort:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" Height="24" FontSize="10" MinWidth="110" Padding="8,2,24,2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" HorizontalAlignment="Stretch" Width="120"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Group:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" Height="24" FontSize="10" MinWidth="120" Padding="8,2,24,2" ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedGroupOption, Mode=TwoWay}" HorizontalAlignment="Stretch" Width="130"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Virtualized Scrollable Animation List -->
                                <ListBox x:Name="ListEntries" Grid.Row="3"
                                         MinHeight="120" MaxHeight="220"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.CanContentScroll="True"
                                         Style="{StaticResource ModernListBoxStyle}"
                                         ItemContainerStyle="{StaticResource ScheduleEntryListItemStyle}"
                                         ItemsSource="{Binding FilteredEntries}"
                                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                         MouseDoubleClick="ListEntries_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="📍 Focus in Workspace Tab"
                                                                  Command="{Binding PlacementTarget.Tag.NavigateToEntryTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="📋 Clone Animation"
                                                                  Command="{Binding PlacementTarget.Tag.DuplicateEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="🗑️ Remove Animation from Pack"
                                                                  ToolTip="Removes this animation from the asset pack schedule. Source files on disk are kept safe."
                                                                  Command="{Binding PlacementTarget.Tag.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Stage Accent Strip with ToolTip -->
                                                <Border Grid.Column="0" Width="6" CornerRadius="3" Margin="0,0,8,0" Background="{Binding EntryColorHex}" ToolTip="{Binding StageName}"/>

                                                <!-- Animation Name & Dual-Dimension Subtitle -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SummarySubtitleText}" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Coverage Badge -->
                                                <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="4,0" VerticalAlignment="Center" ToolTip="Cell coverage area">
                                                    <TextBlock Text="{Binding CoverageText}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                </Border>

                                                <!-- Weight Badge -->
                                                <Border Grid.Column="3" Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="4,0">
                                                    <TextBlock Text="{Binding WeightText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                                </Border>

                                                <!-- Validation Diagnostic Icon (when issues exist) -->
                                                <Border Grid.Column="4" Visibility="{Binding HasValidationIssues, Converter={StaticResource BoolToVis}}"
                                                        Background="Transparent" VerticalAlignment="Center" Margin="4,0,0,0"
                                                        ToolTip="{Binding ValidationBadgeTooltip}">
                                                    <TextBlock Text="{Binding ValidationBadgeIcon}" FontSize="11" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Actionable Diagnostics Panel (When issues exist) -->
                        <Border Visibility="{Binding HasValidationIssues, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Status.Danger}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="VALIDATION ISSUES &amp; QUICK FIXES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Danger}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="⚡ Fix All Issues" Style="{StaticResource AccentButtonStyle}" Height="24" Padding="10,0" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Command="{Binding FixAllDiagnosticsCommand}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding ActionableDiagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding SeverityIcon}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TargetName, StringFormat='[{0}]'}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                        <TextBlock Text="{Binding Message}" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="{Binding QuickFixLabel}" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="8,0" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" Command="{Binding QuickFixCommand}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Animation Preview Card with Frame Scrubber & Playback Controls -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- Header & Telemetry Badges -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎬 ANIMATION PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedName, StringFormat=' — {0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" Height="22" FontSize="9" MinWidth="105" Margin="0,0,4,0" Padding="6,1,20,1"
                                                  ItemsSource="{Binding ThemePalettes}"
                                                  SelectedIndex="{Binding SelectedPaletteIndex, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  ToolTip="Select Flipper LCD display color palette"/>
                                        <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Current frame position">
                                            <TextBlock Text="{Binding PreviewFrameCountText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        </Border>
                                        <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Playback frame rate">
                                            <TextBlock Text="{Binding PreviewFpsBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                        </Border>
                                        <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" ToolTip="Sprite dimensions">
                                            <TextBlock Text="{Binding PreviewDimensionsText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Pixel Preview Canvas (Exact 128x64 / 2:1 Hardware Aspect Ratio) -->
                                <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="136" UseLayoutRounding="True">
                                        <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1.5" CornerRadius="4" Width="256" Height="128" ClipToBounds="True">
                                            <Image Source="{Binding PreviewBitmap}" Width="256" Height="128" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                                        </Border>
                                    </Viewbox>
                                </Border>

                                <!-- Full-Width Timeline Frame Scrubber -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,2">
                                        <TextBlock Text="Timeline Scrubber" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PreviewFrameCountText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider Grid.Row="1" Minimum="0" Maximum="{Binding PreviewMaxFrameIndex}" Value="{Binding CurrentPreviewFrameIndex, Mode=TwoWay}"
                                            IsEnabled="{Binding PreviewHasMultipleFrames}" IsSnapToTickEnabled="True" TickFrequency="1"
                                            VerticalAlignment="Center" ToolTip="Scrub animation frames"/>
                                </Grid>

                                <!-- Dedicated Playback Navigation & Action Toolbar -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Transport Controls (Left) -->
                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ModernButtonStyle}" Width="30" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="Previous Frame (Ctrl+Left)" Command="{Binding PreviewPrevFrameCommand}">
                                            <Path Data="M 3,3 H 5 V 13 H 3 Z M 13,3 L 5,8 L 13,13 Z" Fill="{DynamicResource Brush.Text.Primary}" Width="10" Height="10" Stretch="Uniform"/>
                                        </Button>
                                        <Button Content="{Binding PreviewPlayButtonText}" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,0" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold" ToolTip="Play / Pause preview animation (Space)" Command="{Binding TogglePreviewPlayCommand}"/>
                                        <Button Style="{StaticResource ModernButtonStyle}" Width="30" Height="28" Padding="0" Margin="0,0,4,0" ToolTip="Next Frame (Ctrl+Right)" Command="{Binding PreviewNextFrameCommand}">
                                            <Path Data="M 11,3 H 13 V 13 H 11 Z M 3,3 L 11,8 L 3,13 Z" Fill="{DynamicResource Brush.Text.Primary}" Width="10" Height="10" Stretch="Uniform"/>
                                        </Button>
                                        <ToggleButton IsChecked="{Binding IsPreviewLooping, Mode=TwoWay}" Style="{StaticResource ModernToggleButtonStyle}" Height="28" Padding="8,0" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold" ToolTip="Toggle looping playback">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔁 Loop" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <Button Content="{Binding PreviewSpeedText}" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,0" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold" ToolTip="Cycle playback speed (0.5x / 1.0x / 2.0x)" Command="{Binding CyclePreviewSpeedCommand}"/>
                                    </WrapPanel>

                                    <!-- Action Launcher (Right) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="💾 Export .hexp" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,0" Margin="0,0,4,0" FontSize="10" FontWeight="SemiBold" ToolTip="Export this animation to a standalone .hexp file" Command="{Binding ExportSelectedHexpCommand}"/>
                                        <Button Content="🎨 Open in Canvas" Style="{StaticResource AccentButtonStyle}" Height="28" Padding="12,0" FontSize="11" FontWeight="Bold" ToolTip="Focus or open this sprite in a Hexprite canvas tab" Command="{Binding OpenSelectedInCanvasCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Selected Animation Bounds & Manifest Metadata Inspector -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                IsEnabled="{Binding HasSelectedEntry}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="SELECTED ANIMATION BOUNDS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="⚡ Baby" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="8,0" Margin="0,0,3,0" FontSize="9" FontWeight="SemiBold" Command="{Binding SetStagePresetCommand}" CommandParameter="Baby" ToolTip="Set range to Baby life stage (L1-9)"/>
                                        <Button Content="⚡ Teen" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="8,0" Margin="0,0,3,0" FontSize="9" FontWeight="SemiBold" Command="{Binding SetStagePresetCommand}" CommandParameter="Teen" ToolTip="Set range to Teen life stage (L10-19)"/>
                                        <Button Content="⚡ Adult" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="8,0" FontSize="9" FontWeight="SemiBold" Command="{Binding SetStagePresetCommand}" CommandParameter="Adult" ToolTip="Set range to Adult life stage (L20-30)"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Name Input -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Name:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="24" FontSize="11"
                                             Text="{Binding SelectedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <!-- Level Min/Max Steppers -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Min Level (1-30):" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="24" FontSize="11" TextAlignment="Center"
                                                     Text="{Binding SelectedMinLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Content="−" Style="{StaticResource ModernButtonStyle}" Width="20" Height="24" Margin="2,0,0,0" Padding="0" FontSize="10" Command="{Binding StepMinLevelCommand}" CommandParameter="-1"/>
                                            <Button Grid.Column="2" Content="+" Style="{StaticResource ModernButtonStyle}" Width="20" Height="24" Margin="2,0,0,0" Padding="0" FontSize="10" Command="{Binding StepMinLevelCommand}" CommandParameter="1"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Max Level (1-30):" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="24" FontSize="11" TextAlignment="Center"
                                                     Text="{Binding SelectedMaxLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Content="−" Style="{StaticResource ModernButtonStyle}" Width="20" Height="24" Margin="2,0,0,0" Padding="0" FontSize="10" Command="{Binding StepMaxLevelCommand}" CommandParameter="-1"/>
                                            <Button Grid.Column="2" Content="+" Style="{StaticResource ModernButtonStyle}" Width="20" Height="24" Margin="2,0,0,0" Padding="0" FontSize="10" Command="{Binding StepMaxLevelCommand}" CommandParameter="1"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Mood Min/Max Steppers -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Min Mood (0-14):" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="24" FontSize="11" TextAlignment="Center"
                                                     Text="{Binding SelectedMinButthurt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Content="−" Style="{StaticResource ModernButtonStyle}" Width="20" Height="24" Margin="2,0,0,0" Padding="0" FontSize="10" Command="{Binding StepMinMoodCommand}" CommandParameter="-1"/>
                                            <Button Grid.Column="2" Content="+" Style="{StaticResource ModernButtonStyle}" Width="20" Height="24" Margin="2,0,0,0" Padding="0" FontSize="10" Command="{Binding StepMinMoodCommand}" CommandParameter="1"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Max Mood (0-14):" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="24" FontSize="11" TextAlignment="Center"
                                                     Text="{Binding SelectedMaxButthurt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Content="−" Style="{StaticResource ModernButtonStyle}" Width="20" Height="24" Margin="2,0,0,0" Padding="0" FontSize="10" Command="{Binding StepMaxMoodCommand}" CommandParameter="-1"/>
                                            <Button Grid.Column="2" Content="+" Style="{StaticResource ModernButtonStyle}" Width="20" Height="24" Margin="2,0,0,0" Padding="0" FontSize="10" Command="{Binding StepMaxMoodCommand}" CommandParameter="1"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Weight Input with Step Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Weight (1-100):" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Weight share for random selection (1-100)"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="24" FontSize="11" TextAlignment="Center"
                                             Text="{Binding SelectedWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="2" Content="−" Style="{StaticResource ModernButtonStyle}" Width="20" Height="24" Margin="2,0,0,0" Padding="0" FontSize="10" Command="{Binding StepWeightCommand}" CommandParameter="-1" ToolTip="Decrease weight"/>
                                    <Button Grid.Column="3" Content="+" Style="{StaticResource ModernButtonStyle}" Width="20" Height="24" Margin="2,0,0,0" Padding="0" FontSize="10" Command="{Binding StepWeightCommand}" CommandParameter="1" ToolTip="Increase weight"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Selected Multi-Cell Region Inspector Card -->
                        <Border Visibility="{Binding HasSelectedRegion, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔍 " FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="SELECTED REGION INSPECTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="✕ Clear" Style="{StaticResource ModernButtonStyle}" Height="20" Padding="6,0" FontSize="9" HorizontalAlignment="Right" Command="{Binding ClearRegionSelectionCommand}" ToolTip="Clear region selection (Esc)"/>
                                </Grid>

                                <TextBlock Text="{Binding SelectedRegionSummaryText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}" Margin="0,2,0,6" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="Cells" FontSize="9" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBlock Text="{Binding SelectedRegionCellCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="Coverage" FontSize="9" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBlock Text="{Binding SelectedRegionCoveragePercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Success}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="3,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Gaps" FontSize="9" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBlock Text="{Binding SelectedRegionGapCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Danger}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Region Action Buttons -->
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="🎯 Assign Target to Region" Style="{StaticResource AccentButtonStyle}" Height="24" Padding="8,0" Margin="0,0,4,0" FontSize="10" FontWeight="Bold"
                                            Command="{Binding AssignSelectedEntryToRegionCommand}"
                                            IsEnabled="{Binding HasSelectedEntry}"
                                            ToolTip="Set the currently targeted animation's bounds to this selected region"/>
                                    <Button Content="✨ Create Tab for Region Gaps" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="8,0" FontSize="10" FontWeight="SemiBold"
                                            Command="{Binding CreateTabForRegionGapsCommand}"
                                            Visibility="{Binding HasSelectedRegionGap, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Create a new 128x64 drawing tab covering this region's gap"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Bottom: Selected Cell State Inspector Card -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="INSPECTED STATE PROBABILITIES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding InspectedCellTotalWeightText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding SelectedCellSummaryText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}" Margin="0,0,0,8"/>

                                <!-- Case 1: Probabilities List -->
                                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasSelectedCellCoverage, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding SelectedCellProbabilities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,4,3" Background="Transparent" Cursor="Hand" ToolTip="Click to select, double-click to edit on canvas" MouseLeftButtonDown="SelectedCellProbability_MouseLeftButtonDown">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                                        <ProgressBar Style="{StaticResource HighVisibilityProgressBarStyle}"
                                                                     Value="{Binding Percentage}" Maximum="100" Height="6" Margin="0,4,8,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding DisplayText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Success}" FontFamily="{DynamicResource Font.Code}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="−" Style="{StaticResource ModernButtonStyle}" Width="18" Height="20" Padding="0" FontSize="9"
                                                                ToolTip="Decrease weight for this animation"
                                                                Command="{Binding DataContext.DecreaseProbabilityWeightCommand, RelativeSource={RelativeSource AncestorType=views:AssetPackEditorPanel}}"
                                                                CommandParameter="{Binding}" Margin="0,0,2,0"/>
                                                        <Button Content="+" Style="{StaticResource ModernButtonStyle}" Width="18" Height="20" Padding="0" FontSize="9"
                                                                ToolTip="Increase weight for this animation"
                                                                Command="{Binding DataContext.IncreaseProbabilityWeightCommand, RelativeSource={RelativeSource AncestorType=views:AssetPackEditorPanel}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Case 2: Deadzone Gap Indicator -->
                                <Border Visibility="{Binding HasSelectedCellGap, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Status.Danger}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,2,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Deadzone Gap — 0% Coverage" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Status.Danger}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="No animations are scheduled for this state. Adjust level/mood ranges or create a new canvas animation tab to fill this gap."
                                                   FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" LineHeight="14" Margin="0,0,0,8"/>
                                        <Button Content="✨ Create Canvas Tab for Gap" Style="{StaticResource AccentButtonStyle}" Height="26" Padding="12,0" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left" Command="{Binding CreateTabForGapCommand}" ToolTip="Open a new 128x64 drawing tab in Hexprite pre-configured to cover this level and mood gap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 VIEW 2: DATA TABLE ROSTER (High-Density Spreadsheet for 40+ Animations)
                 ═══════════════════════════════════════════════════════════════ -->
            <Grid Visibility="{Binding IsDataGridRosterView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bulk Operations & Filters Sticky Bar -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Search & Filters -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11"
                                     Text="{Binding SearchFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search animations by name or details"/>

                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" Height="26" MinWidth="85" Margin="6,0,0,0" Padding="8,2,24,2" FontSize="11"
                                      ItemsSource="{Binding StageFilters}" SelectedItem="{Binding SelectedStageFilter, Mode=TwoWay}"
                                      ToolTip="Filter by Stage"/>

                            <ComboBox Grid.Column="2" Style="{StaticResource ModernComboBoxStyle}" Height="26" MinWidth="85" Margin="6,0,0,0" Padding="8,2,24,2" FontSize="11"
                                      ItemsSource="{Binding MoodFilters}" SelectedItem="{Binding SelectedMoodFilter, Mode=TwoWay}"
                                      ToolTip="Filter by Mood"/>

                            <ComboBox Grid.Column="3" Style="{StaticResource ModernComboBoxStyle}" Height="26" MinWidth="95" Margin="6,0,0,0" Padding="8,2,24,2" FontSize="11"
                                      ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                                      ToolTip="Sort Table Rows"/>

                            <Button Grid.Column="4" Content="✕" Style="{StaticResource ModernButtonStyle}"
                                    Height="26" Width="26" Margin="6,0,0,0" Padding="0" FontSize="11"
                                    Command="{Binding ResetFiltersCommand}"
                                    ToolTip="Reset filters"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <!-- Row 1: Bulk Actions Bar -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Selection Helpers & Bulk Manipulators -->
                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Selection Badge -->
                                <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Selected animations count">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📌 " FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedEntriesCountPillText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Base}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Stage Quick Select -->
                                <Button Content="👶 Baby" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,2,0" FontSize="10" Command="{Binding SelectAllInStageCommand}" CommandParameter="Baby" ToolTip="Select all Baby animations"/>
                                <Button Content="👦 Teen" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,2,0" FontSize="10" Command="{Binding SelectAllInStageCommand}" CommandParameter="Teen" ToolTip="Select all Teen animations"/>
                                <Button Content="🐬 Adult" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,6,0" FontSize="10" Command="{Binding SelectAllInStageCommand}" CommandParameter="Adult" ToolTip="Select all Adult animations"/>

                                <!-- Bulk Level Manipulator -->
                                <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Level:" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button Content="◀" Style="{StaticResource ModernButtonStyle}" Height="20" Width="20" Padding="0" Margin="0,0,2,0" FontSize="9" Command="{Binding BulkShiftLevelCommand}" CommandParameter="-1" ToolTip="Slide level range window left (preserves span)"/>
                                        <Button Content="▶" Style="{StaticResource ModernButtonStyle}" Height="20" Width="20" Padding="0" Margin="0,0,4,0" FontSize="9" Command="{Binding BulkShiftLevelCommand}" CommandParameter="1" ToolTip="Slide level range window right (preserves span)"/>
                                        <Button Content="−" Style="{StaticResource ModernButtonStyle}" Height="20" Width="20" Padding="0" Margin="0,0,2,0" FontSize="10" Command="{Binding BulkShrinkLevelCommand}" CommandParameter="1" ToolTip="Shrink level range (MaxLevel - 1)"/>
                                        <Button Content="+" Style="{StaticResource ModernButtonStyle}" Height="20" Width="20" Padding="0" Margin="0,0,2,0" FontSize="10" Command="{Binding BulkExpandLevelCommand}" CommandParameter="1" ToolTip="Expand level range (MaxLevel + 1)"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bulk Mood Manipulator -->
                                <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Mood:" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button Content="◀" Style="{StaticResource ModernButtonStyle}" Height="20" Width="20" Padding="0" Margin="0,0,2,0" FontSize="9" Command="{Binding BulkShiftMoodCommand}" CommandParameter="-1" ToolTip="Slide mood range window down (preserves span)"/>
                                        <Button Content="▶" Style="{StaticResource ModernButtonStyle}" Height="20" Width="20" Padding="0" Margin="0,0,4,0" FontSize="9" Command="{Binding BulkShiftMoodCommand}" CommandParameter="1" ToolTip="Slide mood range window up (preserves span)"/>
                                        <Button Content="−" Style="{StaticResource ModernButtonStyle}" Height="20" Width="20" Padding="0" Margin="0,0,2,0" FontSize="10" Command="{Binding BulkShrinkMoodCommand}" CommandParameter="1" ToolTip="Shrink mood range (MaxMood - 1)"/>
                                        <Button Content="+" Style="{StaticResource ModernButtonStyle}" Height="20" Width="20" Padding="0" Margin="0,0,2,0" FontSize="10" Command="{Binding BulkExpandMoodCommand}" CommandParameter="1" ToolTip="Expand mood range (MaxMood + 1)"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bulk Weight Manipulator -->
                                <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Weight:" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button Content="−1" Style="{StaticResource ModernButtonStyle}" Height="20" Width="22" Padding="0" Margin="0,0,2,0" FontSize="10" Command="{Binding BulkShiftWeightCommand}" CommandParameter="-1" ToolTip="Decrease weight by 1"/>
                                        <Button Content="+1" Style="{StaticResource ModernButtonStyle}" Height="20" Width="22" Padding="0" Margin="0,0,4,0" FontSize="10" Command="{Binding BulkShiftWeightCommand}" CommandParameter="1" ToolTip="Increase weight by 1"/>
                                        <Button Content="1" Style="{StaticResource ModernButtonStyle}" Height="20" Width="20" Padding="0" Margin="0,0,2,0" FontSize="10" Command="{Binding BulkSetWeightCommand}" CommandParameter="1" ToolTip="Set weight to 1"/>
                                        <Button Content="5" Style="{StaticResource ModernButtonStyle}" Height="20" Width="20" Padding="0" Margin="0,0,2,0" FontSize="10" Command="{Binding BulkSetWeightCommand}" CommandParameter="5" ToolTip="Set weight to 5"/>
                                        <Button Content="10" Style="{StaticResource ModernButtonStyle}" Height="20" Width="22" Padding="0" FontSize="10" Command="{Binding BulkSetWeightCommand}" CommandParameter="10" ToolTip="Set weight to 10"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bulk Stage Manipulator -->
                                <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Stage:" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button Content="👶 Baby" Style="{StaticResource ModernButtonStyle}" Height="20" Padding="6,0" Margin="0,0,2,0" FontSize="10" Command="{Binding BulkSetStageCommand}" CommandParameter="Baby"/>
                                        <Button Content="👦 Teen" Style="{StaticResource ModernButtonStyle}" Height="20" Padding="6,0" Margin="0,0,2,0" FontSize="10" Command="{Binding BulkSetStageCommand}" CommandParameter="Teen"/>
                                        <Button Content="🐬 Adult" Style="{StaticResource ModernButtonStyle}" Height="20" Padding="6,0" Margin="0,0,2,0" FontSize="10" Command="{Binding BulkSetStageCommand}" CommandParameter="Adult"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Bulk Clone & Delete -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📋 Clone Selected" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="10,0" Margin="0,0,4,0" FontSize="10" Command="{Binding BulkDuplicateCommand}"/>
                                <Button Content="🗑️ Delete Selected" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="10,0" FontSize="10" Command="{Binding BulkDeleteCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Dense Virtualized Spreadsheet ItemsControl -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="0,0,0,1" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*" MinWidth="180"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding MasterSelectionState, Mode=OneWay}"
                                          Command="{Binding ToggleSelectAllCommand}"
                                          VerticalAlignment="Center" ToolTip="Select All / Deselect All"/>
                                <Button Grid.Column="1" Command="{Binding SortByColumnCommand}" CommandParameter="Status"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" Cursor="Hand"
                                        ToolTip="Sort by Status / Diagnostics">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="St" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding StatusSortGlyph}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding SortByColumnCommand}" CommandParameter="Name"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" Cursor="Hand"
                                        ToolTip="Sort by Animation Name">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Animation Name" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding NameSortGlyph}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding SortByColumnCommand}" CommandParameter="Level"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" Cursor="Hand"
                                        ToolTip="Sort by Level Range">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Level (Min - Max)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding LevelSortGlyph}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Command="{Binding SortByColumnCommand}" CommandParameter="Mood"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" Cursor="Hand"
                                        ToolTip="Sort by Mood / Butthurt Range">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Mood (Min - Max)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding MoodSortGlyph}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="5" Command="{Binding SortByColumnCommand}" CommandParameter="Weight"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" Cursor="Hand"
                                        ToolTip="Sort by Weight">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Weight" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding WeightSortGlyph}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="6" Command="{Binding SortByColumnCommand}" CommandParameter="Coverage"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" Cursor="Hand"
                                        ToolTip="Sort by Matrix Coverage">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Coverage" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding CoverageSortGlyph}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="7" Command="{Binding SortByColumnCommand}" CommandParameter="Stage"
                                        Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" Cursor="Hand"
                                        ToolTip="Sort by Life Stage">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Life Stage" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding StageSortGlyph}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="8" Text="Actions" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            </Grid>
                        </Border>

                        <!-- Scrollable Roster Rows -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                            <ItemsControl ItemsSource="{Binding FilteredEntries}"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="0,0,0,1" Padding="10,5" Background="Transparent"
                                                Focusable="True"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                PreviewMouseLeftButtonDown="DataTableRow_PreviewMouseLeftButtonDown"
                                                PreviewMouseRightButtonDown="ListBoxItem_PreviewMouseRightButtonDown"
                                                MouseDown="DataTableRow_MouseDown"
                                                KeyDown="DataTableRow_KeyDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="📍 Focus in Workspace Tab"
                                                              Command="{Binding PlacementTarget.Tag.NavigateToEntryTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="📋 Clone Animation"
                                                              Command="{Binding PlacementTarget.Tag.DuplicateEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <MenuItem Header="🗑️ Remove Animation from Pack"
                                                              ToolTip="Removes this animation from the asset pack schedule. Source files on disk are kept safe."
                                                              Command="{Binding PlacementTarget.Tag.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*" MinWidth="180"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="105"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Selection Checkbox -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>

                                                <!-- Status / Diagnostics Icon -->
                                                <Border Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding ValidationBadgeTooltip}">
                                                    <TextBlock Text="{Binding ValidationBadgeIcon}" FontSize="12"/>
                                                </Border>

                                                <!-- Animation Name with LCD Sprite Tooltip -->
                                                <Grid Grid.Column="2" Margin="0,0,8,0">
                                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="24" FontSize="11"
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             KeyDown="NameTextBox_KeyDown"
                                                             VerticalAlignment="Center">
                                                        <TextBox.ToolTip>
                                                            <ToolTip Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" Padding="8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                                                    <Image Source="{Binding SpriteThumbnail}" Width="128" Height="64" Stretch="Uniform" Margin="0,0,0,4"
                                                                           Visibility="{Binding HasSprite, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBlock Text="{Binding DetailsText}" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                                    <TextBlock Text="{Binding FrameCountText}" FontSize="9" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </TextBox.ToolTip>
                                                    </TextBox>
                                                </Grid>

                                                <!-- Level Min - Max -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="22" Width="36" FontSize="10"
                                                             Text="{Binding MinLevel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             PreviewMouseWheel="NumericTextBox_PreviewMouseWheel"
                                                             KeyDown="NumericTextBox_KeyDown"
                                                             ToolTip="Minimum Level (Scroll wheel or Up/Down to adjust)"/>
                                                    <TextBlock Text="–" FontSize="11" Margin="4,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="22" Width="36" FontSize="10"
                                                             Text="{Binding MaxLevel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             PreviewMouseWheel="NumericTextBox_PreviewMouseWheel"
                                                             KeyDown="NumericTextBox_KeyDown"
                                                             ToolTip="Maximum Level (Scroll wheel or Up/Down to adjust)"/>
                                                </StackPanel>

                                                <!-- Mood Min - Max with Quick Preset Button -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="22" Width="32" FontSize="10"
                                                             Text="{Binding MinButthurt, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             PreviewMouseWheel="NumericTextBox_PreviewMouseWheel"
                                                             KeyDown="NumericTextBox_KeyDown"
                                                             ToolTip="Min Mood / Butthurt 0-14 (Scroll wheel or Up/Down to adjust)"/>
                                                    <TextBlock Text="–" FontSize="11" Margin="3,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="22" Width="32" FontSize="10"
                                                             Text="{Binding MaxButthurt, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             PreviewMouseWheel="NumericTextBox_PreviewMouseWheel"
                                                             KeyDown="NumericTextBox_KeyDown"
                                                             ToolTip="Max Mood / Butthurt 0-14 (Scroll wheel or Up/Down to adjust)"/>
                                                    <Button Content="▾" Style="{StaticResource ModernButtonStyle}" Height="22" Width="18" Margin="4,0,0,0" Padding="0" FontSize="9"
                                                            Click="MoodButton_Click" ToolTip="Quick Mood Preset">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="😊 Happy (0–4)" Tag="Happy" Click="MoodMenuItem_Click"/>
                                                                <MenuItem Header="😐 Neutral (5–8)" Tag="Neutral" Click="MoodMenuItem_Click"/>
                                                                <MenuItem Header="😡 Angry (9–14)" Tag="Angry" Click="MoodMenuItem_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="🌐 All Moods (0–14)" Tag="All" Click="MoodMenuItem_Click"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Weight -->
                                                <TextBox Grid.Column="5" Style="{StaticResource ModernTextBoxStyle}" Height="22" Width="44" FontSize="10"
                                                         Text="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         PreviewMouseWheel="NumericTextBox_PreviewMouseWheel"
                                                         KeyDown="NumericTextBox_KeyDown"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                                         ToolTip="Weight 1-100 (Scroll wheel or Up/Down to adjust)"/>

                                                <!-- Coverage -->
                                                <TextBlock Grid.Column="6" Text="{Binding CoverageText}" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>

                                                <!-- Life Stage Interactive Selector Button -->
                                                <Button Grid.Column="7" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,8,0"
                                                        Click="StageButton_Click" ToolTip="Click to change life stage">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="👶 Baby (L1-9 or L1)" Tag="Baby" Click="StageMenuItem_Click"/>
                                                            <MenuItem Header="👦 Teen (L10-19 or L2)" Tag="Teen" Click="StageMenuItem_Click"/>
                                                            <MenuItem Header="🐬 Adult (L20-30 or L3)" Tag="Adult" Click="StageMenuItem_Click"/>
                                                            <Separator/>
                                                            <MenuItem Header="🌐 All Stages (L1-30 or L1-3)" Tag="All" Click="StageMenuItem_Click"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding StageName}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding EntryColorHex}"/>
                                                        <TextBlock Text=" ▾" FontSize="8" Foreground="{DynamicResource Brush.Text.Muted}" Margin="2,0,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Row Actions -->
                                                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="🎨 Tab" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,0" FontSize="9"
                                                            Command="{Binding DataContext.NavigateToEntryTabCommand, RelativeSource={RelativeSource AncestorType=views:AssetPackEditorPanel}}"
                                                            CommandParameter="{Binding}" ToolTip="Focus in workspace tab"/>
                                                    <Button Content="📋 Clone" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,0" FontSize="9"
                                                            Command="{Binding DataContext.DuplicateEntryCommand, RelativeSource={RelativeSource AncestorType=views:AssetPackEditorPanel}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Clone this animation"/>
                                                    <Button Content="🗑️" Style="{StaticResource ModernButtonStyle}" Height="22" Width="22" Padding="0" FontSize="9"
                                                            Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=views:AssetPackEditorPanel}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Remove animation from asset pack"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 VIEW 3: SPRITE GALLERY & ASSET HUB (Visual Card Grid of All Sprites)
                 ═══════════════════════════════════════════════════════════════ -->
            <Grid Visibility="{Binding IsSpriteGalleryView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter & Gallery Toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Search, Filters, Card Sizing & Add -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="26" FontSize="11"
                                     Text="{Binding SearchFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search gallery cards by name or details"/>

                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" Height="26" MinWidth="85" Margin="6,0,0,0" Padding="8,2,24,2" FontSize="11"
                                      ItemsSource="{Binding StageFilters}" SelectedItem="{Binding SelectedStageFilter, Mode=TwoWay}"
                                      ToolTip="Filter by Stage"/>

                            <ComboBox Grid.Column="2" Style="{StaticResource ModernComboBoxStyle}" Height="26" MinWidth="85" Margin="6,0,0,0" Padding="8,2,24,2" FontSize="11"
                                      ItemsSource="{Binding MoodFilters}" SelectedItem="{Binding SelectedMoodFilter, Mode=TwoWay}"
                                      ToolTip="Filter by Mood"/>

                            <ComboBox Grid.Column="3" Style="{StaticResource ModernComboBoxStyle}" Height="26" MinWidth="95" Margin="6,0,0,0" Padding="8,2,24,2" FontSize="11"
                                      ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}"
                                      ToolTip="Sort Gallery Cards"/>

                            <!-- Card Sizing Selector (S / M / L) -->
                            <Border Grid.Column="4" Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="2" Margin="6,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="S" Style="{StaticResource ModernButtonStyle}" Height="20" Width="22" Padding="0" FontSize="9" FontWeight="SemiBold"
                                            Command="{Binding SetGalleryCardSizeCommand}" CommandParameter="Compact" ToolTip="Compact Card Grid (200px)"/>
                                    <Button Content="M" Style="{StaticResource ModernButtonStyle}" Height="20" Width="22" Padding="0" Margin="2,0" FontSize="9" FontWeight="SemiBold"
                                            Command="{Binding SetGalleryCardSizeCommand}" CommandParameter="Standard" ToolTip="Standard Card Grid (260px)"/>
                                    <Button Content="L" Style="{StaticResource ModernButtonStyle}" Height="20" Width="22" Padding="0" FontSize="9" FontWeight="SemiBold"
                                            Command="{Binding SetGalleryCardSizeCommand}" CommandParameter="Large" ToolTip="Large Card Grid (330px)"/>
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="5" Content="❌" Style="{StaticResource ModernButtonStyle}" Height="26" Width="26" Padding="0" Margin="6,0,0,0" FontSize="10"
                                    Command="{Binding ResetFiltersCommand}" ToolTip="Reset All Filters"/>

                            <Button Grid.Column="6" Content="➕ Add Animation" Style="{StaticResource ModernButtonStyle}"
                                    Height="26" Padding="10,0" Margin="6,0,0,0" FontSize="11"
                                    Command="{Binding AddEntryCommand}"/>
                        </Grid>

                        <!-- Row 1: Active Selection & Quick Batch Bar -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Selection Pill Badge -->
                                <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Active selection count">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📌 " FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedEntriesCountPillText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Base}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Filtered count indicator -->
                                <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FilteredEntriesCountText}" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Quick Stage Select -->
                                <Button Content="👶 Baby" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,2,0" FontSize="10" Command="{Binding SelectAllInStageCommand}" CommandParameter="Baby" ToolTip="Select all Baby animations"/>
                                <Button Content="👦 Teen" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,2,0" FontSize="10" Command="{Binding SelectAllInStageCommand}" CommandParameter="Teen" ToolTip="Select all Teen animations"/>
                                <Button Content="🐬 Adult" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" Margin="0,0,6,0" FontSize="10" Command="{Binding SelectAllInStageCommand}" CommandParameter="Adult" ToolTip="Select all Adult animations"/>
                            </WrapPanel>

                            <!-- Bulk Actions -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📋 Clone Selected" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="10,0" Margin="0,0,4,0" FontSize="10" Command="{Binding BulkDuplicateCommand}"/>
                                <Button Content="🗑️ Delete Selected" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="10,0" FontSize="10" Command="{Binding BulkDeleteCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Scrollable Responsive Visual Cards Grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredEntries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1.5" CornerRadius="8" Margin="0,0,10,10" Padding="10"
                                        Focusable="True" SnapsToDevicePixels="True"
                                        Width="{Binding DataContext.GalleryCardWidth, RelativeSource={RelativeSource AncestorType=views:AssetPackEditorPanel}}"
                                        Height="{Binding DataContext.GalleryCardHeight, RelativeSource={RelativeSource AncestorType=views:AssetPackEditorPanel}}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        PreviewMouseLeftButtonDown="GalleryCard_PreviewMouseLeftButtonDown"
                                        KeyDown="GalleryCard_KeyDown"
                                        MouseEnter="GalleryCard_MouseEnter"
                                        MouseLeave="GalleryCard_MouseLeave"
                                        PreviewMouseRightButtonDown="ListBoxItem_PreviewMouseRightButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Base}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Active}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📍 Focus in Workspace Tab"
                                                      Command="{Binding PlacementTarget.Tag.NavigateToEntryTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="📋 Clone Animation"
                                                      Command="{Binding PlacementTarget.Tag.DuplicateEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="🗑️ Remove Animation from Pack"
                                                      ToolTip="Removes this animation from the asset pack schedule. Source files on disk are kept safe."
                                                      Command="{Binding PlacementTarget.Tag.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card Header: Selection Checkbox + Name + Status -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Select / Deselect"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Visibility="{Binding HasValidationIssues, Converter={StaticResource BoolToVis}}"
                                                    Background="Transparent" VerticalAlignment="Center" ToolTip="{Binding ValidationBadgeTooltip}">
                                                <TextBlock Text="{Binding ValidationBadgeIcon}" FontSize="12"/>
                                            </Border>
                                        </Grid>

                                        <!-- LCD Pixel Preview Thumbnail with Live Hover Animation -->
                                        <Border Grid.Row="1" Background="#FF8200" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1.5" CornerRadius="4"
                                                Height="{Binding DataContext.GalleryThumbnailHeight, RelativeSource={RelativeSource AncestorType=views:AssetPackEditorPanel}}"
                                                ClipToBounds="True" Margin="0,0,0,4">
                                            <Grid>
                                                <Image Source="{Binding ActivePreviewThumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="4,1" CornerRadius="3" Background="#90000000"
                                                        Visibility="{Binding IsPreviewPlaying, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="▶ PLAYING" FontSize="8" FontWeight="Bold" Foreground="#39FF14"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Telemetry & Bounds Badges -->
                                        <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                <!-- Interactive Stage Badge -->
                                                <Button Style="{StaticResource ModernButtonStyle}" Height="20" Padding="5,0" Margin="0,0,4,2" Click="StageButton_Click" ToolTip="Change life stage">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="👶 Baby (L1-9 or L1)" Tag="Baby" Click="StageMenuItem_Click"/>
                                                            <MenuItem Header="👦 Teen (L10-19 or L2)" Tag="Teen" Click="StageMenuItem_Click"/>
                                                            <MenuItem Header="🐬 Adult (L20-30 or L3)" Tag="Adult" Click="StageMenuItem_Click"/>
                                                            <Separator/>
                                                            <MenuItem Header="🌐 All Stages (L1-30 or L1-3)" Tag="All" Click="StageMenuItem_Click"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding StageName}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding EntryColorHex}"/>
                                                        <TextBlock Text=" ▾" FontSize="7" Foreground="{DynamicResource Brush.Text.Muted}" Margin="2,0,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Interactive Mood Badge -->
                                                <Button Style="{StaticResource ModernButtonStyle}" Height="20" Padding="5,0" Margin="0,0,4,2" Click="MoodButton_Click" ToolTip="Change mood preset">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="😊 Happy (0–4)" Tag="Happy" Click="MoodMenuItem_Click"/>
                                                            <MenuItem Header="😐 Neutral (5–9)" Tag="Neutral" Click="MoodMenuItem_Click"/>
                                                            <MenuItem Header="😡 Angry (10–14)" Tag="Angry" Click="MoodMenuItem_Click"/>
                                                            <Separator/>
                                                            <MenuItem Header="🌐 All Moods (0–14)" Tag="All" Click="MoodMenuItem_Click"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding MoodRangeName}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding MoodColorHex}"/>
                                                        <TextBlock Text=" ▾" FontSize="7" Foreground="{DynamicResource Brush.Text.Muted}" Margin="2,0,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,2">
                                                    <TextBlock Text="{Binding FrameCountText}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding DetailsText}" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Card Footer: Quick Actions -->
                                        <Grid Grid.Row="3" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="🎨 Focus Tab" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" FontSize="10" FontWeight="SemiBold"
                                                    Command="{Binding DataContext.NavigateToEntryTabCommand, RelativeSource={RelativeSource AncestorType=views:AssetPackEditorPanel}}"
                                                    CommandParameter="{Binding}" ToolTip="Open animation in workspace tab"/>
                                            <Button Grid.Column="1" Content="📋" Style="{StaticResource ModernButtonStyle}" Height="24" Width="26" Padding="0" Margin="4,0,0,0" FontSize="10"
                                                    Command="{Binding DataContext.DuplicateEntryCommand, RelativeSource={RelativeSource AncestorType=views:AssetPackEditorPanel}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Clone animation"/>
                                            <Button Grid.Column="2" Content="🗑️" Style="{StaticResource ModernButtonStyle}" Height="24" Width="26" Padding="0" Margin="4,0,0,0" FontSize="10"
                                                    Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=views:AssetPackEditorPanel}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete animation"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State Overlay -->
                <Border Grid.Row="1" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasNoFilteredEntries, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="No animations match your current filters." FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Try adjusting your search terms, stage, or mood filters." FontSize="11"
                                   Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Button Content="🔄 Reset All Filters" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="14,0"
                                HorizontalAlignment="Center" Command="{Binding ResetFiltersCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════
                 VIEW 4: VIRTUAL DEVICE SIMULATOR (Embedded Console & RNG Studio)
                 ═══════════════════════════════════════════════════════════════ -->
            <Grid Visibility="{Binding IsDeviceSimulatorView, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="470" MinWidth="420"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                <!-- ─────────────────────────────────────────────────────────
                     LEFT COLUMN: Console, Transport & Interactive Inspector
                     ───────────────────────────────────────────────────────── -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel>
                        <!-- CARD 1: Virtual Flipper Console Frame -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Top Bar: State Badge & Palette -->
                                <Grid Margin="0,0,0,8">
                                    <Border Background="{DynamicResource Brush.Surface.Active}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding SimulatorViewModel.StateBadgeText}" Foreground="{DynamicResource Brush.Accent.Base}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Theme:" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" Width="155" Height="24"
                                                  ItemsSource="{Binding SimulatorViewModel.ThemePalettes}"
                                                  SelectedIndex="{Binding SimulatorViewModel.SelectedPaletteIndex, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="12" Height="12" CornerRadius="2" Background="{Binding BackgroundBrush}" BorderBrush="{Binding ForegroundBrush}" BorderThickness="1" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="10" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Virtual Screen Bezel: 3x integer scaling (384x192) -->
                                <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="3" CornerRadius="4" HorizontalAlignment="Center">
                                    <Image Source="{Binding SimulatorViewModel.ScreenBitmap}" Width="384" Height="192" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill"
                                           MouseLeftButtonDown="ImgEmbeddedFlipperScreen_MouseLeftButtonDown"
                                           MouseMove="ImgEmbeddedFlipperScreen_MouseMove"
                                           MouseLeftButtonUp="ImgEmbeddedFlipperScreen_MouseLeftButtonUp"
                                           Cursor="Hand"/>
                                </Border>

                                <!-- Screen Sub-Bezel Controls: Speed & Display Options -->
                                <Grid Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Speed:" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <RadioButton Content="0.5x" GroupName="EmbeddedSimSpeed" Style="{StaticResource ChipButtonStyle}" Margin="0,0,3,0" Checked="EmbeddedSpeedChip_Checked"/>
                                        <RadioButton Content="1x" GroupName="EmbeddedSimSpeed" IsChecked="True" Style="{StaticResource ChipButtonStyle}" Margin="0,0,3,0" Checked="EmbeddedSpeedChip_Checked"/>
                                        <RadioButton Content="2x" GroupName="EmbeddedSimSpeed" Style="{StaticResource ChipButtonStyle}" Checked="EmbeddedSpeedChip_Checked"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <CheckBox Content="LCD Grid" IsChecked="{Binding SimulatorViewModel.ShowLcdGrid, Mode=TwoWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11" Margin="0,0,10,0"/>
                                        <CheckBox Content="HUD Overlay" IsChecked="{Binding SimulatorViewModel.ShowDesktopHud, Mode=TwoWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Action Toolbar: GIF, USB Flash, Tabs, Pop-out -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="🎬 GIF..." ToolTip="Export animated GIF of active animation" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="0" FontSize="9" Command="{Binding SimulatorViewModel.ExportGifCommand}"/>
                                    <Button Grid.Column="2" Content="⚡ Flash" ToolTip="Deploy whole pack directly to Flipper Zero via USB" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="0" FontSize="9" Command="{Binding SimulatorViewModel.FlashUsbCommand}"/>
                                    <Button Grid.Column="4" Content="📂 Tabs" ToolTip="Open all animations as individual workspace tabs" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="0" FontSize="9" Command="{Binding SimulatorViewModel.OpenInTabsCommand}"/>
                                    <Button Grid.Column="6" Content="↗️ Pop Out" ToolTip="Detach simulator into a standalone floating window" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="0" FontSize="9" Command="{Binding SimulatorViewModel.PopOutWindowCommand}"/>
                                </Grid>

                                <TextBlock Text="💡 Tip: Click &amp; drag speech bubble on virtual screen • Space: Play/Pause • Enter: Active"
                                           Foreground="{DynamicResource Brush.Text.Muted}" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: Timeline Scrubber & Transport Toolbar -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Timeline Scrubber" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" FontWeight="SemiBold"/>
                                    <Border Background="{DynamicResource Brush.Surface.Active}" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SimulatorViewModel.FrameCounterText}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <Slider Minimum="0"
                                        Maximum="{Binding SimulatorViewModel.MaxSequenceIndex}"
                                        Value="{Binding SimulatorViewModel.SequenceIndex, Mode=TwoWay}"
                                        SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,8"/>

                                <!-- Transport Navigation Toolbar -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="125"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button Grid.Column="0" ToolTip="Reset to Passive Frame 0 (R)" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="0" Command="{Binding SimulatorViewModel.ResetCommand}">
                                        <Path Data="M 8,3 L 2,8 L 8,13 Z M 14,3 L 8,8 L 14,13 Z" Fill="{DynamicResource Brush.Text.Primary}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>

                                    <Button Grid.Column="2" ToolTip="Previous Frame (Left Arrow)" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="0" Command="{Binding SimulatorViewModel.StepBackCommand}">
                                        <Path Data="M 3,3 H 5 V 13 H 3 Z M 13,3 L 5,8 L 13,13 Z" Fill="{DynamicResource Brush.Text.Primary}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                    
                                    <Button Grid.Column="4" Style="{StaticResource AccentButtonStyle}" Height="28" Padding="6,2" Command="{Binding SimulatorViewModel.PlayPauseCommand}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="M 3,2 H 6 V 14 H 3 Z M 10,2 H 13 V 14 H 10 Z" Fill="{DynamicResource Brush.Accent.Foreground}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Play / Pause" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Foreground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Grid.Column="6" ToolTip="Next Frame (Right Arrow)" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="0" Command="{Binding SimulatorViewModel.StepForwardCommand}">
                                        <Path Data="M 11,3 H 13 V 13 H 11 Z M 3,3 L 11,8 L 3,13 Z" Fill="{DynamicResource Brush.Text.Primary}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                    
                                    <Button Grid.Column="8" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="8,2" Command="{Binding SimulatorViewModel.TriggerActiveCommand}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="M 9,1 L 2,9 H 8 L 7,15 L 14,7 H 8 Z" Fill="{DynamicResource Brush.Accent.Base}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Play Active" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: Interactive Inspector Tabs (Speech Bubble vs Hardware D-Pad) -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <TabControl Background="Transparent" BorderThickness="0" Padding="0" SelectedIndex="{Binding SimulatorViewModel.SelectedInspectorTabIndex, Mode=TwoWay}">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TabItem">
                                                    <Border x:Name="TabBorder" Padding="12,5" Margin="0,0,4,0" Background="Transparent" CornerRadius="5,5,0,0" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                                                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush.Surface.Active}"/>
                                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsSelected" Value="False"/>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.Resources>

                                <!-- TAB 1: 💬 Speech Bubble Editor -->
                                <TabItem Header="💬 Speech Bubble">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Enable CheckBox & Anchor Preset Buttons -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <CheckBox Content="Enable Speech Bubble Overlay" IsChecked="{Binding SimulatorViewModel.ShowSpeechBubble, Mode=TwoWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Anchors:" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="↖ TL" ToolTip="Align Top-Left" Style="{StaticResource ModernButtonStyle}" Height="20" Padding="5,0" Margin="0,0,2,0" FontSize="9" Command="{Binding SimulatorViewModel.SetBubbleAlignmentCommand}" CommandParameter="TL"/>
                                                        <Button Content="↗ TR" ToolTip="Align Top-Right" Style="{StaticResource ModernButtonStyle}" Height="20" Padding="5,0" Margin="0,0,2,0" FontSize="9" Command="{Binding SimulatorViewModel.SetBubbleAlignmentCommand}" CommandParameter="TR"/>
                                                        <Button Content="↙ BL" ToolTip="Align Bottom-Left" Style="{StaticResource ModernButtonStyle}" Height="20" Padding="5,0" Margin="0,0,2,0" FontSize="9" Command="{Binding SimulatorViewModel.SetBubbleAlignmentCommand}" CommandParameter="BL"/>
                                                        <Button Content="↘ BR" ToolTip="Align Bottom-Right" Style="{StaticResource ModernButtonStyle}" Height="20" Padding="5,0" FontSize="9" Command="{Binding SimulatorViewModel.SetBubbleAlignmentCommand}" CommandParameter="BR"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 1: Text Input Box & Tail Selector -->
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                     Text="{Binding SimulatorViewModel.CustomBubbleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="28" MaxHeight="60"
                                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="6,4"/>
                                            <ComboBox Grid.Column="2" Style="{StaticResource ModernComboBoxStyle}" Height="28" VerticalAlignment="Top"
                                                      SelectedIndex="{Binding SimulatorViewModel.BubbleTailIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="↙ Bottom-Left" IsSelected="True"/>
                                                <ComboBoxItem Content="↘ Bottom-Right"/>
                                                <ComboBoxItem Content="↖ Top-Left"/>
                                                <ComboBoxItem Content="↗ Top-Right"/>
                                                <ComboBoxItem Content="⊘ None"/>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Row 2: Coordinate Position Sliders & Value Badges -->
                                        <Grid Grid.Row="2" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="X Coordinate" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"/>
                                                    <Border Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding SimulatorViewModel.BubbleX, StringFormat='X: {0}px'}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="{Binding SimulatorViewModel.MaxBubbleX}" Value="{Binding SimulatorViewModel.BubbleX, Mode=TwoWay}" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Grid Margin="0,0,0,2">
                                                    <TextBlock Text="Y Coordinate" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"/>
                                                    <Border Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding SimulatorViewModel.BubbleY, StringFormat='Y: {0}px'}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="{Binding SimulatorViewModel.MaxBubbleY}" Value="{Binding SimulatorViewModel.BubbleY, Mode=TwoWay}" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 3: Save Bubble Action & Drag Hint -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="💾 Save to Sprite" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="10,0" FontSize="10" FontWeight="SemiBold" ToolTip="Persist speech bubble text and coordinates into active sprite metadata" Command="{Binding SimulatorViewModel.ApplyBubbleToSelectedCommand}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SimulatorViewModel.BubbleSavedFeedbackText}" Foreground="{DynamicResource Brush.Status.Success}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="💡 Tip: Drag bubble on screen to position" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="9" VerticalAlignment="Center" FontStyle="Italic"/>
                                        </Grid>
                                    </Grid>
                                </TabItem>

                                <!-- TAB 2: 🎮 Hardware D-Pad Remote -->
                                <TabItem Header="🎮 D-Pad Remote">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="84" Height="84">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Row="0" Grid.Column="1" ToolTip="D-Pad UP (Happier Mood)" Style="{StaticResource ModernButtonStyle}" Padding="0" Command="{Binding SimulatorViewModel.TriggerUpCommand}">
                                                <TextBlock Text="▲" FontSize="9" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="0" ToolTip="D-Pad LEFT (Step Back)" Style="{StaticResource ModernButtonStyle}" Padding="0" Command="{Binding SimulatorViewModel.TriggerLeftCommand}">
                                                <TextBlock Text="◀" FontSize="9" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="1" ToolTip="D-Pad OK (Trigger Active Animation)" Style="{StaticResource AccentButtonStyle}" Padding="0" Command="{Binding SimulatorViewModel.TriggerOkCommand}">
                                                <TextBlock Text="OK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Foreground}"/>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="2" ToolTip="D-Pad RIGHT (Step Forward)" Style="{StaticResource ModernButtonStyle}" Padding="0" Command="{Binding SimulatorViewModel.TriggerRightCommand}">
                                                <TextBlock Text="▶" FontSize="9" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            </Button>
                                            <Button Grid.Row="2" Grid.Column="1" ToolTip="D-Pad DOWN (Angrier Mood)" Style="{StaticResource ModernButtonStyle}" Padding="0" Command="{Binding SimulatorViewModel.TriggerDownCommand}">
                                                <TextBlock Text="▼" FontSize="9" Foreground="{DynamicResource Brush.Text.Primary}"/>
                                            </Button>
                                        </Grid>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Hardware D-Pad" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                                <TextBlock Text="{Binding SimulatorViewModel.LastButtonPressedText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Button Style="{StaticResource ModernButtonStyle}" Height="24" Padding="8,0" Margin="0,2,0,0" ToolTip="BACK Button (Reset to Passive Loop)" Command="{Binding SimulatorViewModel.TriggerBackCommand}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="↩️ BACK Button" FontSize="10" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="⌨️ Keyboard: Arrows / Enter / Esc" FontSize="9" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ─────────────────────────────────────────────────────────
                     RIGHT COLUMN: Dolphin State & Animation Candidate List
                     ───────────────────────────────────────────────────────── -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0: DOLPHIN SIMULATION STATE CARD -->
                        <RowDefinition Height="*"/>    <!-- 1: CANDIDATES LIST CARD -->
                        <RowDefinition Height="Auto"/> <!-- 2: METADATA & CANVAS CARD -->
                    </Grid.RowDefinitions>

                    <!-- CARD 1: Unified Dolphin Simulation State -->
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Level Slider Row -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Dolphin Level (1 to 30)" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" FontWeight="SemiBold"/>
                                <Border Background="{DynamicResource Brush.Surface.Active}" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SimulatorViewModel.LevelDescription}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <Slider Minimum="1" Maximum="30" Value="{Binding SimulatorViewModel.Level, Mode=TwoWay}" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,8"/>

                            <!-- Mood Slider Row -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Mood / Butthurt (0: Happy → 14: Enraged)" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" FontWeight="SemiBold"/>
                                <Border Background="{DynamicResource Brush.Surface.Active}" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SimulatorViewModel.MoodDescription}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <Slider Minimum="0" Maximum="14" Value="{Binding SimulatorViewModel.Mood, Mode=TwoWay}" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,0,8"/>

                            <!-- Deadzone State Recovery Alert (Conditional) -->
                            <Border Visibility="{Binding SimulatorViewModel.HasNoMatchingCandidates, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource Brush.Surface.Control}" BorderBrush="{DynamicResource Brush.Status.Warning}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⚠️ Uncovered State (0% match in current pack)" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Height="22" Padding="6,0" Command="{Binding SimulatorViewModel.JumpToNearestCoveredStateCommand}">
                                        <TextBlock Text="🎯 Jump to State" FontSize="9" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- RNG Pick Simulation Row -->
                            <Button Style="{StaticResource ModernButtonStyle}" Height="28" Command="{Binding SimulatorViewModel.RollRngCommand}" ToolTip="Simulate Flipper Zero random animation selector algorithm">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="M 2,2 H 14 V 14 H 2 Z M 5,5 A 1,1 0 1 1 5,5.01 M 11,5 A 1,1 0 1 1 11,5.01 M 8,8 A 1,1 0 1 1 8,8.01 M 5,11 A 1,1 0 1 1 5,11.01 M 11,11 A 1,1 0 1 1 11,11.01"
                                          Fill="{DynamicResource Brush.Accent.Base}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Simulate Random Pick (RNG)" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding SimulatorViewModel.RngRollFeedbackText}" Foreground="{DynamicResource Brush.Accent.Base}" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: Candidate Animations List Card -->
                    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header: Title & Filter Mode Selector -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SimulatorViewModel.CandidatesHeader}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Height="22" Width="140" FontSize="10" Style="{StaticResource ModernComboBoxStyle}"
                                          SelectedIndex="{Binding SimulatorViewModel.CandidateModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="🎯 Filtered by L/M" Tag="Filtered" IsSelected="True"/>
                                    <ComboBoxItem Content="📦 All Animations" Tag="All"/>
                                </ComboBox>
                            </Grid>

                            <!-- Search Filter Bar -->
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Height="24" FontSize="11" VerticalContentAlignment="Center"
                                         Text="{Binding SimulatorViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="🔍 Search animations..."/>
                            </Grid>

                            <!-- Animation Candidates ListBox -->
                            <ListBox Grid.Row="2" Style="{StaticResource ModernListBoxStyle}"
                                     ItemsSource="{Binding SimulatorViewModel.Candidates}"
                                     SelectedItem="{Binding SimulatorViewModel.SelectedCandidate, Mode=TwoWay}"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,2"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="{DynamicResource Brush.Surface.Control}"
                                                            BorderBrush="{DynamicResource Brush.Border.Separator}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="10,8"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Surface.Hover}"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Surface.Active}"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- ROW 0: Name & Probability Pill -->
                                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🎬" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProbabilitySummary}" Foreground="{DynamicResource Brush.Accent.Base}" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <!-- ROW 1: Metadata Badges -->
                                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0" ToolTip="Scheduled Level and Mood range">
                                                    <TextBlock Text="{Binding LevelMoodSummary}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0" ToolTip="Frames and FPS">
                                                    <TextBlock Text="{Binding FrameSummary}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Visibility="{Binding HasActiveFrames, Converter={StaticResource BoolToVis}}"
                                                        Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="3" Padding="5,1" ToolTip="Active trigger cycle frames">
                                                    <TextBlock Text="{Binding CycleSummary}" Foreground="{DynamicResource Brush.Accent.Base}" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                            </WrapPanel>

                                            <!-- ROW 2: Sleek Probability Progress Bar -->
                                            <Border Grid.Row="2" Height="4" Background="{DynamicResource Brush.Surface.Base}" CornerRadius="2" ClipToBounds="True">
                                                <ProgressBar Value="{Binding ProbabilityPercent}" Minimum="0" Maximum="100" Height="4" Foreground="{DynamicResource Brush.Accent.Base}" Background="Transparent" BorderThickness="0"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty State Overlay Banner -->
                            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Control}" BorderBrush="{DynamicResource Brush.Border.Separator}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4"
                                    Visibility="{Binding SimulatorViewModel.HasNoMatchingCandidates, Converter={StaticResource BoolToVis}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚠️ No Matching Animations" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="No animations match current Level/Mood, or no pack loaded." FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- CARD 3: Selected Animation Metadata & Canvas Action -->
                    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding SimulatorViewModel.CurrentAnimTitle}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📊 Locate in Matrix" ToolTip="Jump to this animation's cell in Matrix Studio" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" Margin="0,0,4,0" FontSize="9" Command="{Binding SimulatorViewModel.LocateSelectedInMatrixCommand}"/>
                                    <Button Content="🎨 Edit in Canvas" ToolTip="Open this animation's sprite frames in a workspace tab" Style="{StaticResource ModernButtonStyle}" Height="22" Padding="6,0" FontSize="9" Command="{Binding SimulatorViewModel.NavigateToSelectedTabCommand}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding SimulatorViewModel.CurrentAnimDetails}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,1,0,2"/>
                            <TextBlock Text="{Binding SimulatorViewModel.CycleDetails}" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 3. FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.StatusBar}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Border Background="{DynamicResource Brush.Surface.Active}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PackName}" FontWeight="SemiBold" FontSize="10" Foreground="{DynamicResource Brush.Accent.Base}"/>
                    </Border>
                    <TextBlock x:Name="TxtMatrixStats" Text="{Binding MatrixStatsText}" ToolTip="{Binding MatrixStatsText}" FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}" FontFamily="{DynamicResource Font.Code}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
