<Window x:Class="Hexprite.Views.SpriteSheetSlicerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        xmlns:behaviors="clr-namespace:Hexprite.Behaviors"
        Title="Sprite Sheet &amp; Atlas Slicer Studio"
        Width="1160" Height="780"
        MinWidth="960" MinHeight="640"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged"
        Background="{DynamicResource Brush.Surface.Base}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Primary}"
        WindowStyle="None"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        core:WindowChromeHelper.ForceRoundedCorners="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hexprite;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="Font.Primary">Segoe UI</FontFamily>
            <FontFamily x:Key="Font.Code">Consolas</FontFamily>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!-- Transparency Checkerboard Brush -->
            <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#181B24">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,16,16"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#0F1118">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,8,8"/>
                                    <RectangleGeometry Rect="8,8,8,8"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════
                 CUSTOM STUDIO TITLE BAR
                 ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False">
                        <TextBlock Text="🎞️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sprite Sheet &amp; Atlas Slicer Studio"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Brush.Surface.Active}" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PRO MULTI-TARGET SLICER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Keyboard & Mouse Shortcuts Cheat-sheet Helper -->
                        <Button x:Name="BtnShortcuts" Click="BtnShortcuts_Click" ToolTip="Keyboard &amp; Mouse Shortcuts (F1)" Height="24" Padding="8,0" Margin="0,0,10,0"
                                Style="{StaticResource ModernButtonStyle}" VerticalAlignment="Center">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="⌨️ KEYBOARD &amp; NAVIGATION SHORTCUTS" IsEnabled="False" FontWeight="Bold"/>
                                    <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                                    <MenuItem Header="Space" InputGestureText="Play / Pause Animation" IsEnabled="False"/>
                                    <MenuItem Header="Left / Right Arrow" InputGestureText="Prev / Next Frame" IsEnabled="False"/>
                                    <MenuItem Header="Home / End" InputGestureText="First / Last Frame" IsEnabled="False"/>
                                    <MenuItem Header="Ctrl + O" InputGestureText="Open New Sprite Sheet" IsEnabled="False"/>
                                    <MenuItem Header="Ctrl + / Ctrl -" InputGestureText="Zoom In / Zoom Out" IsEnabled="False"/>
                                    <MenuItem Header="Ctrl + 0" InputGestureText="Reset Zoom (1:1)" IsEnabled="False"/>
                                    <MenuItem Header="Alt + Arrow Keys" InputGestureText="Nudge Offset X/Y by 1px" IsEnabled="False"/>
                                    <MenuItem Header="Alt + Shift + Arrow" InputGestureText="Nudge Offset X/Y by 10px" IsEnabled="False"/>
                                    <MenuItem Header="Esc" InputGestureText="Close Studio" IsEnabled="False"/>
                                    <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                                    <MenuItem Header="🖱️ MOUSE &amp; CANVAS GESTURES" IsEnabled="False" FontWeight="Bold"/>
                                    <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                                    <MenuItem Header="Middle Drag / Space + Drag" InputGestureText="Pan Atlas Viewport" IsEnabled="False"/>
                                    <MenuItem Header="Ctrl + Scroll Wheel" InputGestureText="Zoom Atlas Viewport" IsEnabled="False"/>
                                    <MenuItem Header="Scroll in Preview Box" InputGestureText="Zoom Live Animation" IsEnabled="False"/>
                                    <MenuItem Header="Drag in Preview Box" InputGestureText="Pan Live Animation" IsEnabled="False"/>
                                    <MenuItem Header="Double-Click Preview Box" InputGestureText="Fit Animation to Window" IsEnabled="False"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <TextBlock Text="⌨️ Shortcuts" FontSize="10" FontWeight="SemiBold"/>
                        </Button>

                        <Button Click="CaptionMinimize_Click" ToolTip="Minimize" Width="44" Height="34"
                                Style="{StaticResource CaptionButtonStyle}">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Click="CaptionMaximize_Click" ToolTip="Maximize / Restore" Width="44" Height="34"
                                Style="{StaticResource CaptionButtonStyle}">
                            <TextBlock x:Name="TxtCaptionMaxGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Click="CaptionClose_Click" ToolTip="Close" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 MAIN STUDIO WORKSPACE
                 ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="385"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR: Segmented Inspector Panel -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Control}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="0,0,1,0" Padding="18,12,14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Segmented Navigation Chips -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" Content="🎛️ Geometry" GroupName="SidebarTabs" Style="{StaticResource ChipButtonStyle}" Margin="0,0,3,0"
                                         IsChecked="{Binding IsGeometryTabSelected, Mode=TwoWay}"/>
                            <RadioButton Grid.Column="1" Content="📐 Canvas" GroupName="SidebarTabs" Style="{StaticResource ChipButtonStyle}" Margin="3,0,3,0"
                                         IsChecked="{Binding IsCanvasTabSelected, Mode=TwoWay}"/>
                            <RadioButton Grid.Column="2" Content="✨ Dither" GroupName="SidebarTabs" Style="{StaticResource ChipButtonStyle}" Margin="3,0,0,0"
                                         IsChecked="{Binding IsDitherTabSelected, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Tab Content Views -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel>
                                <!-- ── TAB 0: GEOMETRY & SOURCE ────────────────────────── -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSidebarTabIndex}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Preset Profile Selector -->
                                    <TextBlock Text="TARGET HARDWARE PRESET" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CboPreset" Style="{StaticResource ModernComboBoxStyle}" Height="28" SelectedIndex="{Binding SelectedPresetIndex, Mode=TwoWay}" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Fit to Frame (Exact Slice Dimensions)"/>
                                        <ComboBoxItem Content="🐬 Flipper Zero (128×64 Animated)"/>
                                        <ComboBoxItem Content="📺 SSD1306 / SH1106 OLED (128×64)"/>
                                        <ComboBoxItem Content="📺 SSD1306 Slim OLED (128×32)"/>
                                        <ComboBoxItem Content="⚡ Pico / Arduino TFT (128×128)"/>
                                        <ComboBoxItem Content="📱 Nokia 5110 / PCD8544 (84×48)"/>
                                        <ComboBoxItem Content="💡 Micro:bit LED Matrix (5×5)"/>
                                        <ComboBoxItem Content="⚙️ Custom Target Canvas Size"/>
                                    </ComboBox>

                                    <!-- Source Image Card -->
                                    <TextBlock Text="SOURCE ATLAS / SPRITE SHEET" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,4"/>
                                    <Border Background="{DynamicResource Brush.Surface.Base}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="🔍 Auto Grid" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="6,0" Margin="0,0,3,0" Command="{Binding AutoDetectGridCommand}" ToolTip="Auto-detect optimal grid cells"/>
                                                <Button Grid.Column="1" Content="🧠 Auto Islands" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="6,0" Margin="3,0,0,0" Command="{Binding AutoDetectIslandsCommand}" ToolTip="Auto-detect sprite pixel islands (Alpha flood fill)"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SourceInfoText}" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="📂 Change..." Style="{StaticResource ModernButtonStyle}" Height="20" Padding="6,0" FontSize="9" Margin="6,0,0,0" Command="{Binding OpenImageCommand}" ToolTip="Open a different sprite sheet or GIF"
                                                        Visibility="{Binding HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding SourceDimensionsText, StringFormat='Dimensions: {0}'}" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Layout Strip Mode -->
                                    <TextBlock Text="SLICING STRATEGY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,4"/>
                                    <ComboBox Style="{StaticResource ModernComboBoxStyle}" Height="28" SelectedIndex="{Binding SelectedLayoutIndex, Mode=TwoWay}" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Horizontal Strip (Left ➔ Right)"/>
                                        <ComboBoxItem Content="Vertical Strip (Top ➔ Bottom)"/>
                                        <ComboBoxItem Content="Grid (Columns × Rows)"/>
                                        <ComboBoxItem Content="🧠 Auto-Detect Sprites (Alpha Islands)"/>
                                    </ComboBox>

                                    <!-- Frame Dimensions W x H -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Frame Width (px)" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBox Text="{Binding FrameWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}"
                                                     behaviors:NumericScrubBehavior.MinValue="1"
                                                     behaviors:NumericScrubBehavior.MaxValue="2048"
                                                     Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Frame Height (px)" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBox Text="{Binding FrameHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}"
                                                     behaviors:NumericScrubBehavior.MinValue="1"
                                                     behaviors:NumericScrubBehavior.MaxValue="2048"
                                                     Height="26"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Grid Cols x Rows x MaxFrames -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                            <TextBlock Text="Cols" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBox Text="{Binding Columns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}"
                                                     behaviors:NumericScrubBehavior.MinValue="1"
                                                     behaviors:NumericScrubBehavior.MaxValue="128"
                                                     Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                            <TextBlock Text="Rows" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBox Text="{Binding Rows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}"
                                                     behaviors:NumericScrubBehavior.MinValue="1"
                                                     behaviors:NumericScrubBehavior.MaxValue="128"
                                                     Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                            <TextBlock Text="Max Frames" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBox Text="{Binding MaxFrames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}"
                                                     behaviors:NumericScrubBehavior.MinValue="1"
                                                     behaviors:NumericScrubBehavior.MaxValue="512"
                                                     Height="26"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Offsets & Spacing (Margins) -->
                                    <TextBlock Text="MARGINS &amp; CELL SPACING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                            <TextBlock Text="Offset X" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBox Text="{Binding OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}"
                                                     behaviors:NumericScrubBehavior.MinValue="0"
                                                     behaviors:NumericScrubBehavior.MaxValue="2048"
                                                     Height="24"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                            <TextBlock Text="Offset Y" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBox Text="{Binding OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}"
                                                     behaviors:NumericScrubBehavior.MinValue="0"
                                                     behaviors:NumericScrubBehavior.MaxValue="2048"
                                                     Height="24"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="2,0,2,0">
                                            <TextBlock Text="Spacing X" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBox Text="{Binding SpacingX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}"
                                                     behaviors:NumericScrubBehavior.MinValue="0"
                                                     behaviors:NumericScrubBehavior.MaxValue="512"
                                                     Height="24"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="2,0,0,0">
                                            <TextBlock Text="Spacing Y" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBox Text="{Binding SpacingY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}"
                                                     behaviors:NumericScrubBehavior.MinValue="0"
                                                     behaviors:NumericScrubBehavior.MaxValue="512"
                                                     Height="24"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Skip Empty Frames -->
                                    <CheckBox Content="Skip All Empty Frames (Prune Blank)" FontSize="11" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="{Binding SkipEmptyFrames, Mode=TwoWay}" Margin="0,4,0,0" ToolTip="Filters out cells where all pixels are transparent"/>
                                </StackPanel>

                                <!-- ── TAB 1: CANVAS & SCALING ────────────────────────── -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSidebarTabIndex}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Canvas Mode -->
                                    <TextBlock Text="TARGET CANVAS DIMENSIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource ModernComboBoxStyle}" Height="28" SelectedIndex="{Binding SelectedCanvasModeIndex, Mode=TwoWay}" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Fit Frame to Slice (Exact 1:1 Size)"/>
                                        <ComboBoxItem Content="Fixed Canvas Size (Pad / Scale to Screen)"/>
                                    </ComboBox>

                                    <!-- Target Width & Height -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Canvas Width (px)" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBox Text="{Binding CanvasWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}"
                                                     behaviors:NumericScrubBehavior.MinValue="1"
                                                     behaviors:NumericScrubBehavior.MaxValue="1024"
                                                     Height="26"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Canvas Height (px)" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <TextBox Text="{Binding CanvasHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}"
                                                     behaviors:NumericScrubBehavior.MinValue="1"
                                                     behaviors:NumericScrubBehavior.MaxValue="1024"
                                                     Height="26"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Aspect Scaling Mode -->
                                    <TextBlock Text="SLICE SCALING / FIT BEHAVIOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,4"/>
                                    <ComboBox Style="{StaticResource ModernComboBoxStyle}" Height="28" SelectedIndex="{Binding SelectedScalingModeIndex, Mode=TwoWay}" Margin="0,0,0,8">
                                        <ComboBoxItem Content="1:1 Direct Crop (Pixel-Perfect Center/Align)"/>
                                        <ComboBoxItem Content="Fit (Uniform Scale, Preserve Aspect Ratio)"/>
                                        <ComboBoxItem Content="Fill (Uniform Scale, Crop Overflow)"/>
                                        <ComboBoxItem Content="Stretch (Non-Uniform, Fill Entire Canvas)"/>
                                    </ComboBox>

                                    <!-- Frame Alignment -->
                                    <TextBlock Text="FRAME ALIGNMENT ANCHOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,4"/>
                                    <ComboBox Style="{StaticResource ModernComboBoxStyle}" Height="28" SelectedIndex="{Binding SelectedAlignmentIndex, Mode=TwoWay}" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Center (Middle Anchor)"/>
                                        <ComboBoxItem Content="Top-Left (North-West)"/>
                                        <ComboBoxItem Content="Top-Right (North-East)"/>
                                        <ComboBoxItem Content="Bottom-Left (South-West)"/>
                                        <ComboBoxItem Content="Bottom-Right (South-East)"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- ── TAB 2: DITHER & IMAGE PROCESSING ───────────────── -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSidebarTabIndex}" Value="2">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- Dithering Algorithm -->
                                    <TextBlock Text="DITHERING ALGORITHM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource ModernComboBoxStyle}" Height="28" SelectedIndex="{Binding SelectedDitherIndex, Mode=TwoWay}" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Floyd-Steinberg (Error Diffusion)"/>
                                        <ComboBoxItem Content="Atkinson (Pixel Art Sharp)"/>
                                        <ComboBoxItem Content="Bayer 8×8 (Ordered Matrix)"/>
                                        <ComboBoxItem Content="Stucki (Smooth Gradient)"/>
                                        <ComboBoxItem Content="SierraLite (Fast Clean)"/>
                                        <ComboBoxItem Content="Binary (Hard Threshold)"/>
                                    </ComboBox>

                                    <!-- Brightness Threshold -->
                                    <Grid Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Brightness Threshold" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <Button Content="↺ 128" Command="{Binding ResetThresholdCommand}" Style="{StaticResource ModernButtonStyle}" Height="16" Padding="4,0" FontSize="8" Margin="6,0,0,0" ToolTip="Reset Threshold to default 128"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource Brush.Surface.Active}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding BrightnessThreshold}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="255" Value="{Binding BrightnessThreshold, Mode=TwoWay}" Height="18" Margin="0,0,0,8"/>

                                    <!-- Dither Intensity -->
                                    <Grid Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Dither Intensity" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <Button Content="↺ 100%" Command="{Binding ResetDitherAmountCommand}" Style="{StaticResource ModernButtonStyle}" Height="16" Padding="4,0" FontSize="8" Margin="6,0,0,0" ToolTip="Reset Dither Intensity to default 100%"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource Brush.Surface.Active}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding DitherAmount, StringFormat={}{0}%}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding DitherAmount, Mode=TwoWay}" Height="18" Margin="0,0,0,8"/>

                                    <!-- Contrast -->
                                    <Grid Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Contrast Pre-Processing" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <Button Content="↺ 0" Command="{Binding ResetContrastCommand}" Style="{StaticResource ModernButtonStyle}" Height="16" Padding="4,0" FontSize="8" Margin="6,0,0,0" ToolTip="Reset Contrast to 0"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource Brush.Surface.Active}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Contrast}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast, Mode=TwoWay}" Height="18" Margin="0,0,0,8"/>

                                    <!-- Brightness -->
                                    <Grid Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Brightness Pre-Processing" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            <Button Content="↺ 0" Command="{Binding ResetBrightnessCommand}" Style="{StaticResource ModernButtonStyle}" Height="16" Padding="4,0" FontSize="8" Margin="6,0,0,0" ToolTip="Reset Brightness to 0"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource Brush.Surface.Active}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Brightness}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness, Mode=TwoWay}" Height="18" Margin="0,0,0,10"/>

                                    <!-- Checkboxes -->
                                    <CheckBox Content="Invert Monochrome (Dark Theme)" FontSize="11" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="{Binding InvertColors, Mode=TwoWay}" Margin="0,0,0,6"/>
                                    <CheckBox Content="Serpentine Scanning (Reduce Banding)" FontSize="11" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="{Binding UseSerpentineScanning, Mode=TwoWay}" Margin="0,0,0,6"/>
                                    <CheckBox Content="Gamma Correction (sRGB Linearize)" FontSize="11" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="{Binding UseGammaCorrection, Mode=TwoWay}" Margin="0,0,0,6"/>
                                    <CheckBox Content="Auto-Trim Trailing Empty Frames" FontSize="11" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="{Binding AutoTrimEmptyFrames, Mode=TwoWay}" Margin="0,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- RIGHT MAIN WORKSPACE: Maximized Viewport & Sleek Resizable Studio Bar -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="180"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="185" MinHeight="120" MaxHeight="400"/>
                    </Grid.RowDefinitions>

                    <!-- TOP PANE: Source Atlas Viewport & Interactive Slice Overlays -->
                    <Grid Grid.Row="0" Margin="14,12,14,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Viewport Header & Action Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SOURCE ATLAS VIEWPORT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource Brush.Surface.Active}" CornerRadius="3" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SliceRects.Count, StringFormat='{}{0} Slices Detected'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                </Border>
                            </StackPanel>

                            <!-- Actions & Magnification Toolbar -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Open New & Discard Actions (Active Image) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                            Visibility="{Binding HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button Content="📂 Open New..." Command="{Binding OpenImageCommand}" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="8,0" Margin="0,0,4,0" ToolTip="Open a different sprite sheet or GIF (Ctrl+O) • Discards current image"/>
                                    <Button Content="🗑️ Discard" Command="{Binding ClearSourceImageCommand}" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="6,0" ToolTip="Discard current sprite sheet and return to empty state"/>
                                </StackPanel>

                                <!-- Magnification Toolbar -->
                                <Border Background="{DynamicResource Brush.Surface.Base}" CornerRadius="4" Padding="3"
                                        Visibility="{Binding HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="➖" Command="{Binding ZoomOutCommand}" Style="{StaticResource ModernButtonStyle}" Width="26" Height="24" Padding="0" Margin="0,0,2,0" FontSize="11" ToolTip="Zoom Out (Ctrl -)"/>
                                        <TextBlock Text="{Binding ZoomLevelLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Width="40" TextAlignment="Center"/>
                                        <Button Content="➕" Command="{Binding ZoomInCommand}" Style="{StaticResource ModernButtonStyle}" Width="26" Height="24" Padding="0" Margin="2,0,2,0" FontSize="11" ToolTip="Zoom In (Ctrl +)"/>
                                        <Button Content="1:1" Command="{Binding ResetZoomCommand}" Style="{StaticResource ModernButtonStyle}" Width="28" Height="24" Padding="0" Margin="2,0,2,0" FontSize="10" ToolTip="Reset Zoom (Ctrl 0)"/>
                                        <Button Content="Fit" Command="{Binding ZoomToFitCommand}" Style="{StaticResource ModernButtonStyle}" Width="28" Height="24" Padding="0" FontSize="10" ToolTip="Fit to Viewport"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Blueprint Canvas Viewport -->
                        <Border Grid.Row="1" Background="{StaticResource CheckerboardBrush}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <!-- Empty State Placeholder (when no image loaded) -->
                                <Border Visibility="{Binding HasNoSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Panel.ZIndex="10"
                                        BorderBrush="#252A38" BorderThickness="2" CornerRadius="8" Margin="16"
                                        Background="#0D0F14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Drag &amp; Drop Sprite Sheet, Strip, or GIF here" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="PNG • BMP • GIF • JPEG • XBM formats supported" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                        <Button Content="📂 Browse Image / GIF..." Command="{Binding OpenImageCommand}" Style="{StaticResource AccentButtonStyle}" Height="30" Padding="16,0" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Drag & Drop Visual Overlay Indicator -->
                                <Border x:Name="DragOverlay" Visibility="Collapsed" Panel.ZIndex="30"
                                        Background="#E00D0F14" BorderBrush="{DynamicResource Brush.Accent.Base}"
                                        BorderThickness="2" CornerRadius="8" Margin="12" IsHitTestVisible="False">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📥" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Drop Sprite Sheet or GIF to Replace" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Accent.Base}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="PNG • BMP • GIF • JPEG • XBM" FontSize="10"
                                                   Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Active Canvas Viewport with Panning Support -->
                                <ScrollViewer x:Name="AtlasScrollViewer"
                                              Visibility="{Binding HasSourceImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                                              MouseDown="AtlasScrollViewer_MouseDown"
                                              MouseMove="AtlasScrollViewer_MouseMove"
                                              MouseUp="AtlasScrollViewer_MouseUp"
                                              LostMouseCapture="AtlasScrollViewer_LostMouseCapture"
                                              Cursor="Arrow"
                                              Focusable="False">
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                        <Grid.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                                        </Grid.LayoutTransform>

                                        <Image x:Name="ImgSourceSheet" Source="{Binding SourceImage}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="None"/>

                                        <!-- Interactive Slice Cut Overlays -->
                                        <ItemsControl ItemsSource="{Binding SliceOverlays}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="{Binding SourceImage.PixelWidth}" Height="{Binding SourceImage.PixelHeight}"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectSliceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Index}"
                                                            Width="{Binding Width}" Height="{Binding Height}"
                                                            Padding="0" Margin="0" Cursor="Hand">
                                                        <Button.ToolTip>
                                                            <ToolTip>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding IndexText, StringFormat='Slice #{0}'}" FontWeight="Bold"/>
                                                                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}">
                                                                        <Run Text="Dimensions: "/><Run Text="{Binding Width, Mode=OneWay}"/><Run Text="×"/><Run Text="{Binding Height, Mode=OneWay}"/><Run Text=" px"/>
                                                                    </TextBlock>
                                                                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}">
                                                                        <Run Text="Position: X: "/><Run Text="{Binding X, Mode=OneWay}"/><Run Text=", Y: "/><Run Text="{Binding Y, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <TextBlock Text="Click to preview • Right-click for options" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,0"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Jump to Frame" Command="{Binding DataContext.SelectSliceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Index}"/>
                                                                <MenuItem Header="Copy Frame as Image" Command="{Binding DataContext.CopyFrameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Index}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="SliceBorder"
                                                                        BorderThickness="1"
                                                                        BorderBrush="#5500E5FF"
                                                                        Background="#1000E5FF">
                                                                    <Grid>
                                                                        <Border Background="#CC000000" CornerRadius="2" Padding="3,1" Margin="2,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                                            <TextBlock Text="{Binding IndexText, StringFormat='#{0}'}"
                                                                                       FontSize="8" FontWeight="Bold"
                                                                                       Foreground="#FFFFFFFF"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="SliceBorder" Property="BorderBrush" Value="#CC00E5FF"/>
                                                                        <Setter TargetName="SliceBorder" Property="Background" Value="#3000E5FF"/>
                                                                        <Setter TargetName="SliceBorder" Property="BorderThickness" Value="2"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter TargetName="SliceBorder" Property="BorderBrush" Value="#FFFF9900"/>
                                                                        <Setter TargetName="SliceBorder" Property="Background" Value="#40FF9900"/>
                                                                        <Setter TargetName="SliceBorder" Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Resizable GridSplitter between Viewport and Studio Bar -->
                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Background="Transparent" Cursor="SizeNS" ShowsPreview="False" Margin="0"/>

                    <!-- BOTTOM DOCKED PANE: Streamlined Studio Bar with Unified Live Preview -->
                    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Control}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="0,1,0,0" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="600"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. Unified Live Preview Box (Color / 1-Bit Dithered) with Centered Pan & Zoom -->
                            <Grid Grid.Column="0" Margin="0,0,6,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Mode Selector Header (Segmented Chips + Zoom Badge) -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Content="⚡ 1-Bit" GroupName="PreviewModeChips"
                                                 IsChecked="{Binding IsLcdPreviewMode, Mode=TwoWay}"
                                                 Style="{StaticResource ChipButtonStyle}" Height="22" Margin="0,0,2,0"
                                                 ToolTip="1-Bit Monochrome Dithered Preview"/>
                                    <RadioButton Grid.Column="1" Content="🎨 Color" GroupName="PreviewModeChips"
                                                 IsChecked="{Binding IsColorPreviewMode, Mode=TwoWay}"
                                                 Style="{StaticResource ChipButtonStyle}" Height="22" Margin="2,0,4,0"
                                                 ToolTip="Raw Color Sprite Preview"/>
                                    <Button Grid.Column="2" Content="{Binding PreviewZoomLabel}" Command="{Binding CyclePreviewZoomCommand}"
                                            Style="{StaticResource ModernButtonStyle}" Height="22" Padding="8,0" FontSize="9" FontWeight="Bold"
                                            ToolTip="Click to cycle zoom (Fit, 1x, 2x, 3x, 4x, 6x, 8x) • Scroll wheel to zoom • Drag to pan • Double-click to fit"/>
                                </Grid>

                                <!-- Frame Screen Box with Pan, Centered Zoom & Resizable bounds -->
                                <Border Grid.Row="1" Background="{StaticResource CheckerboardBrush}" BorderBrush="{DynamicResource Brush.Border.Base}"
                                        BorderThickness="1" CornerRadius="6" MinHeight="110" Padding="0"
                                        ClipToBounds="True"
                                        Cursor="Hand"
                                        PreviewMouseWheel="PreviewBox_PreviewMouseWheel"
                                        MouseDown="PreviewBox_MouseDown"
                                        MouseMove="PreviewBox_MouseMove"
                                        MouseUp="PreviewBox_MouseUp"
                                        LostMouseCapture="PreviewBox_LostMouseCapture">
                                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <!-- Fit to Container Mode -->
                                        <Grid Visibility="{Binding IsPreviewZoomFit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6">
                                            <!-- 1-Bit Dithered Monochrome Preview -->
                                            <Image x:Name="ImgLcdScreenFit" Source="{Binding LcdBitmap}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform"
                                                   Visibility="{Binding IsLcdPreviewActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Raw Color Preview with Onion Skinning -->
                                            <Grid Visibility="{Binding IsColorPreviewActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image Source="{Binding ColorPreviewBitmap}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform"/>
                                                <Image Source="{Binding OnionSkinPrevBitmap}" Opacity="{Binding OnionSkinOpacity}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" IsHitTestVisible="False"/>
                                                <Image Source="{Binding OnionSkinNextBitmap}" Opacity="{Binding OnionSkinOpacity}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" IsHitTestVisible="False"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Pixel-Scaled & Panned Mode (1x..8x centered scaling + translation) -->
                                        <Grid Visibility="{Binding IsPreviewZoomFixed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="{Binding PreviewZoomScale}" ScaleY="{Binding PreviewZoomScale}"/>
                                                    <TranslateTransform X="{Binding PreviewPanX}" Y="{Binding PreviewPanY}"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>

                                            <!-- 1-Bit Dithered Monochrome Preview -->
                                            <Image x:Name="ImgLcdScreenFixed" Source="{Binding LcdBitmap}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="None"
                                                   Visibility="{Binding IsLcdPreviewActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <!-- Raw Color Preview with Onion Skinning -->
                                            <Grid Visibility="{Binding IsColorPreviewActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Image Source="{Binding ColorPreviewBitmap}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="None"/>
                                                <Image Source="{Binding OnionSkinPrevBitmap}" Opacity="{Binding OnionSkinOpacity}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="None" IsHitTestVisible="False"/>
                                                <Image Source="{Binding OnionSkinNextBitmap}" Opacity="{Binding OnionSkinOpacity}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="None" IsHitTestVisible="False"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Vertical GridSplitter for Resizing Preview Pane -->
                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False" Margin="0"/>

                            <!-- 2. Playback Transport & Studio Controls -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                <!-- Timeline Header & Counter Badge -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="LIVE ANIMATION TIMELINE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                                        <!-- Display Palette Dropdown (When in 1-Bit mode) -->
                                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" Height="22" FontSize="10" SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}" MinWidth="110" Margin="10,0,0,0" ToolTip="Monochrome Display Palette"
                                                  Visibility="{Binding IsLcdPreviewActive, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center">
                                            <ComboBoxItem Content="🌙 Dark Mono"/>
                                            <ComboBoxItem Content="☀️ Light Mono"/>
                                            <ComboBoxItem Content="🐬 Flipper LCD"/>
                                            <ComboBoxItem Content="⚡ Matrix Green"/>
                                            <ComboBoxItem Content="📺 Amber CRT"/>
                                            <ComboBoxItem Content="🔵 OLED Blue"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Active}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FrameCounterText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                    </Border>
                                </Grid>

                                <!-- Frame Scrubber Slider -->
                                <Slider Minimum="0" Maximum="{Binding MaxFrameIndex}" Value="{Binding CurrentFrameIndex, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" Height="18" Margin="0,0,0,8"/>

                                <!-- Transport Controls & Loop Mode -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Transport Buttons (Unclipped, Centered Icons) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="⏮" Command="{Binding FirstFrameCommand}" Style="{StaticResource ModernButtonStyle}" Width="30" Height="28" Padding="0" Margin="0,0,3,0" FontSize="12" ToolTip="Jump to First Frame (Home)"/>
                                        <Button Content="◀" Command="{Binding PrevFrameCommand}" Style="{StaticResource ModernButtonStyle}" Width="30" Height="28" Padding="0" Margin="0,0,3,0" FontSize="12" ToolTip="Previous Frame (Left Arrow)"/>
                                        <Button Content="{Binding PlayPauseButtonText}" Command="{Binding TogglePlayPauseCommand}" Style="{StaticResource AccentButtonStyle}" Height="28" Padding="14,0" Margin="0,0,3,0" FontWeight="Bold" ToolTip="Play / Pause (Space)"/>
                                        <Button Content="▶" Command="{Binding NextFrameCommand}" Style="{StaticResource ModernButtonStyle}" Width="30" Height="28" Padding="0" Margin="0,0,3,0" FontSize="12" ToolTip="Next Frame (Right Arrow)"/>
                                        <Button Content="⏭" Command="{Binding LastFrameCommand}" Style="{StaticResource ModernButtonStyle}" Width="30" Height="28" Padding="0" Margin="0,0,3,0" FontSize="12" ToolTip="Jump to Last Frame (End)"/>
                                        <ToggleButton Content="🧅" IsChecked="{Binding OnionSkinEnabled, Mode=TwoWay}" Style="{StaticResource ModernToggleButtonStyle}" Width="30" Height="28" Padding="0" Margin="0,0,8,0" FontSize="13" ToolTip="Toggle Onion Skinning (Ghost Frames)"/>
                                    </StackPanel>

                                    <!-- Loop Mode Selector -->
                                    <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" Height="28" FontSize="11" SelectedIndex="{Binding SelectedLoopModeIndex, Mode=TwoWay}" MinWidth="140" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="🔁 Continuous Loop"/>
                                        <ComboBoxItem Content="🔀 Ping-Pong (Bounce)"/>
                                        <ComboBoxItem Content="▶️ Play Once &amp; Stop"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Playback Speed Slider & Quick Presets -->
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Playback Speed" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <TextBlock Text="{Binding FpsLabel}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="1" Maximum="60" Value="{Binding Fps, Mode=TwoWay}" Height="18" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="6" Command="{Binding SetFpsCommand}" CommandParameter="6" Style="{StaticResource ModernButtonStyle}" Width="26" Height="22" Padding="0" Margin="0,0,3,0" ToolTip="6 FPS"/>
                                        <Button Content="12" Command="{Binding SetFpsCommand}" CommandParameter="12" Style="{StaticResource ModernButtonStyle}" Width="26" Height="22" Padding="0" Margin="0,0,3,0" ToolTip="12 FPS"/>
                                        <Button Content="24" Command="{Binding SetFpsCommand}" CommandParameter="24" Style="{StaticResource ModernButtonStyle}" Width="26" Height="22" Padding="0" Margin="0,0,3,0" ToolTip="24 FPS"/>
                                        <Button Content="60" Command="{Binding SetFpsCommand}" CommandParameter="60" Style="{StaticResource ModernButtonStyle}" Width="26" Height="22" Padding="0" ToolTip="60 FPS"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════
                 FOOTER ACTION BAR
                 ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.MenuBar}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="0,1,0,0" Padding="18,10,14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Export Dropdown, Quick Copy C & Live Metadata Summary -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,0"
                                Click="BtnExportMenu_Click" Tag="{Binding}" ToolTip="Export sliced frames to various image and animation formats">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="🎞️ Animated GIF (.gif)..." Command="{Binding PlacementTarget.Tag.ExportGifCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="GIF" ToolTip="Export animated GIF file"/>
                                    <MenuItem Header="🖼️ PNG Sequence (.png)..." Command="{Binding PlacementTarget.Tag.ExportPngSequenceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="PNG" ToolTip="Export frame-by-frame PNG sequence folder"/>
                                    <MenuItem Header="📦 Sliced Sprite Sheet (.png)..." Command="{Binding PlacementTarget.Tag.ExportSpriteSheetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Atlas" ToolTip="Export stitched sprite sheet atlas image"/>
                                    <MenuItem Header="📄 JSON Metadata (.json)..." Command="{Binding PlacementTarget.Tag.ExportJsonMetadataCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="JSON" ToolTip="Export Aseprite/TexturePacker-compatible JSON metadata"/>
                                    <MenuItem Header="🐬 Flipper Zero Animation Folder..." Command="{Binding PlacementTarget.Tag.ExportFlipperCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Flipper" ToolTip="Export Flipper Zero animation folder"/>
                                    <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                                    <MenuItem Header="📋 Copy C/C++ Byte Array" Command="{Binding PlacementTarget.Tag.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Clipboard" ToolTip="Generate and copy C/C++ byte array to clipboard"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <TextBlock Text="💾 Export ▾" FontWeight="SemiBold"/>
                        </Button>

                        <Button Content="📋 Copy C" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,0" Margin="0,0,8,0" Command="{Binding CopyCodeCommand}" ToolTip="Generate and copy C/C++ byte array to clipboard"/>

                        <Border Background="{DynamicResource Brush.Surface.Control}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ExportSummaryText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        </Border>
                    </StackPanel>

                    <!-- Primary Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Close" Style="{StaticResource ModernButtonStyle}" Width="75" Height="28" Padding="12,0" Margin="0,0,8,0" Click="BtnClose_Click"/>
                        <Button Content="📑 Open All Tabs" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="12,0" Margin="0,0,8,0" Command="{Binding OpenAsSeparateTabsCommand}" ToolTip="Opens each sliced frame into its own independent document tab"/>
                        <Button Content="🎨 Open in Canvas" Style="{StaticResource AccentButtonStyle}" Height="28" Padding="14,0" FontWeight="Bold" Command="{Binding OpenInCanvasCommand}" ToolTip="Opens sliced animation in Hexprite canvas workspace"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
