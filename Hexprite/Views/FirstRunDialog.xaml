<Window x:Class="Hexprite.Views.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        xmlns:converters="clr-namespace:Hexprite.Converters"
        Title="Welcome to Hexprite"
        Width="640"
        Height="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        core:WindowChromeHelper.ForceRoundedCorners="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:ThemeAwareLogoConverter x:Key="ThemeAwareLogoConverter" />
    </Window.Resources>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Border.RenderTransform>
            <TranslateTransform Y="20" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <ExponentialEase EasingMode="EaseOut" Exponent="4" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionClose_Click" ToolTip="Close" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image Width="200"
                       Height="48"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Source>
                        <Binding Path="CurrentThemeName" FallbackValue="pack://application:,,,/Assets/Logo.png">
                            <Binding.Converter>
                                <converters:ThemeAwareLogoConverter />
                            </Binding.Converter>
                        </Binding>
                    </Image.Source>
                </Image>

                <TextBlock Grid.Row="1"
                           Text="Welcome! Before you start creating, let's configure a few basics."
                           TextWrapping="Wrap"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,0,0,32" />

                <TextBlock Grid.Row="2" Text="CHOOSE YOUR THEME" Style="{StaticResource HeaderStyle}" HorizontalAlignment="Center" Margin="0,0,0,12" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button Content="Dim" Command="{Binding SwitchThemeCommand}" CommandParameter="Dim" Width="100" Height="40" Margin="0,0,12,0" Style="{StaticResource ModernButtonStyle}" />
                    <Button Content="Light" Command="{Binding SwitchThemeCommand}" CommandParameter="Light" Width="100" Height="40" Margin="0,0,12,0" Style="{StaticResource ModernButtonStyle}" />
                    <Button Content="Dark" Command="{Binding SwitchThemeCommand}" CommandParameter="Dark" Width="100" Height="40" Margin="0,0,12,0" Style="{StaticResource ModernButtonStyle}" />
                    <Button Content="Flipper" Command="{Binding SwitchThemeCommand}" CommandParameter="Flipper" Width="100" Height="40" Style="{StaticResource ModernButtonStyle}" />
                </StackPanel>
            </Grid>
            
            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Separator}" BorderThickness="0,1,0,0" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Privacy Settings..." Command="{Binding OpenPrivacySettingsCommand}" Style="{StaticResource ModernButtonStyle}" Padding="12,6" />
                    
                    <Button Grid.Column="2" Content="Get Started" Style="{StaticResource AccentButtonStyle}" Padding="24,8" FontSize="14" Click="GetStarted_Click" IsDefault="True" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
