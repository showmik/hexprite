<Window x:Class="Hexprite.Views.ImportBitmapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        Title="Import Bitmap"
        Width="860" Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        core:WindowChromeHelper.ForceRoundedCorners="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               IsHitTestVisible="False" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionClose_Click"
                                ToolTip="Close"
                                Width="46"
                                Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,24,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Settings -->
                    <ColumnDefinition Width="*" />    <!-- Preview -->
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" Width="416" Margin="0,0,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Width="400">
                        <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Header -->
                        <RowDefinition Height="Auto" />  <!-- Source file -->
                        <RowDefinition Height="Auto" />  <!-- Preset Profile -->
                        <RowDefinition Height="Auto" />  <!-- Dithering -->
                        <RowDefinition Height="Auto" />  <!-- Scaling -->
                        <RowDefinition Height="Auto" />  <!-- Threshold -->
                        <RowDefinition Height="Auto" />  <!-- Max size -->
                        <RowDefinition Height="Auto" />  <!-- Advanced Settings Expander -->
                        <RowDefinition Height="*" />     <!-- Spacer -->
                        <RowDefinition Height="Auto" />  <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="IMPORT BITMAP SETTINGS"
                               Style="{StaticResource HeaderStyle}"
                               FontSize="14"
                               Margin="0,0,0,4" />

                    <TextBlock Grid.Row="1"
                               x:Name="TxtSourceFile"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Margin="0,0,0,18"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Import Profile"
                                   Width="120"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontWeight="SemiBold" />
                        <ComboBox x:Name="PresetCombo"
                                  Width="220"
                                  Height="28"
                                  Style="{StaticResource ModernComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Dithering"
                                   Width="120"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <ComboBox x:Name="DitherCombo"
                                  Width="220"
                                  Height="28"
                                  Style="{StaticResource ModernComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Scaling quality"
                                   Width="120"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <ComboBox x:Name="ScalingCombo"
                                  Width="220"
                                  Height="28"
                                  Style="{StaticResource ModernComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Threshold"
                                   Width="120"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <Slider x:Name="SldThreshold"
                                Width="140"
                                Minimum="0"
                                Maximum="255"
                                SmallChange="1"
                                LargeChange="10"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                VerticalAlignment="Center"
                                ValueChanged="SldThreshold_ValueChanged"
                                Margin="0,0,8,0" />
                        <TextBox x:Name="TxtThreshold"
                                 Width="68"
                                 Height="28"
                                 Style="{StaticResource NumericTextBoxStyle}"
                                 PreviewTextInput="NumberOnly"
                                 TextChanged="TxtThreshold_TextChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Max size (px)"
                                   Width="120"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <Slider x:Name="SldMaxDimension"
                                Width="140"
                                Minimum="1"
                                SmallChange="1"
                                LargeChange="16"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                VerticalAlignment="Center"
                                ValueChanged="SldMaxDimension_ValueChanged"
                                Margin="0,0,8,0" />
                        <TextBox x:Name="TxtMaxDimension"
                                 Width="68"
                                 Height="28"
                                 Style="{StaticResource NumericTextBoxStyle}"
                                 PreviewTextInput="NumberOnly"
                                 TextChanged="TxtMaxDimension_TextChanged" />
                    </StackPanel>

                    <Expander Grid.Row="7" Header="Advanced Settings" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,8,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Alpha cutoff"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <Slider x:Name="SldAlphaThreshold"
                                        Width="140"
                                        Minimum="0"
                                        Maximum="255"
                                        SmallChange="1"
                                        LargeChange="10"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="SldAlphaThreshold_ValueChanged"
                                        Margin="0,0,8,0" />
                                <TextBox x:Name="TxtAlphaThreshold"
                                         Width="68"
                                         Height="28"
                                         Style="{StaticResource NumericTextBoxStyle}"
                                         PreviewTextInput="NumberOnly"
                                         TextChanged="TxtAlphaThreshold_TextChanged" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Brightness"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <Slider x:Name="SldBrightness"
                                        Width="140"
                                        Minimum="-100"
                                        Maximum="100"
                                        SmallChange="1"
                                        LargeChange="10"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="SldBrightness_ValueChanged"
                                        Margin="0,0,8,0" />
                                <TextBox x:Name="TxtBrightness"
                                         Width="68"
                                         Height="28"
                                         Style="{StaticResource NumericTextBoxStyle}"
                                         TextChanged="TxtBrightness_TextChanged" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Contrast"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <Slider x:Name="SldContrast"
                                        Width="140"
                                        Minimum="-100"
                                        Maximum="100"
                                        SmallChange="1"
                                        LargeChange="10"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="SldContrast_ValueChanged"
                                        Margin="0,0,8,0" />
                                <TextBox x:Name="TxtContrast"
                                         Width="68"
                                         Height="28"
                                         Style="{StaticResource NumericTextBoxStyle}"
                                         TextChanged="TxtContrast_TextChanged" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Dither amount %"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <Slider x:Name="SldDitherAmount"
                                        Width="140"
                                        Minimum="0"
                                        Maximum="100"
                                        SmallChange="1"
                                        LargeChange="10"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="1"
                                        VerticalAlignment="Center"
                                        ValueChanged="SldDitherAmount_ValueChanged"
                                        Margin="0,0,8,0" />
                                <TextBox x:Name="TxtDitherAmount"
                                         Width="68"
                                         Height="28"
                                         Style="{StaticResource NumericTextBoxStyle}"
                                         PreviewTextInput="NumberOnly"
                                         TextChanged="TxtDitherAmount_TextChanged" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <CheckBox x:Name="ChkSharpen"
                                          Content="Sharpen image before dithering"
                                          Foreground="{DynamicResource Brush.Text.Primary}"
                                          Checked="AnySettingChanged"
                                          Unchecked="AnySettingChanged"
                                          Margin="0,0,0,4" />
                                <CheckBox x:Name="ChkAdaptiveThreshold"
                                          Content="Adaptive thresholding (best for photos/shadows)"
                                          Foreground="{DynamicResource Brush.Text.Primary}"
                                          Checked="ChkAdaptiveThreshold_CheckedChanged"
                                          Unchecked="ChkAdaptiveThreshold_CheckedChanged"
                                          Margin="0,0,0,4" />
                                <CheckBox x:Name="ChkPreserveEdges"
                                          Content="Preserve sharp edges (best for text/logos)"
                                          Foreground="{DynamicResource Brush.Text.Primary}"
                                          Checked="AnySettingChanged"
                                          Unchecked="AnySettingChanged"
                                          Margin="0,0,0,8" />

                                <CheckBox x:Name="ChkInvert"
                                          Content="Invert brightness before dithering"
                                          Foreground="{DynamicResource Brush.Text.Primary}"
                                          Checked="AnySettingChanged"
                                          Unchecked="AnySettingChanged"
                                          Margin="0,0,0,4" />

                                <CheckBox x:Name="ChkSerpentine"
                                          Content="Serpentine scanning (reduces directional artifacts)"
                                          Foreground="{DynamicResource Brush.Text.Primary}"
                                          Checked="AnySettingChanged"
                                          Unchecked="AnySettingChanged"
                                          Margin="0,0,0,4" />

                                <CheckBox x:Name="ChkGammaCorrection"
                                          Content="Gamma-corrected grayscale (perceptually accurate)"
                                          Foreground="{DynamicResource Brush.Text.Primary}"
                                          Checked="AnySettingChanged"
                                          Unchecked="AnySettingChanged"
                                          Margin="0,0,0,8" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Reset to defaults"
                                Width="132"
                                MinHeight="30"
                                Margin="0,0,24,0"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="Reset_Click" />
                        <Button Content="Cancel"
                                Width="80"
                                MinHeight="30"
                                Margin="0,0,8,0"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="Cancel_Click" />
                        <Button x:Name="BtnImport"
                                Content="Import"
                                Width="80"
                                MinHeight="30"
                                Style="{StaticResource ModernButtonStyle}"
                                IsDefault="True"
                                Click="Import_Click" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>

                <Grid Grid.Column="1" Margin="24,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="PREVIEW"
                               Style="{StaticResource HeaderStyle}"
                               FontSize="14"
                               Margin="0,0,0,4" />
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource Brush.Surface.Border}"
                            BorderThickness="1"
                            Background="#1e1e1e"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Toolbar overlay -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Panel.ZIndex="10">
                                <Button Content="1:1" ToolTip="Actual Size" Width="30" Height="24" Click="ZoomActual_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,4,0" FontSize="11" />
                                <Button Content="Fit" ToolTip="Fit to Screen" Width="30" Height="24" Click="ZoomFit_Click" Style="{StaticResource ModernButtonStyle}" FontSize="11" />
                            </StackPanel>
                            <ScrollViewer x:Name="PreviewScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          PreviewMouseWheel="Preview_MouseWheel"
                                          PreviewMouseDown="Preview_MouseDown"
                                          PreviewMouseUp="Preview_MouseUp"
                                          PreviewMouseMove="Preview_MouseMove"
                                          Background="Transparent">
                                <Grid x:Name="PreviewContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.LayoutTransform>
                                        <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="1" ScaleY="1" />
                                    </Grid.LayoutTransform>
                                    <!-- Checkerboard background pattern -->
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <DrawingBrush Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
                                                <DrawingBrush.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="#333333">
                                                            <GeometryDrawing.Geometry>
                                                                <RectangleGeometry Rect="0,0,16,16"/>
                                                            </GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                        <GeometryDrawing Brush="#222222">
                                                            <GeometryDrawing.Geometry>
                                                                <GeometryGroup>
                                                                    <RectangleGeometry Rect="0,0,8,8"/>
                                                                    <RectangleGeometry Rect="8,8,8,8"/>
                                                                </GeometryGroup>
                                                            </GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                    </DrawingGroup>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Image x:Name="PreviewImage"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                            </ScrollViewer>
                            
                            <!-- Loading overlay -->
                            <Border x:Name="LoadingOverlay"
                                    Background="#80000000"
                                    Visibility="Collapsed">
                                <TextBlock Text="Processing..."
                                           Foreground="White"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>