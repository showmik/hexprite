<UserControl x:Class="Hexprite.Views.CanvasPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:Hexprite.Core"
             xmlns:behaviors="clr-namespace:Hexprite.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <x:Array x:Key="FloatingPasteModeOptions" Type="{x:Type core:FloatingPasteMode}">
            <core:FloatingPasteMode>Transparent</core:FloatingPasteMode>
            <core:FloatingPasteMode>Opaque</core:FloatingPasteMode>
        </x:Array>
        <Style x:Key="SymmetryHandleStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <!-- Large transparent hit area -->
                        <Grid Background="Transparent">
                            <Border Width="6" Height="6" Background="White" BorderBrush="Black" BorderThickness="1" SnapsToDevicePixels="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Context toolbar -->
        <Border Grid.Row="0"
                Style="{StaticResource PanelStyle}"
                Margin="0,0,0,8"
                Padding="8,4">
            <Grid MinHeight="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>



                <!-- Contextual Options (all share Column 2) -->

                <!-- 1. Brush options (Pencil only) -->
                <StackPanel Orientation="Horizontal"
                            Grid.Column="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTool}"
                                             Value="Pencil">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}"
                                             Value="Eraser">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}"
                                             Value="Dither">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}"
                                             Value="Line">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}"
                                             Value="Rectangle">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}"
                                             Value="Ellipse">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}"
                                             Value="FilledRectangle">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}"
                                             Value="FilledEllipse">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Brush Shape label -->
                    <TextBlock Text="SHAPE"
                               Style="{StaticResource HeaderStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <!-- Circle shape button -->
                    <RadioButton x:Name="RbBrushCircle" x:FieldModifier="public"
                                 GroupName="BrushShape"
                                 IsChecked="True"
                                 Checked="BrushShape_Checked"
                                 Tag="Circle"
                                 ToolTip="Circle Brush"
                                 Width="24" Height="24"
                                 Margin="0,0,2,0"
                                 Style="{StaticResource VerticalToolButtonStyle}">
                        <Ellipse Width="10" Height="10"
                                 Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>

                    <!-- Square shape button -->
                    <RadioButton x:Name="RbBrushSquare" x:FieldModifier="public"
                                 GroupName="BrushShape"
                                 Checked="BrushShape_Checked"
                                 Tag="Square"
                                 ToolTip="Square Brush"
                                 Width="24" Height="24"
                                 Margin="0,0,2,0"
                                 Style="{StaticResource VerticalToolButtonStyle}">
                        <Rectangle Width="10" Height="10"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>

                    <!-- Line shape button -->
                    <RadioButton x:Name="RbBrushLine" x:FieldModifier="public"
                                 GroupName="BrushShape"
                                 Checked="BrushShape_Checked"
                                 Tag="Line"
                                 ToolTip="Line Brush"
                                 Width="24" Height="24"
                                 Margin="0,0,0,0"
                                 Style="{StaticResource VerticalToolButtonStyle}">
                        <Rectangle Width="14" Height="2"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </RadioButton>

                    <!-- Separator -->
                    <Rectangle Width="2"
                               Style="{StaticResource SeparatorRectangleStyle}"
                               Margin="12,4,12,4" />

                    <!-- Brush Size label -->
                    <TextBlock Text="SIZE"
                               Style="{StaticResource HeaderStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Button Width="22"
                            Height="22"
                            Margin="0,0,6,0"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="0"
                            Click="BtnBrushDown_Click">
                        <Path Style="{StaticResource StrokedToolIconStyle}"
                              Data="M22.5 13.5H1.5C0.671578 13.5 0 12.8284 0 12C0 11.1716 0.671578 10.5 1.5 10.5H22.5C23.3284 10.5 24 11.1716 24 12C24 12.8284 23.3284 13.5 22.5 13.5Z" />
                    </Button>
                    <Slider x:Name="BrushSizeSlider" x:FieldModifier="public"
                            Width="80"
                            Minimum="1"
                            Maximum="64"
                            Value="{Binding BrushSize}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            ToolTip="Pencil brush size ([ / ] or Ctrl+Scroll)" />
                    <Button Width="22"
                            Height="22"
                            Margin="0,0,8,0"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="0"
                            Click="BtnBrushUp_Click">
                        <Path Style="{StaticResource StrokedToolIconStyle}"
                              Data="M22.5 10.5H13.5V1.5C13.5 0.671578 12.8284 0 12 0C11.1716 0 10.5 0.671578 10.5 1.5V10.5H1.5C0.671578 10.5 0 11.1716 0 12C0 12.8284 0.671578 13.5 1.5 13.5H10.5V22.5C10.5 23.3284 11.1716 24 12 24C12.8284 24 13.5 23.3284 13.5 22.5V13.5H22.5C23.3284 13.5 24 12.8284 24 12C24 11.1716 23.3284 10.5 22.5 10.5Z" />
                    </Button>
                    <TextBox x:Name="BrushSizeTextBox" x:FieldModifier="public"
                             Text="{Binding BrushSize, UpdateSourceTrigger=LostFocus}"
                             Width="32"
                             VerticalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Accent.Base}"
                             Style="{StaticResource NumericTextBoxStyle}"
                             behaviors:NumericScrubBehavior.MinValue="1"
                             behaviors:NumericScrubBehavior.MaxValue="64"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             LostFocus="BrushSizeTextBox_LostFocus"
                             ToolTip="Brush size (1-64)" />
                    <TextBlock Text="px"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="3,0,0,0"
                               FontSize="11" />

                    <CheckBox Content="Pixel-Perfect"
                              IsChecked="{Binding IsPixelPerfectEnabled}"
                              Foreground="{DynamicResource Brush.Text.Primary}"
                              VerticalAlignment="Center"
                              Margin="16,0,0,0"
                              ToolTip="Remove staircase corners while freehand drawing.">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTool}" Value="Pencil">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentTool}" Value="Eraser">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentTool}" Value="Dither">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <!-- Rotation controls (only for Square and Line) -->
                    <StackPanel x:Name="RotationPanel" x:FieldModifier="public"
                                Orientation="Horizontal"
                                Margin="8,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrushShape}" Value="Square">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BrushShape}" Value="Line">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Rectangle Width="2"
                                   Style="{StaticResource SeparatorRectangleStyle}"
                                   Margin="12,4,12,4" />

                        <TextBlock Text="ANGLE"
                                   Style="{StaticResource HeaderStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Slider x:Name="BrushAngleSlider" x:FieldModifier="public"
                                Width="70"
                                Minimum="0"
                                Maximum="359"
                                Value="{Binding BrushAngle}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ToolTip="Brush rotation angle (0-359°)" />
                        <TextBox x:Name="BrushAngleTextBox" x:FieldModifier="public"
                             Text="{Binding BrushAngle, UpdateSourceTrigger=LostFocus}"
                             Width="40"
                             VerticalAlignment="Center"
                             Margin="4,0,0,0"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Accent.Base}"
                             Style="{StaticResource NumericTextBoxStyle}"
                             behaviors:NumericScrubBehavior.MinValue="0"
                             behaviors:NumericScrubBehavior.MaxValue="359"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             LostFocus="BrushAngleTextBox_LostFocus"
                             ToolTip="Brush angle (0-359°)" />
                        <TextBlock Text="°"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"
                                   Margin="3,0,0,0"
                                   FontSize="12" />
                    </StackPanel>


                    <!-- Dither pattern selector (Dither tool only) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="8,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTool}"
                                                 Value="Dither">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Rectangle Width="2"
                                   Style="{StaticResource SeparatorRectangleStyle}"
                                   Margin="12,4,12,4" />

                        <TextBlock Text="PATTERN"
                                   Style="{StaticResource HeaderStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <RadioButton x:Name="RbDitherCheckerboard" x:FieldModifier="public"
                                     GroupName="DitherPattern"
                                     IsChecked="True"
                                     Checked="DitherPattern_Checked"
                                     Tag="Checkerboard"
                                     ToolTip="Checkerboard (50%)"
                                     Width="24" Height="24"
                                     Margin="0,0,2,0"
                                     Style="{StaticResource VerticalToolButtonStyle}">
                            <Grid Width="12" Height="12">
                                <Rectangle Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Rectangle Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="RbDitherLight" x:FieldModifier="public"
                                     GroupName="DitherPattern"
                                     Checked="DitherPattern_Checked"
                                     Tag="Light"
                                     ToolTip="Light (25%)"
                                     Width="24" Height="24"
                                     Margin="0,0,2,0"
                                     Style="{StaticResource VerticalToolButtonStyle}">
                            <Grid Width="12" Height="12">
                                <Ellipse Width="3" Height="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Ellipse Width="3" Height="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="RbDitherDense" x:FieldModifier="public"
                                     GroupName="DitherPattern"
                                     Checked="DitherPattern_Checked"
                                     Tag="Dense"
                                     ToolTip="Dense (75%)"
                                     Width="24" Height="24"
                                     Margin="0,0,2,0"
                                     Style="{StaticResource VerticalToolButtonStyle}">
                            <Grid Width="12" Height="12">
                                <Rectangle Width="12" Height="12"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Ellipse Width="3" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{DynamicResource Brush.Surface.Panel}" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="RbDitherDiagonal" x:FieldModifier="public"
                                     GroupName="DitherPattern"
                                     Checked="DitherPattern_Checked"
                                     Tag="DiagonalLines"
                                     ToolTip="Diagonal Lines"
                                     Width="24" Height="24"
                                     Margin="0,0,2,0"
                                     Style="{StaticResource VerticalToolButtonStyle}">
                            <Grid Width="12" Height="12">
                                <Line X1="0" Y1="12" X2="12" Y2="0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="2" />
                                <Line X1="0" Y1="6" X2="6" Y2="0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="2" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="RbDitherCrossHatch" x:FieldModifier="public"
                                     GroupName="DitherPattern"
                                     Checked="DitherPattern_Checked"
                                     Tag="CrossHatch"
                                     ToolTip="Cross-Hatch"
                                     Width="24" Height="24"
                                     Margin="0,0,2,0"
                                     Style="{StaticResource VerticalToolButtonStyle}">
                            <Grid Width="12" Height="12">
                                <Line X1="0" Y1="12" X2="12" Y2="0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5" />
                                <Line X1="0" Y1="0" X2="12" Y2="12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <!-- Shape tool hint -->
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTool}" Value="Line">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentTool}" Value="Rectangle">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentTool}" Value="Ellipse">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentTool}" Value="FilledRectangle">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentTool}" Value="FilledEllipse">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE9A6;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="Shift + Drag to constrain proportions or angle"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"
                                   FontStyle="Italic" />
                    </StackPanel>

                    <!-- Reset tool settings -->
                    <Rectangle Width="2" Style="{StaticResource SeparatorRectangleStyle}" Margin="16,4,12,4" />
                    
                    <Button Command="{Binding ResetBrushCommand}"
                            ToolTip="Reset tool settings"
                            Style="{StaticResource ModernButtonStyle}"
                            Width="24" Height="24"
                            Padding="0"
                            Margin="0,0,4,0">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   FontSize="12" />
                    </Button>

                </StackPanel>

                <!-- 3. Fill hint -->
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTool}" Value="Fill">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Contiguous toggle (Only visible in RGB mode) -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SpriteState.ColorMode}" Value="Monochrome">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <CheckBox Content="Contiguous"
                                  IsChecked="{Binding IsContiguousFillEnabled}"
                                  Foreground="{DynamicResource Brush.Text.Primary}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  ToolTip="Uncheck to fill all pixels of this color across the entire layer" />

                        <Rectangle Width="2" Style="{StaticResource SeparatorRectangleStyle}" Margin="0,4,12,4" />
                    </StackPanel>

                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Click to flood fill pixels" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" FontStyle="Italic" />


                </StackPanel>

                <!-- 4. Text Tool Controls -->
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTool}" Value="Text">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="FONT" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    
                    <ComboBox Width="160"
                              ItemsSource="{Binding AvailableFonts}"
                              SelectedItem="{Binding SelectedFont}"
                              Margin="0,0,4,0"
                              Style="{StaticResource ModernComboBoxStyle}"
                              VerticalAlignment="Center"
                              DropDownClosed="FontComboBox_DropDownClosed">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Text=" ✦" FontSize="9" Opacity="0.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Accent.Base}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBuiltIn}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Open custom fonts folder -->
                    <Button Width="24" Height="24" Padding="4" Margin="0,0,4,0"
                            ToolTip="Open custom fonts folder"
                            Style="{StaticResource CompactIconButtonStyle}"
                            VerticalAlignment="Center"
                            Click="OpenFontsFolder_Click">
                        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                              Fill="{DynamicResource Brush.Text.Muted}"
                              Stretch="Uniform" Width="12" Height="12" />
                    </Button>

                    <!-- Refresh fonts -->
                    <Button Width="24" Height="24" Padding="4" Margin="0,0,16,0"
                            ToolTip="Refresh font list"
                            Style="{StaticResource CompactIconButtonStyle}"
                            VerticalAlignment="Center"
                            Click="RefreshFonts_Click">
                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                              Fill="{DynamicResource Brush.Text.Muted}"
                              Stretch="Uniform" Width="12" Height="12" />
                    </Button>

                    <TextBlock Text="SCALE" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <Slider Width="60"
                            Minimum="1"
                            Maximum="10"
                            Value="{Binding PixelScale}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ToolTip="Pixel scale — nearest-neighbor multiplier (1-10×)"
                            Margin="0,0,8,0" />

                    <TextBox Text="{Binding PixelScale, UpdateSourceTrigger=PropertyChanged}"
                             Width="24"
                             VerticalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Accent.Base}"
                             Style="{StaticResource NumericTextBoxStyle}"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             ToolTip="Pixel scale (1-10×)" />
                    <TextBlock Text="x" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="2,0,8,0" FontSize="11" />

                    <Rectangle Width="1" Height="14" Fill="{DynamicResource Brush.Text.Muted}" Opacity="0.3" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <TextBlock Text="{Binding FontSize, StringFormat={}{0}px}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               ToolTip="Effective pixel height at current scale"
                               Margin="0,0,16,0" />

                    <TextBlock Text="SPACING" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <Slider Width="60"
                            Minimum="-5"
                            Maximum="20"
                            Value="{Binding LetterSpacing}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ToolTip="Letter spacing (-5 to 20)"
                            Margin="0,0,8,0" />

                    <TextBox Text="{Binding LetterSpacing, UpdateSourceTrigger=PropertyChanged}"
                             Width="32"
                             VerticalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Accent.Base}"
                             Style="{StaticResource NumericTextBoxStyle}"
                             behaviors:NumericScrubBehavior.MinValue="-5"
                             behaviors:NumericScrubBehavior.MaxValue="20"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             ToolTip="Letter spacing (-5 to 20)" />
                    <TextBlock Text="px" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="4,0,12,0" FontSize="11" />

                    <TextBlock Text="LEADING" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <Slider Width="60"
                            Minimum="-10"
                            Maximum="20"
                            Value="{Binding LineHeight}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ToolTip="Line height / leading (-10 to 20px)"
                            Margin="0,0,8,0" />

                    <TextBox Text="{Binding LineHeight, UpdateSourceTrigger=PropertyChanged}"
                             Width="32"
                             VerticalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             FontWeight="Bold"
                             Foreground="{DynamicResource Brush.Accent.Base}"
                             Style="{StaticResource NumericTextBoxStyle}"
                             behaviors:NumericScrubBehavior.MinValue="-10"
                             behaviors:NumericScrubBehavior.MaxValue="20"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             ToolTip="Line height / leading (-10 to 20px)" />
                    <TextBlock Text="px" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="4,0,12,0" FontSize="11" />

                    <!-- Text alignment buttons -->
                    <Button Width="24" Height="24" Padding="4" Margin="0,0,2,0" ToolTip="Align left"
                            Style="{StaticResource CompactIconButtonStyle}" VerticalAlignment="Center"
                            Click="TextAlignLeft_Click">
                        <Button.Resources>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{DynamicResource Brush.Text.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TextAlignment}" Value="Left">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Base}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                        <Path Data="M3,3H21V5H3V3M3,7H15V9H3V7M3,11H21V13H3V11M3,15H15V17H3V15M3,19H21V21H3V19Z"
                              Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="24" Height="24" Padding="4" Margin="0,0,2,0" ToolTip="Align center"
                            Style="{StaticResource CompactIconButtonStyle}" VerticalAlignment="Center"
                            Click="TextAlignCenter_Click">
                        <Button.Resources>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{DynamicResource Brush.Text.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TextAlignment}" Value="Center">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Base}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                        <Path Data="M3,3H21V5H3V3M7,7H17V9H7V7M3,11H21V13H3V11M7,15H17V17H7V15M3,19H21V21H3V19Z"
                              Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="24" Height="24" Padding="4" Margin="0,0,12,0" ToolTip="Align right"
                            Style="{StaticResource CompactIconButtonStyle}" VerticalAlignment="Center"
                            Click="TextAlignRight_Click">
                        <Button.Resources>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{DynamicResource Brush.Text.Muted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TextAlignment}" Value="Right">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent.Base}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                        <Path Data="M3,3H21V5H3V3M9,7H21V9H9V7M3,11H21V13H3V11M9,15H21V17H9V15M3,19H21V21H3V19Z"
                              Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Rectangle Width="2" Style="{StaticResource SeparatorRectangleStyle}" Margin="0,4,8,4" />

                    <!-- Hint: idle state -->
                    <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" FontStyle="Italic">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTextEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="&#xE104;" FontFamily="Segoe MDL2 Assets" BaselineAlignment="Center" />
                        <Run Text=" Click to create text" BaselineAlignment="Center" />
                    </TextBlock>

                    <!-- Hint: active typing state -->
                    <TextBlock Foreground="{DynamicResource Brush.Accent.Base}" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTextEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="&#xE104;" FontFamily="Segoe MDL2 Assets" BaselineAlignment="Center" />
                        <Run Text=" Typing — press Esc to commit" BaselineAlignment="Center" />
                    </TextBlock>
                </StackPanel>

                <!-- 5. Selection hints (Marquee, Lasso, MagicWand) -->
                <StackPanel Orientation="Horizontal"
                            Grid.Column="2">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTool}"
                                             Value="Marquee">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}"
                                             Value="Lasso">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}"
                                             Value="MagicWand">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Selection Info (shown when selection exists) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,12,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectionService.HasActiveSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBox Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"
                                 Width="32"
                                 VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.Accent.Base}"
                                 Style="{StaticResource NumericTextBoxStyle}"
                                 behaviors:NumericScrubBehavior.MinValue="1"
                                 behaviors:NumericScrubBehavior.MaxValue="10"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                 ToolTip="Preview Scale multiplier" />
                        <TextBlock Text="&#xE727;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource Brush.Accent.Base}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="14" />
                        <TextBlock Text="{Binding SelectionInfo}"
                                   Foreground="{DynamicResource Brush.Accent.Base}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <!-- Quick Actions -->
                        <Button Command="{Binding CutSelectionCommand}"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Margin="0,0,4,0"
                                ToolTip="Cut selection (Ctrl+X)">
                            <TextBlock Text="&#xE8B8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>
                        <Button Command="{Binding CopySelectionCommand}"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Margin="0,0,4,0"
                                ToolTip="Copy selection (Ctrl+C)">
                            <TextBlock Text="&#xE8C8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>
                        <Button Command="{Binding NewLayerFromSelectionCommand}"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Margin="0,0,4,0"
                                ToolTip="New layer from selection (Ctrl+Shift+J)">
                            <TextBlock Text="&#xE8B9;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>
                        <Button Command="{Binding DeleteSelectionCommand}"
                                Style="{StaticResource CompactIconButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="Delete selection (Del)">
                            <TextBlock Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" />
                        </Button>

                        <Rectangle Width="2"
                                   Style="{StaticResource SeparatorRectangleStyle}"
                                   Margin="0,4,12,4" />
                    </StackPanel>

                    <!-- Transform button (context-aware: enabled only when a selection exists) -->
                    <Button Command="{Binding BeginSelectionTransformCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Height="26"
                            Padding="8,0"
                            Margin="0,0,12,0"
                            ToolTip="Transform selection (Ctrl+T) — drag handles to scale">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE740;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="Transform"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="2"
                               Style="{StaticResource SeparatorRectangleStyle}"
                               Margin="0,4,12,4" />

                    <!-- Paste Mode (shown only when selection is floating) -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,12,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectionFloating}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Paste:"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="12" />

                        <ComboBox Width="105"
                                  Height="26"
                                  FontSize="12"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  ItemsSource="{Binding Source={StaticResource FloatingPasteModeOptions}}"
                                  SelectedItem="{Binding FloatingPasteMode}" />

                        <Rectangle Width="2"
                                   Style="{StaticResource SeparatorRectangleStyle}"
                                   Margin="12,4,12,4" />
                    </StackPanel>

                    <TextBlock Text="&#xE9A6;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="Del to erase • Esc to clear • Shift/Alt/Ctrl to combine"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               FontStyle="Italic" />
                </StackPanel>

                <!-- Global Symmetry controls (Right-aligned in Column 3) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTool}" Value="Marquee">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}" Value="Lasso">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}" Value="MagicWand">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}" Value="Move">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentTool}" Value="Text">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Rectangle Width="2" Style="{StaticResource SeparatorRectangleStyle}" Margin="12,4,8,4" />
                    <TextBlock Text="SYMMETRY" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ToggleButton IsChecked="{Binding IsSymmetryVerticalEnabled}"
                                  ToolTip="Vertical Symmetry"
                                  Width="26" Height="26"
                                  Margin="0,0,2,0" Padding="0"
                                  Style="{StaticResource ModernToggleButtonStyle}">
                        <Grid Width="14" Height="14">
                            <Line X1="7" Y1="0" X2="7" Y2="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeDashArray="2,2"/>
                            <Path Data="M5,3 V11 L1,7 Z M9,3 V11 L13,7 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsSymmetryHorizontalEnabled}"
                                  ToolTip="Horizontal Symmetry"
                                  Width="26" Height="26"
                                  Margin="0,0,8,0" Padding="0"
                                  Style="{StaticResource ModernToggleButtonStyle}">
                        <Grid Width="14" Height="14">
                            <Line X1="0" Y1="7" X2="14" Y2="7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.5" StrokeDashArray="2,2"/>
                            <Path Data="M3,5 H11 L7,1 Z M3,9 H11 L7,13 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </Grid>
                    </ToggleButton>
                    <Button Command="{Binding ResetSymmetryCommand}"
                            ToolTip="Reset symmetry center to canvas center"
                            Width="26" Height="26" Padding="0"
                            Style="{StaticResource ModernButtonStyle}">
                        <Grid Width="14" Height="14">
                            <Path Data="M7,0 V3 M7,11 V14 M0,7 H3 M11,7 H14 M4,4 H10 V10 H4 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"/>
                        </Grid>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Canvas -->
        <Border Grid.Row="1"
                Style="{StaticResource PanelStyle}"
                Padding="0"
                ClipToBounds="True">
            <ScrollViewer x:Name="MainScrollViewer" x:FieldModifier="public"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource Brush.Surface.Base}">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2000" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2000" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2000" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2000" />
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Row="1" Grid.Column="1"
                            Background="{DynamicResource Brush.Canvas.Base}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomLevel}"
                                            ScaleY="{Binding ZoomLevel}" />
                        </Border.LayoutTransform>

                        <Grid x:Name="PixelGridContainer" x:FieldModifier="public"
                              Width="{Binding CanvasDisplayWidth}"
                              Height="{Binding CanvasDisplayHeight}">

                        <!-- Pixel bitmap -->
                        <Image x:Name="CanvasImage" x:FieldModifier="public"
                               Source="{Binding CanvasBitmap}"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Stretch="Fill"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />

                        <!-- Grid lines overlay -->
                        <Rectangle IsHitTestVisible="False">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowGridLines}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                            <Rectangle.Fill>
                                <DrawingBrush Viewport="{Binding GridViewport}"
                                              ViewportUnits="Absolute"
                                              TileMode="Tile">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="{Binding GridViewport}" />
                                            </GeometryDrawing.Geometry>
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="{DynamicResource Brush.Canvas.Grid}"
                                                     Thickness="{Binding DynamicStrokeThickness}" />
                                            </GeometryDrawing.Pen>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Selection overlays -->
                        <Canvas ClipToBounds="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">

                            <!-- Solid backing stroke for contrast against both light/dark pixels -->
                            <Rectangle Stroke="{DynamicResource Brush.Surface.Base}"
                                       StrokeThickness="{Binding SelectionStrokeThickness}"
                                       Visibility="{Binding Visibility, ElementName=MarqueeOverlay}"
                                       Width="{Binding Width, ElementName=MarqueeOverlay}"
                                       Height="{Binding Height, ElementName=MarqueeOverlay}"
                                       Canvas.Left="{Binding (Canvas.Left), ElementName=MarqueeOverlay}"
                                       Canvas.Top="{Binding (Canvas.Top), ElementName=MarqueeOverlay}"
                                       RenderTransform="{Binding RenderTransform, ElementName=MarqueeOverlay}"
                                       IsHitTestVisible="False" />

                            <Rectangle x:Name="MarqueeOverlay" x:FieldModifier="public"
                                       Stroke="{DynamicResource Brush.Accent.PreviewBorder}"
                                       StrokeThickness="{Binding SelectionStrokeThickness}"
                                       StrokeDashArray="4,4"
                                       Visibility="Hidden"
                                       IsHitTestVisible="False" />

                            <!-- Solid backing stroke for ellipse -->
                            <Ellipse Stroke="{DynamicResource Brush.Surface.Base}"
                                     StrokeThickness="{Binding SelectionStrokeThickness}"
                                     Visibility="{Binding Visibility, ElementName=EllipseOverlay}"
                                     Width="{Binding Width, ElementName=EllipseOverlay}"
                                     Height="{Binding Height, ElementName=EllipseOverlay}"
                                     Canvas.Left="{Binding (Canvas.Left), ElementName=EllipseOverlay}"
                                     Canvas.Top="{Binding (Canvas.Top), ElementName=EllipseOverlay}"
                                     RenderTransform="{Binding RenderTransform, ElementName=EllipseOverlay}"
                                     IsHitTestVisible="False" />

                            <Ellipse x:Name="EllipseOverlay" x:FieldModifier="public"
                                     Stroke="{DynamicResource Brush.Accent.PreviewBorder}"
                                     StrokeThickness="{Binding SelectionStrokeThickness}"
                                     StrokeDashArray="4,4"
                                     Visibility="Hidden"
                                     IsHitTestVisible="False" />

                            <!-- Solid backing stroke for lasso -->
                            <Path Stroke="{DynamicResource Brush.Surface.Base}"
                                  StrokeThickness="{Binding SelectionStrokeThickness}"
                                  Visibility="{Binding Visibility, ElementName=LassoOverlay}"
                                  Data="{Binding Data, ElementName=LassoOverlay}"
                                  RenderTransform="{Binding RenderTransform, ElementName=LassoOverlay}"
                                  IsHitTestVisible="False" />

                            <!-- Light transparent yellow fill shows the lasso interior -->
                            <Path x:Name="LassoOverlay" x:FieldModifier="public"
                                  Stroke="{DynamicResource Brush.Accent.PreviewBorder}"
                                  StrokeThickness="{Binding SelectionStrokeThickness}"
                                  StrokeDashArray="4,4"
                                  Fill="{DynamicResource Brush.Common.LassoFill}"
                                  Visibility="Hidden"
                                  IsHitTestVisible="False" />

                            <!-- Text Tool Blinking Caret -->
                            <Rectangle x:Name="TextToolCaret"
                                       Fill="{DynamicResource Brush.Accent.Base}"
                                       Width="2"
                                       Height="{Binding TextToolCaretHeight}"
                                       Canvas.Left="{Binding TextToolCaretX}"
                                       Canvas.Top="{Binding TextToolCaretY}"
                                       IsHitTestVisible="False">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTextEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.5" AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>

                            <!-- Transform handles (decorative; hit-testing is in MainWindow) -->
                            <Canvas x:Name="TransformHandlesLayer" x:FieldModifier="public"
                                    IsHitTestVisible="False"
                                    ClipToBounds="False"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />

                            <!-- Brush cursor overlay (pixel-accurate bitmap) -->
                            <Image x:Name="BrushCursorOverlay" x:FieldModifier="public"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Stretch="Fill"
                                   Visibility="Hidden"
                                   IsHitTestVisible="False" />

                            <!-- Vertical Symmetry -->
                            <Grid x:Name="VerticalSymmetryOverlay"
                                  Width="16" Height="{Binding CanvasDisplayHeight}"
                                  Margin="-8,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSymmetryVisible}" Value="True" />
                                                    <Condition Binding="{Binding IsSymmetryVerticalEnabled}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RenderTransform>
                                    <TranslateTransform X="{Binding VerticalSymmetryLinePosition}" />
                                </Grid.RenderTransform>

                                <Line X1="8" X2="8" Y1="0" Y2="{Binding CanvasDisplayHeight}"
                                      Stroke="Blue" StrokeThickness="1"
                                      IsHitTestVisible="False" />

                                <Thumb HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-7,0,0" Cursor="SizeWE" DragDelta="VerticalSymmetryHandle_DragDelta" Style="{StaticResource SymmetryHandleStyle}" Tag="SymmetryHandle" />
                                <Thumb HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-7" Cursor="SizeWE" DragDelta="VerticalSymmetryHandle_DragDelta" Style="{StaticResource SymmetryHandleStyle}" Tag="SymmetryHandle" />
                            </Grid>

                            <!-- Horizontal Symmetry -->
                            <Grid x:Name="HorizontalSymmetryOverlay"
                                  Height="16" Width="{Binding CanvasDisplayWidth}"
                                  Margin="0,-8,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSymmetryVisible}" Value="True" />
                                                    <Condition Binding="{Binding IsSymmetryHorizontalEnabled}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RenderTransform>
                                    <TranslateTransform Y="{Binding HorizontalSymmetryLinePosition}" />
                                </Grid.RenderTransform>

                                <Line Y1="8" Y2="8" X1="0" X2="{Binding CanvasDisplayWidth}"
                                      Stroke="Blue" StrokeThickness="1"
                                      IsHitTestVisible="False" />

                                <Thumb HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-7,0,0,0" Cursor="SizeNS" DragDelta="HorizontalSymmetryHandle_DragDelta" Style="{StaticResource SymmetryHandleStyle}" Tag="SymmetryHandle" />
                                <Thumb HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-7,0" Cursor="SizeNS" DragDelta="HorizontalSymmetryHandle_DragDelta" Style="{StaticResource SymmetryHandleStyle}" Tag="SymmetryHandle" />
                            </Grid>

                            <!-- Crosshair lines (follow mouse smoothly) -->
                            <Line x:Name="CrosshairH" x:FieldModifier="public"
                                  StrokeThickness="0.5"
                                  Visibility="Hidden"
                                  IsHitTestVisible="False"
                                  SnapsToDevicePixels="True" />
                            <Line x:Name="CrosshairV" x:FieldModifier="public"
                                  StrokeThickness="0.5"
                                  Visibility="Hidden"
                                  IsHitTestVisible="False"
                                  SnapsToDevicePixels="True" />
                        </Canvas>
                    </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Bottom action bar -->
        <Border Grid.Row="2"
                Style="{StaticResource PanelStyle}"
                Margin="0,8,0,0"
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- History & Actions -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    
                    <!-- Undo / Redo -->
                    <Button Command="{Binding UndoCommand}"
                            ToolTip="Undo (Ctrl+Z)"
                            Style="{StaticResource CompactIconButtonStyle}"
