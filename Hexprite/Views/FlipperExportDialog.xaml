<Window x:Class="Hexprite.Views.FlipperExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        Title="Export Flipper Zero Animation"
        Width="580" MinWidth="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        core:WindowChromeHelper.ForceRoundedCorners="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hexprite;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="Font.Primary">Segoe UI</FontFamily>
            <FontFamily x:Key="Font.Code">Consolas</FontFamily>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                        <Path Data="M 2,2 H 14 V 11 H 10 L 8,14 L 6,11 H 2 Z" Fill="{DynamicResource Brush.Accent.Base}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Export to Flipper Zero"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontWeight="SemiBold"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionClose_Click" ToolTip="Close" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <Grid Margin="20,14,20,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Card 1: Target & General Info -->
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Target Structure" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CboTargetMode" SelectedIndex="{Binding SelectedTargetModeIndex, Mode=TwoWay}" Style="{StaticResource ModernComboBoxStyle}" Height="28" Margin="0,0,0,10">
                                <ComboBoxItem Content="Single Animation Folder (meta.txt + frames)" Tag="SingleAnimation"/>
                                <ComboBoxItem Content="Momentum / Xtreme Asset Pack (Anims/ + Icons/ + manifest.txt)" Tag="MomentumAssetPack"/>
                                <ComboBoxItem Content="Stock Dolphin Folder (dolphin/ + manifest.txt)" Tag="StockDolphin"/>
                            </ComboBox>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Animation Name" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtAnimationName" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding AnimationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Speed (FPS)" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtFrameRate" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding FrameRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Dolphin Playback Cycle -->
                    <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Playback Cycle &amp; Timing" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkPreserveCycle" Content="Preserve original cycle"
                                          Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11"
                                          HorizontalAlignment="Right"
                                          IsChecked="{Binding PreserveCycle, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Passive Frames" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtPassiveFrames" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PassiveFrames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPassiveFramesEditable}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Active Frames" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtActiveFrames" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ActiveFrames, Mode=OneWay}" IsReadOnly="True" Background="{DynamicResource Brush.Surface.Base}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Active Cycles" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtActiveCycles" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ActiveCycles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Duration (s)" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtDuration" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Cooldown (s)" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtActiveCooldown" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ActiveCooldown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Speech Bubble Slot -->
                    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Speech Bubble Slot (Optional)" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtBubbleText" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SpeechBubbleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="Speech bubble text (leave empty if none)"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X (0..110)" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtBubbleX" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SpeechBubbleX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y (0..52)" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtBubbleY" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SpeechBubbleY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Tail Position" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CboBubbleTail" SelectedIndex="{Binding SelectedTailPositionIndex, Mode=TwoWay}" Style="{StaticResource ModernComboBoxStyle}" Height="26">
                                        <ComboBoxItem Content="BottomLeft"/>
                                        <ComboBoxItem Content="BottomRight"/>
                                        <ComboBoxItem Content="TopLeft"/>
                                        <ComboBoxItem Content="TopRight"/>
                                        <ComboBoxItem Content="None"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Manifest Rules & Snippet -->
                    <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Manifest Scheduling Rules" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Level (1-30)" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtMinLevel" Width="36" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding MinLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="-" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBox x:Name="TxtMaxLevel" Width="36" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding MaxLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mood / Butthurt (0-14)" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtMinButthurt" Width="36" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding MinButthurt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="-" VerticalAlignment="Center" Margin="4,0" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBox x:Name="TxtMaxButthurt" Width="36" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding MaxButthurt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Weight" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtWeight" Width="50" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            
                            <TextBlock Text="Preview manifest.txt block:" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource Brush.Surface.Base}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="6" Height="74">
                                <TextBox x:Name="TxtManifestSnippet" Text="{Binding ManifestSnippet, Mode=OneWay}" Foreground="{DynamicResource Brush.Code.Identifier}" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- VALIDATION BANNER (Visible only when error/warning exists) -->
            <Border Grid.Row="2" x:Name="BannerValidation" Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}" Background="#26D32F2F" BorderBrush="#80D32F2F" BorderThickness="0,1,0,0" Padding="16,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 8,1 L 15,14 H 1 Z M 8,5 V 9 M 8,11 V 12" Stroke="{DynamicResource Brush.Status.Danger}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="{Binding ValidationStatus}" Foreground="{DynamicResource Brush.Status.Danger}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- BOTTOM BAR -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <!-- Left Action: Test in Simulator -->
                    <Button Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,2" HorizontalAlignment="Left" Command="{Binding SimulateMatrixCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🐬" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Test in Simulator..." FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Right Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource ModernButtonStyle}" Width="75" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,2" Margin="0,0,8,0" Command="{Binding DeployUsbCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 9,1 L 2,9 H 8 L 7,15 L 14,7 H 8 Z" Fill="{DynamicResource Brush.Accent.Base}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Deploy via USB..." FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Export Folder..." Command="{Binding ExportCommand}" Style="{StaticResource AccentButtonStyle}" Width="120"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
