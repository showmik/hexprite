<Window x:Class="Hexprite.Views.NewCanvasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        xmlns:vm="clr-namespace:Hexprite.ViewModels"
        xmlns:behaviors="clr-namespace:Hexprite.Behaviors"
        Title="New Document"
        Width="380" Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        core:WindowChromeHelper.ForceRoundedCorners="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="8,0,0,0" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionClose_Click" ToolTip="Close" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="CREATE NEW DOCUMENT"
                           Style="{StaticResource HeaderStyle}"
                           FontSize="14"
                           Margin="0,0,0,20" />

                <!-- Document Mode -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Mode"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               Width="80" />
                    <ComboBox x:Name="DocumentModeComboBox"
                              Width="220"
                              Height="28"
                              Style="{StaticResource ModernComboBoxStyle}"
                              SelectionChanged="DocumentMode_SelectionChanged">
                        <ComboBoxItem Content="Sprite Canvas (Monochrome)" IsSelected="True" Tag="SpriteMono" />
                        <ComboBoxItem Content="Sprite Canvas (Color)" IsEnabled="False" Tag="SpriteColor" />
                        <ComboBoxItem Content="Font Editor (Monochrome)" Tag="FontMono" />
                        <ComboBoxItem Content="Flipper Asset Pack (Schedule Matrix)" Tag="AssetPack" />
                    </ComboBox>
                </StackPanel>

                <!-- Preset dropdown -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Preset"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               Width="80" />
                    <ComboBox x:Name="PresetComboBox"
                              Width="220"
                              Height="28"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ItemsSource="{x:Static vm:MainViewModel.DisplayPresets}"
                              SelectionChanged="Preset_SelectionChanged" />
                </StackPanel>

                <!-- Width x Height -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock x:Name="SizeLabel"
                               Text="Size"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center"
                               Width="80" />
                    <TextBox x:Name="TxtWidth"
                             Text="16"
                             Width="80" Height="28"
                             Style="{StaticResource NumericTextBoxStyle}"
                             behaviors:NumericScrubBehavior.MinValue="1"
                             behaviors:NumericScrubBehavior.MaxValue="512"
                             PreviewTextInput="NumberOnly"
                             Margin="0,0,8,0" />
                    <TextBlock Text="×"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="TxtHeight"
                             Text="16"
                             Width="80" Height="28"
                             Style="{StaticResource NumericTextBoxStyle}"
                             behaviors:NumericScrubBehavior.MinValue="1"
                             behaviors:NumericScrubBehavior.MaxValue="512"
                             PreviewTextInput="NumberOnly" />
                    <TextBlock Text="px"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <!-- OK / Cancel -->
                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Width="90" MinHeight="30"
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="0,0,8,0"
                            Click="Cancel_Click" />
                    <Button Content="Create"
                            Width="120" MinHeight="30"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Create_Click"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
