<Window x:Class="Hexprite.Views.FlipperScreenMirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        xmlns:flipper="clr-namespace:Hexprite.ViewModels.Flipper"
        Title="Flipper Zero Live Screen Mirror (USB)"
        Width="640" Height="780"
        MinWidth="560" MinHeight="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        core:WindowChromeHelper.ForceRoundedCorners="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hexprite;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <FontFamily x:Key="Font.Primary">Segoe UI</FontFamily>
            <FontFamily x:Key="Font.Code">Consolas</FontFamily>

            <!-- Source Mode Pill Button Styles -->
            <Style x:Key="CanvasSourcePillStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCanvasSourceActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AnimationSourcePillStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAnimationSourceActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StudioSourcePillStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStudioSourceActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- FPS Chip Styles -->
            <Style x:Key="FpsChipBaseStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                <Setter Property="Height" Value="20"/>
                <Setter Property="Width" Value="26"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
            </Style>

            <Style x:Key="FpsChip10Style" TargetType="Button" BasedOn="{StaticResource FpsChipBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFps10Active}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FpsChip15Style" TargetType="Button" BasedOn="{StaticResource FpsChipBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFps15Active}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FpsChip20Style" TargetType="Button" BasedOn="{StaticResource FpsChipBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFps20Active}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FpsChip30Style" TargetType="Button" BasedOn="{StaticResource FpsChipBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFps30Active}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FpsChip60Style" TargetType="Button" BasedOn="{StaticResource FpsChipBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFps60Active}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Playback Speed Chip Styles -->
            <Style x:Key="SpeedChipBaseStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                <Setter Property="Height" Value="20"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Margin" Value="0,0,3,0"/>
            </Style>

            <Style x:Key="SpeedChip05Style" TargetType="Button" BasedOn="{StaticResource SpeedChipBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSpeed05xActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SpeedChip10Style" TargetType="Button" BasedOn="{StaticResource SpeedChipBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSpeed10xActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SpeedChip15Style" TargetType="Button" BasedOn="{StaticResource SpeedChipBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSpeed15xActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SpeedChip20Style" TargetType="Button" BasedOn="{StaticResource SpeedChipBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSpeed20xActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Base}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: CUSTOM TITLE BAR -->
                <RowDefinition Height="Auto"/>
                <!-- 1: WINDOW CONTENT -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════════
                 ROW 0: CUSTOM TITLE BAR
                 ═══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                        <TextBlock Text="📡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Flipper Zero Live Screen Mirror" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Brush.Surface.Active}" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding StatusLedBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionClose_Click" ToolTip="Close (Esc)" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════════
                 ROW 1: MAIN WINDOW CONTENT
                 ═══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="14,10,14,12">
                <Grid.RowDefinitions>
                    <!-- Row 0: Banner Subtitle -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Connection & Device Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Virtual LCD Screen Card -->
                    <RowDefinition Height="*"/>
                    <!-- Row 3: Stream Configuration Card -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 4: Diagnostic / Help Card -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 5: Footer Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Banner Subtitle & CDC Mode -->
                <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Stream real-time 1024-byte vertical-page LCD framebuffers directly to your connected Flipper Zero display."
                                   FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{DynamicResource Brush.Accent.Subtle}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="USB CDC • 230400 Baud" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 1: Connection & Device Bar -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Device Port:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <ComboBox Grid.Column="1" x:Name="CboPorts"
                                  ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Height="28" Margin="0,0,8,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayMember}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PortName}" FontSize="10" Foreground="{DynamicResource Brush.Accent.Base}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <CheckBox Grid.Column="2" Content="Auto-Reconnect" ToolTip="Automatically recover and resume stream if USB cable is unplugged/replugged" IsChecked="{Binding AutoReconnect, Mode=TwoWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <Button Grid.Column="3" x:Name="BtnRefreshPorts" Content="🔄 Scan" ToolTip="Scan for plugged-in Flipper Zero USB devices (F5)" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource ModernButtonStyle}" Height="28" Padding="12,0" Margin="0,0,8,0"/>

                        <Button Grid.Column="4" x:Name="BtnConnect" Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectCommand}" Style="{StaticResource AccentButtonStyle}" Height="28" Padding="16,0" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <!-- Row 2: Virtual LCD Screen Display Card -->
                <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Telemetry Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Virtual Flipper Screen Bezel -->
                            <RowDefinition Height="*"/>
                            <!-- Screen Controls & Palettes -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Telemetry HUD Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Virtual LCD Framebuffer (128×64)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource Brush.Surface.Control}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MetricsText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            </Border>
                        </Grid>

                        <!-- Virtual Screen Bezel (Chassis Frame + 384x192 Screen) -->
                        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Control}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="2" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8" Margin="0,2,0,8">
                            <Border BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="4" Padding="2" Background="{DynamicResource Brush.Surface.MenuBar}">
                                <Image x:Name="ImgLivePreview" Source="{Binding PreviewBitmap}" Width="384" Height="192" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill"/>
                            </Border>
                        </Border>

                        <!-- Screen Sub-Controls Bar: Theme Palette, LCD Grid, Snap, Pause -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Theme Palette Selector -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Theme:" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding ThemePalettes}" SelectedIndex="{Binding SelectedPaletteIndex, Mode=TwoWay}" Style="{StaticResource ModernComboBoxStyle}" Width="150" Height="24" FontSize="10">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="10" Height="10" CornerRadius="2" Background="{Binding BackgroundBrush}" BorderBrush="{Binding ForegroundBrush}" BorderThickness="1" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- LCD Grid Toggle -->
                            <CheckBox Grid.Column="1" Content="LCD Grid" IsChecked="{Binding ShowLcdGrid, Mode=TwoWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <!-- Snapshot Toast Feedback -->
                            <TextBlock Grid.Column="2" Text="{Binding SnapshotFeedbackText}" Foreground="{DynamicResource Brush.Accent.Base}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Snap Frame Snapshot Button -->
                            <Button Grid.Column="3" Content="📸 Snap Frame" ToolTip="Send active frame once to Flipper Zero immediately" Command="{Binding SendSnapshotCommand}" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="8,0" FontSize="10" Margin="0,0,6,0"/>

                            <!-- Pause / Resume Stream Button -->
                            <Button Grid.Column="4" Content="{Binding PauseButtonText}" ToolTip="{Binding PauseButtonToolTip}" Command="{Binding TogglePauseStreamCommand}" Style="{StaticResource ModernButtonStyle}" Height="24" Padding="10,0" FontSize="10" FontWeight="SemiBold"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Row 3: Stream Configuration & Frame Rate Card -->
                <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Stream Source Selector -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Stream Source:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🎨 Active Canvas" Style="{StaticResource CanvasSourcePillStyle}" Command="{Binding SetSourceModeCommand}" CommandParameter="Canvas"/>
                                <Button Content="🎬 Animation Loop" Style="{StaticResource AnimationSourcePillStyle}" Command="{Binding SetSourceModeCommand}" CommandParameter="Animation"/>
                                <Button Content="🐬 Asset Pack Studio" Style="{StaticResource StudioSourcePillStyle}" Command="{Binding SetSourceModeCommand}" CommandParameter="Studio"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Animation Playback Speed (Active when Animation Loop is selected) -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnimationSourceActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Anim Speed:" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="0.5×" ToolTip="Half Speed (Slow Motion)" Style="{StaticResource SpeedChip05Style}" Command="{Binding SetSpeedMultiplierCommand}" CommandParameter="0.5"/>
                                <Button Content="1.0× (Native)" ToolTip="1.0x Real-World Native Animation Framerate" Style="{StaticResource SpeedChip10Style}" Command="{Binding SetSpeedMultiplierCommand}" CommandParameter="1.0"/>
                                <Button Content="1.5×" ToolTip="1.5x Speed" Style="{StaticResource SpeedChip15Style}" Command="{Binding SetSpeedMultiplierCommand}" CommandParameter="1.5"/>
                                <Button Content="2.0×" ToolTip="2.0x Double Speed" Style="{StaticResource SpeedChip20Style}" Command="{Binding SetSpeedMultiplierCommand}" CommandParameter="2.0"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Control}" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NativeFpsText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Base}"/>
                            </Border>
                        </Grid>

                        <!-- Row 2: USB Stream Rate Control & Presets -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="USB Stream Rate:" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <Slider Grid.Column="1" Minimum="5" Maximum="60" Value="{Binding TargetFps, Mode=TwoWay}" SmallChange="1" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <TextBlock Grid.Column="2" Text="{Binding TargetFpsLabel}" FontSize="11" FontWeight="Bold" Width="48" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- FPS Preset Chips -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="10" ToolTip="10 FPS" Style="{StaticResource FpsChip10Style}" Command="{Binding SetFpsCommand}" CommandParameter="10"/>
                                <Button Content="15" ToolTip="15 FPS" Style="{StaticResource FpsChip15Style}" Command="{Binding SetFpsCommand}" CommandParameter="15"/>
                                <Button Content="20" ToolTip="20 FPS (Recommended for USB CDC)" Style="{StaticResource FpsChip20Style}" Command="{Binding SetFpsCommand}" CommandParameter="20"/>
                                <Button Content="30" ToolTip="30 FPS" Style="{StaticResource FpsChip30Style}" Command="{Binding SetFpsCommand}" CommandParameter="30"/>
                                <Button Content="60" ToolTip="60 FPS (High Speed)" Style="{StaticResource FpsChip60Style}" Command="{Binding SetFpsCommand}" CommandParameter="60"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Row 4: Diagnostic & Troubleshooting Tip Card -->
                <Border Grid.Row="4" Background="{DynamicResource Brush.Surface.Control}" BorderBrush="{DynamicResource Brush.Border.Base}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💡" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tip: If USB connection fails or times out, close qFlipper or other serial applications to release the COM port."
                                   FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Row 5: Footer Bar (Shortcuts & Close) -->
                <Grid Grid.Row="5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Shortcuts:" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                            <TextBlock Text="Space: Stream/Pause" FontSize="9" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </Border>
                        <Border Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                            <TextBlock Text="F5: Scan Ports" FontSize="9" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </Border>
                        <Border Background="{DynamicResource Brush.Surface.Hover}" CornerRadius="3" Padding="4,1">
                            <TextBlock Text="Esc: Close" FontSize="9" Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </Border>
                    </StackPanel>

                    <Button Content="Close" Style="{StaticResource ModernButtonStyle}" Width="80" Height="28" Padding="12,0" HorizontalAlignment="Right" Click="BtnClose_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
