<Window x:Class="Hexprite.Views.FontExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        xmlns:converters="clr-namespace:Hexprite.Converters"
        Title="Export Font"
        Width="980" Height="680"
        MinWidth="840" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        core:WindowChromeHelper.ForceRoundedCorners="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:FontExportFormatDisplayConverter x:Key="FontExportFormatDisplayConverter" />

        <Style x:Key="DialogActionChipStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Title Bar -->
                <RowDefinition Height="*" />    <!-- Content Area (Dual-Pane) -->
                <RowDefinition Height="Auto" /> <!-- Footer Action Bar -->
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR ═══ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Surface.MenuBar}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Window Icon & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                        <Path Style="{StaticResource StrokedToolIconStyle}"
                              Width="14" Height="14"
                              Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"
                              Fill="{DynamicResource Brush.Accent.Base}"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="TitleTextBlock"
                                   Text="EXPORT FONT"
                                   Style="{StaticResource HeaderStyle}"
                                   FontSize="12" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Window Caption Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionMinimize_Click" ToolTip="Minimize" Width="44" Height="34"
                                Style="{StaticResource CaptionButtonStyle}">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                        <Button Click="CaptionMaximize_Click" ToolTip="Maximize / Restore" Width="44" Height="34"
                                Style="{StaticResource CaptionButtonStyle}">
                            <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                        <Button Click="CaptionClose_Click" ToolTip="Close (Esc)" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ MAIN CONTENT AREA (DUAL-PANE) ═══ -->
            <Grid Grid.Row="1" Margin="14,12,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="320" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <!-- ── LEFT COLUMN: CONFIGURATION & METRICS ── -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <StackPanel>
                        <!-- Card 1: Target Format & Settings -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="EXPORT FORMAT &amp; OPTIONS" Style="{StaticResource HeaderStyle}" Margin="0,0,0,8" />

                                <TextBlock Text="Target Library / Format" Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontSize="11" Margin="0,0,0,4" />
                                <ComboBox x:Name="FormatComboBox" Style="{StaticResource ModernComboBoxStyle}"
                                          SelectionChanged="OnSettingChanged" Margin="0,0,0,10" Padding="8,5">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource FontExportFormatDisplayConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="C Font Identifier Name" Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontSize="11" Margin="0,0,0,4" />
                                <TextBox x:Name="FontNameTextBox" Style="{StaticResource ModernTextBoxStyle}"
                                         TextChanged="FontNameTextBox_TextChanged" LostFocus="FontNameTextBox_LostFocus"
                                         Margin="0,0,0,3" Padding="7,4" />
                                <TextBlock Text="Valid C identifier used in code declarations" Foreground="{DynamicResource Brush.Text.Muted}"
                                           FontSize="10" Margin="0,0,0,10" />

                                <CheckBox x:Name="IncludeGlyphPreviewCheckBox" Content="Include Glyph ASCII Previews"
                                          Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6"
                                          Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="IncludeMetricCommentsCheckBox" Content="Include Metric Comments"
                                          Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6"
                                          Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="IncludeUsageCommentCheckBox" Content="Include Library Usage Guide"
                                          Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,10"
                                          Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

                                <TextBlock Text="Hex Literal Format" Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontSize="11" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <RadioButton x:Name="RbHexUpper" Content="0xFF (Upper)" GroupName="HexCase"
                                                 IsChecked="True" Checked="OnSettingChanged" Margin="0,0,14,0"
                                                 Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11" />
                                    <RadioButton x:Name="RbHexLower" Content="0xff (Lower)" GroupName="HexCase"
                                                 Checked="OnSettingChanged"
                                                 Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Flash Budget & Metrics -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="FLASH BUDGET &amp; METRICS" Style="{StaticResource HeaderStyle}" Margin="0,0,0,8" />

                                <TextBlock Text="ESTIMATED FLASH USAGE" Foreground="{DynamicResource Brush.Text.Muted}"
                                           FontSize="9" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <TextBlock Foreground="{DynamicResource Brush.Accent.Base}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8">
                                    <Run x:Name="FlashBytesRun" Text="0" /><Run Text=" bytes" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource Brush.Text.Muted}" />
                                </TextBlock>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                        <TextBlock Text="Glyphs" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" />
                                        <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11.5" FontWeight="SemiBold">
                                            <Run x:Name="GlyphCountRun" Text="0" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                        <TextBlock Text="Cell Dimensions" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" />
                                        <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11.5" FontWeight="SemiBold">
                                            <Run x:Name="CellDimensionsRun" Text="0×0 px" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="Char Range" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" />
                                        <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11.5" FontWeight="SemiBold">
                                            <Run x:Name="CharRangeRun" Text="0x00 - 0x00" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="Baseline / Advance" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" />
                                        <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11.5" FontWeight="SemiBold">
                                            <Run x:Name="BaselineRun" Text="0 / 0 px" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="TxtFormatNote"
                                           Text="Packed bitmaps + glyph descriptors table + font header."
                                           Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Quick Integration Snippet -->
                        <Border Background="{DynamicResource Brush.Surface.Panel}"
                                CornerRadius="6" Padding="12,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="INTEGRATION SNIPPET" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" />

                                    <Button Grid.Column="1" x:Name="BtnCopySnippet" Click="CopySnippet_Click"
                                            Style="{StaticResource DialogActionChipStyle}"
                                            Padding="8,3" ToolTip="Copy integration snippet to clipboard">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtCopySnippetIcon" Text="📋" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtCopySnippetLabel" Text="Copy Snippet" FontSize="10.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Background="{DynamicResource Brush.Surface.Base}" CornerRadius="4" Padding="8,6">
                                    <TextBox x:Name="SnippetTextBox" IsReadOnly="True" Background="Transparent"
                                             Foreground="{DynamicResource Brush.Text.Secondary}" BorderThickness="0"
                                             FontFamily="{DynamicResource Font.Code}" FontSize="11" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── RIGHT COLUMN: LIVE CODE PREVIEW ── -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header Toolbar -->
                        <RowDefinition Height="Auto" /> <!-- Collapsible Find Bar -->
                        <RowDefinition Height="*" />    <!-- Monospace Code Viewer -->
                        <RowDefinition Height="Auto" /> <!-- Code Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- Preview Header Toolbar -->
                    <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Brush.Border.Separator}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="6,6,0,0" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtOutputFileName" Text="myFont.h"
                                           Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border Background="{DynamicResource Brush.Surface.Control}" CornerRadius="3"
                                        Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtFormatBadge" Text="C/C++ Header"
                                               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnToggleFind" Click="ToggleFind_Click"
                                        Style="{StaticResource DialogActionChipStyle}"
                                        Padding="8,4" ToolTip="Find in code (Ctrl+F)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Find" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <CheckBox x:Name="ChkWordWrap" Content="Wrap Lines"
                                          Foreground="{DynamicResource Brush.Text.Secondary}"
                                          FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                          Checked="WordWrap_Changed" Unchecked="WordWrap_Changed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Collapsible Find Bar -->
                    <Border Grid.Row="1" x:Name="FindBar" Visibility="Collapsed"
                            Background="{DynamicResource Brush.Surface.MenuBar}"
                            BorderBrush="{DynamicResource Brush.Border.Separator}"
                            BorderThickness="0,0,0,1" Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TxtSearch" Style="{StaticResource ModernTextBoxStyle}"
                                         Width="180" Margin="0,0,6,0" Padding="6,3"
                                         TextChanged="TxtSearch_TextChanged" />
                                <Button Click="FindPrev_Click" Style="{StaticResource ModernButtonStyle}"
                                        Content="▲" ToolTip="Previous Match (Shift+F3)" Width="26" Height="26" Margin="0,0,4,0" />
                                <Button Click="FindNext_Click" Style="{StaticResource ModernButtonStyle}"
                                        Content="▼" ToolTip="Next Match (F3)" Width="26" Height="26" Margin="0,0,8,0" />
                                <TextBlock x:Name="TxtMatchCount" Text="" Foreground="{DynamicResource Brush.Text.Muted}"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </StackPanel>

                            <Button Grid.Column="2" Click="CloseFind_Click" Style="{StaticResource CaptionCloseButtonStyle}"
                                    Width="26" Height="26" ToolTip="Close (Esc)">
                                <TextBlock Text="✕" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Monospace Code Box -->
                    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Base}"
                            PreviewMouseWheel="CodeViewer_PreviewMouseWheel">
                        <TextBox x:Name="CodeTextBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{DynamicResource Font.Code}"
                                 FontSize="12"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderThickness="0"
                                 Padding="12,10"
                                 SelectionBrush="{DynamicResource Brush.Accent.Base}"
                                 SelectionOpacity="0.4"
                                 SelectionChanged="CodeTextBox_SelectionChanged"
                                 PreviewMouseWheel="CodeViewer_PreviewMouseWheel" />
                    </Border>

                    <!-- Code Status Bar -->
                    <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.Panel}"
                            BorderBrush="{DynamicResource Brush.Border.Separator}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,6,6" Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="TxtCodeStats" Text="0 lines | 0 chars | 0 B"
                                       Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Name="TxtCursorPos" Text=""
                                       Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══ FOOTER ACTION BAR ═══ -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.MenuBar}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                    BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="TxtStatusMessage" Text="Ready to export."
                               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11.5" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnCopyCode" Click="CopyCode_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Background="{DynamicResource Brush.Accent.Base}" Foreground="White"
                                FontWeight="SemiBold"
                                Padding="14,6" Margin="0,0,8,0"
                                ToolTip="Copy generated code to clipboard (Ctrl+C)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtCopyIcon" Text="📋" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtCopyLabel" Text="Copy Code" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSaveAs" Click="SaveAs_Click"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="14,6" Margin="0,0,8,0"
                                ToolTip="Save generated code to file (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Save to File..." FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnClose" Click="Close_Click"
                                Style="{StaticResource ModernButtonStyle}"
                                Content="Close" Padding="14,6"
                                ToolTip="Close Dialog (Esc)" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
