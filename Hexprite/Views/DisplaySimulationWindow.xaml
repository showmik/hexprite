<Window x:Class="Hexprite.Views.DisplaySimulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        Title="Display Simulation"
        Width="700" Height="540"
        MinWidth="420" MinHeight="350"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown"
        Focusable="True"
        core:WindowChromeHelper.ForceRoundedCorners="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR ═══ -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                        <TextBlock Text="🖥" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Display Simulation"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontWeight="SemiBold"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionMinimize_Click" ToolTip="Minimize" Width="44" Height="34"
                                Style="{StaticResource CaptionButtonStyle}">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Click="CaptionMaximize_Click" ToolTip="Maximize / Restore" Width="44" Height="34"
                                Style="{StaticResource CaptionButtonStyle}">
                            <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Click="CaptionClose_Click" ToolTip="Close (Esc)" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ CONTROLS ═══ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                    BorderThickness="0,0,0,1"
                    Padding="10,7">
                <DockPanel LastChildFill="True">
                    <!-- Right: Primary Action (Copy Image) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="BtnCopyImage"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="26"
                                Padding="12,0"
                                Click="CopyImage_Click"
                                ToolTip="Copy simulated display image to clipboard (Ctrl+C)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCopyLabel" Text="Copy Image" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Left: Simulation Configuration Parameters -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Group 1: Display Preset -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                            <TextBlock Text="Display"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CboDisplayType" Height="26" Width="135"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      SelectedIndex="{Binding PreviewDisplayTypeIndex}"
                                      SelectionChanged="DisplayType_Changed">
                                <ComboBoxItem Content="Generic (White)"/>
                                <ComboBoxItem Content="SSD1306 (Blue)"/>
                                <ComboBoxItem Content="SSD1306 (Green)"/>
                                <ComboBoxItem Content="e-Paper"/>
                                <ComboBoxItem Content="Flipper Zero"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Divider -->
                        <Rectangle Width="1" Height="16"
                                   Style="{StaticResource SeparatorRectangleStyle}"
                                   Margin="12,0" VerticalAlignment="Center"/>

                        <!-- Group 2: Realism Strength -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                            <TextBlock Text="Strength"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="SliderStrength" Minimum="0" Maximum="100"
                                    Value="{Binding PreviewRealismStrength}"
                                    Width="80" TickFrequency="10" IsSnapToTickEnabled="False"
                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                    ValueChanged="Strength_Changed"/>
                            <TextBlock Text="{Binding Value, ElementName=SliderStrength, StringFormat='{}{0:0}%'}"
                                       Width="32" TextAlignment="Right" Foreground="{DynamicResource Brush.Text.Primary}"
                                       FontWeight="Medium" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Rectangle Width="1" Height="16"
                                   Style="{StaticResource SeparatorRectangleStyle}"
                                   Margin="12,0" VerticalAlignment="Center"/>

                        <!-- Group 3: Quality -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                            <TextBlock Text="Quality"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CboQuality" Height="26" Width="95"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      SelectedIndex="{Binding PreviewQualityIndex}"
                                      SelectionChanged="Quality_Changed">
                                <ComboBoxItem Content="Fast"/>
                                <ComboBoxItem Content="Balanced"/>
                                <ComboBoxItem Content="High"/>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- ═══ VIEWPORT ═══ -->
            <ScrollViewer x:Name="ViewportScrollViewer"
                          Grid.Row="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource Brush.Surface.Base}"
                          PreviewMouseWheel="Viewport_PreviewMouseWheel"
                          PreviewMouseDown="Viewport_PreviewMouseDown"
                          PreviewMouseMove="Viewport_PreviewMouseMove"
                          PreviewMouseUp="Viewport_PreviewMouseUp">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                    <Image x:Name="SimImage"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Stretch="None"/>
                </Grid>
            </ScrollViewer>

            <!-- ═══ STATUS BAR ═══ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                    BorderThickness="0,1,0,0"
                    Padding="10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Metadata & Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatus"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Viewport Zoom Cluster -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Zoom"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <Button x:Name="BtnZoomOut" Content="−" Width="22" Height="22" Padding="0"
                                Style="{StaticResource ModernButtonStyle}" Click="ZoomOut_Click"
                                ToolTip="Zoom Out (Ctrl -)"/>
                        <TextBlock x:Name="TxtZoom" Text="3x" Width="32" TextAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        <Button x:Name="BtnZoomIn" Content="+" Width="22" Height="22" Padding="0"
                                Style="{StaticResource ModernButtonStyle}" Click="ZoomIn_Click"
                                ToolTip="Zoom In (Ctrl +)"/>
                        <Button x:Name="BtnFit" Content="Fit" Height="22" Padding="8,0"
                                Style="{StaticResource ModernButtonStyle}" Click="FitZoom_Click"
                                Margin="4,0,0,0" ToolTip="Fit to Window (Ctrl 0)"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
