<Window x:Class="Hexprite.Views.FontImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        Title="Import Font"
        Width="920" Height="650"
        MinWidth="840" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        core:WindowChromeHelper.ForceRoundedCorners="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Flat Minimal Inspector Styles (Eliminates Wireframe Outlines in Dim Theme) -->
        <Style x:Key="FlatDialogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Separator}" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatDialogNumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource NumericTextBoxStyle}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Separator}" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatActionChipStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}" />
        </Style>

        <Style x:Key="FlatToggleChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource ModernToggleButtonStyle}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}" />
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Title Bar -->
                <RowDefinition Height="*" />    <!-- Content Area -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                        <TextBlock Text="IMPORT FONT"
                                   Style="{StaticResource HeaderStyle}"
                                   FontSize="12" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionClose_Click"
                                ToolTip="Close (Esc)"
                                Width="46" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Dialog Body -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" MinWidth="380" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Settings Cards & Actions -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />    <!-- Settings Cards -->
                        <RowDefinition Height="Auto" /> <!-- Validation & Action Buttons -->
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- ── Card 1: Import Source Configuration ── -->
                            <Border Background="{DynamicResource Brush.Surface.Panel}"
                                    CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="SOURCE CONFIGURATION" Style="{StaticResource HeaderStyle}" Margin="0,0,0,8" />

                                    <ComboBox x:Name="SourceModeCombo" SelectionChanged="SourceModeCombo_SelectionChanged"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              Padding="8,5" Margin="0,0,0,10">
                                        <ComboBoxItem Content="System Font (Render from OS)" Tag="System" IsSelected="True" />
                                        <ComboBoxItem Content="Font File (.ttf, .otf)" Tag="File" />
                                        <ComboBoxItem Content="Sprite Sheet (.png, .bmp)" Tag="Sprite" />
                                        <ComboBoxItem Content="BMFont (.fnt)" Tag="BMFont" />
                                    </ComboBox>

                                    <!-- Mode Specific Sub-Panels with MinHeight to Prevent Layout Jumps -->
                                    <Grid MinHeight="170">
                                        <!-- System Font Sub-Panel -->
                                        <Grid x:Name="SystemFontPanel" Visibility="Visible">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="136" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="FontSearchBox" Style="{StaticResource FlatDialogTextBoxStyle}"
                                                         Height="26" FontSize="11" Padding="6,3"
                                                         TextChanged="FontSearchBox_TextChanged"
                                                         ToolTip="Filter system fonts by name" />
                                                <Button Grid.Column="1" Content="✕" Style="{StaticResource FlatActionChipStyle}"
                                                        Height="26" Width="26" Margin="4,0,0,0" Padding="0" FontSize="10"
                                                        Click="ClearFontSearch_Click" ToolTip="Clear search filter" />
                                            </Grid>

                                            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Control}"
                                                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                                                    BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <ListBox x:Name="FontListBox"
                                                             Background="Transparent" BorderThickness="0"
                                                             Foreground="{DynamicResource Brush.Text.Primary}"
                                                             SelectionChanged="FontListBox_SelectionChanged"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="13" Padding="6,3" />
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <TextBlock x:Name="EmptyFontSearchText" Text="No matching fonts found"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="11" FontStyle="Italic" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- File / Sprite / BMFont Shared Sub-Panel -->
                                        <StackPanel x:Name="FilePickerPanel" Visibility="Collapsed" VerticalAlignment="Top">
                                            <TextBlock Text="FILE PATH" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,4" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="FilePathBox" Style="{StaticResource FlatDialogTextBoxStyle}"
                                                         Height="28" FontSize="11" Padding="6,4"
                                                         TextChanged="FilePathBox_TextChanged"
                                                         ToolTip="Path to font or sprite file (Drag &amp; Drop supported)" />
                                                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource ModernButtonStyle}"
                                                        Height="28" Padding="10,0" Margin="6,0,0,0"
                                                        Click="BrowseFile_Click" />
                                            </Grid>

                                            <!-- Drop target hint area -->
                                            <Border Background="{DynamicResource Brush.Surface.Control}"
                                                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="12,10" Margin="0,0,0,8">
                                                <TextBlock Text="💡 Drag and drop a file (.ttf, .otf, .png, .bmp, .fnt) here"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                           FontSize="11" HorizontalAlignment="Center" />
                                            </Border>

                                            <!-- Sprite Sheet Cell Dimensions -->
                                            <StackPanel x:Name="SpriteSettingsPanel" Visibility="Collapsed" Margin="0,2,0,0">
                                                <TextBlock Text="SPRITE GRID CELL SIZE" Style="{StaticResource HeaderStyle}" FontSize="10" Margin="0,0,0,4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Cell Width (px)" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,3" />
                                                        <TextBox x:Name="CellWidthBox" Style="{StaticResource FlatDialogNumericTextBoxStyle}"
                                                                 Height="26" Text="8" Padding="6,3" TextChanged="Input_TextChanged" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Cell Height (px)" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,3" />
                                                        <TextBox x:Name="CellHeightBox" Style="{StaticResource FlatDialogNumericTextBoxStyle}"
                                                                 Height="26" Text="8" Padding="6,3" TextChanged="Input_TextChanged" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ── Card 2: Common Layout & Rendering Metrics ── -->
                            <Border x:Name="CommonSettingsPanel" Background="{DynamicResource Brush.Surface.Panel}"
                                    CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="LAYOUT &amp; RENDERING METRICS" Style="{StaticResource HeaderStyle}" Margin="0,0,0,8" />

                                    <!-- Row 1: Height (px) & Baseline Offset (px) -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="HeightPanel" Grid.Column="0">
                                            <TextBlock Text="Height (px)" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,3" />
                                            <TextBox x:Name="HeightBox" Style="{StaticResource FlatDialogNumericTextBoxStyle}"
                                                     Height="26" Text="8" Padding="6,3" TextChanged="Input_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Baseline Offset" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,3" />
                                            <TextBox x:Name="BaselineOffsetBox" Style="{StaticResource FlatDialogNumericTextBoxStyle}"
                                                     Height="26" Text="0" Padding="6,3" TextChanged="Input_TextChanged"
                                                     ToolTip="Shifts the baseline up or down (-128 to 128)" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Letter Spacing & Threshold -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Letter Spacing" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,3" />
                                            <TextBox x:Name="LetterSpacingBox" Style="{StaticResource FlatDialogNumericTextBoxStyle}"
                                                     Height="26" Text="1" Padding="6,3" TextChanged="Input_TextChanged"
                                                     ToolTip="Extra blank pixels added horizontally after each character" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Threshold (1-255)" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,3" />
                                            <TextBox x:Name="ThresholdBox" Style="{StaticResource FlatDialogNumericTextBoxStyle}"
                                                     Height="26" Text="128" Padding="6,3" TextChanged="Input_TextChanged"
                                                     ToolTip="Alpha / luminance quantization threshold" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 3: Character Range (First Char & Last Char) -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="First Char (ASCII)" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,3" />
                                            <TextBox x:Name="FirstCharBox" Style="{StaticResource FlatDialogNumericTextBoxStyle}"
                                                     Height="26" Text="32" Padding="6,3" TextChanged="Input_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Last Char (ASCII)" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,3" />
                                            <TextBox x:Name="LastCharBox" Style="{StaticResource FlatDialogNumericTextBoxStyle}"
                                                     Height="26" Text="126" Padding="6,3" TextChanged="Input_TextChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 4: Anti-Alias CheckBox -->
                                    <StackPanel x:Name="AntiAliasPanel" Orientation="Horizontal" Margin="0,2,0,0">
                                        <CheckBox x:Name="AntiAliasBox" Content="Anti-Alias (Smooth rendering before quantization)"
                                                  Foreground="{DynamicResource Brush.Text.Primary}"
                                                  VerticalAlignment="Center"
                                                  Checked="Input_CheckChanged" Unchecked="Input_CheckChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Left Column Footer: Status Banner & Dialog Actions -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <!-- Real-Time Validation Status Banner -->
                        <Border x:Name="ValidationStatusBorder" Background="{DynamicResource Brush.Surface.Panel}"
                                CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                            <TextBlock x:Name="ValidationStatusText" Text="Ready to import font."
                                       FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="Cancel"
                                    IsCancel="True" Padding="18,6" Margin="0,0,8,0" Click="Cancel_Click" />
                            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" x:Name="ImportButton"
                                    Content="Import Font" IsDefault="True" Padding="20,6" Click="Import_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Right Column: Live Hardware Preview Studio -->
                <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Panel}"
                        CornerRadius="6" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Preview Toolbar & Zoom -->
                            <RowDefinition Height="Auto" /> <!-- Preview Text Input -->
                            <RowDefinition Height="*" />    <!-- Hardware Screen -->
                        </Grid.RowDefinitions>

                        <!-- Preview Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Header & Zoom Controls -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LIVE PREVIEW" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="Zoom:" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Slider x:Name="ZoomSlider" Minimum="1" Maximum="10" Value="2" Width="70"
                                        VerticalAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True" />
                                <TextBlock Text="{Binding Value, ElementName=ZoomSlider, StringFormat={}{0}x}"
                                           Foreground="{DynamicResource Brush.Accent.Base}" FontWeight="SemiBold"
                                           FontSize="11" VerticalAlignment="Center" Margin="4,0,6,0" Width="26" />
                            </StackPanel>

                            <!-- Presets & Invert Toggle -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PRESETS" Style="{StaticResource HeaderStyle}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Style="{StaticResource FlatActionChipStyle}" Content="Fox" Padding="6,0" Height="22" Margin="0,0,2,0"
                                        Click="BtnPresetFox_Click" ToolTip="Full alphabet sentence" />
                                <Button Style="{StaticResource FlatActionChipStyle}" Content="0-9" Padding="6,0" Height="22" Margin="0,0,2,0"
                                        Click="BtnPresetDigits_Click" ToolTip="Digits &amp; Math symbols" />
                                <Button Style="{StaticResource FlatActionChipStyle}" Content="Aa" Padding="6,0" Height="22" Margin="0,0,2,0"
                                        Click="BtnPresetAa_Click" ToolTip="Letter pairs" />
                                <Button Style="{StaticResource FlatActionChipStyle}" Content="Sym" Padding="6,0" Height="22" Margin="0,0,6,0"
                                        Click="BtnPresetSymbols_Click" ToolTip="Symbols &amp; Punctuation" />
                                <ToggleButton x:Name="InvertToggle" Content="Invert" Style="{StaticResource FlatToggleChipStyle}"
                                              Padding="6,0" Height="22" FontSize="10" Click="InvertToggle_Click"
                                              ToolTip="Invert monochrome pixels" />
                            </StackPanel>
                        </Grid>

                        <!-- Preview Text Input -->
                        <TextBox Grid.Row="1" x:Name="PreviewTextBox" Style="{StaticResource FlatDialogTextBoxStyle}"
                                 Height="28" Padding="8,4" FontSize="11" Margin="0,0,0,8"
                                 Text="The quick brown fox jumps over the lazy dog 0123456789"
                                 TextChanged="Input_TextChanged"
                                 ToolTip="Type custom text to preview with this font in real-time" />

                        <!-- Hardware Display Simulator (#FF161B22) -->
                        <Border Grid.Row="2" Background="#FF161B22"
                                BorderBrush="{DynamicResource Brush.Border.Separator}"
                                BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image x:Name="PreviewImage" Stretch="None"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="20">
                                    <Image.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding Value, ElementName=ZoomSlider}"
                                                        ScaleY="{Binding Value, ElementName=ZoomSlider}" />
                                    </Image.LayoutTransform>
                                </Image>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
