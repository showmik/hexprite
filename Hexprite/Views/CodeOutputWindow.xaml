<Window x:Class="Hexprite.Views.CodeOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        xmlns:rendering="clr-namespace:Hexprite.Rendering"
        Title="Generated Code"
        Width="920" Height="640"
        MinWidth="540" MinHeight="380"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        core:WindowChromeHelper.ForceRoundedCorners="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Title Bar -->
                <RowDefinition Height="Auto" /> <!-- Export Settings Toolbar -->
                <RowDefinition Height="Auto" /> <!-- View & Search Toolbar -->
                <RowDefinition Height="Auto" /> <!-- Collapsible Find Bar -->
                <RowDefinition Height="*" />    <!-- Code Content -->
                <RowDefinition Height="Auto" /> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR ═══ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Surface.MenuBar}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Window Icon & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                        <Path Style="{StaticResource StrokedToolIconStyle}"
                              Width="14" Height="14"
                              Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"
                              Fill="{DynamicResource Brush.Accent.Base}"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTitle"
                                   Text="Generated Code"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Window Caption Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionMinimize_Click" ToolTip="Minimize" Width="44" Height="34"
                                Style="{StaticResource CaptionButtonStyle}">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Click="CaptionMaximize_Click" ToolTip="Maximize / Restore" Width="44" Height="34"
                                Style="{StaticResource CaptionButtonStyle}">
                            <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Click="CaptionClose_Click" ToolTip="Close (Esc)" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ PRIMARY TOOLBAR: SETTINGS & PRIMARY ACTIONS ═══ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                    BorderThickness="0,0,0,1"
                    Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Format & Output Options -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <!-- Format -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                            <TextBlock Text="Format" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CboFormat"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="26" Width="215"
                                      SelectionChanged="CboFormat_SelectionChanged">
                                <ComboBoxItem Content="Adafruit GFX (C array)"        Tag="AdafruitGfx"/>
                                <ComboBoxItem Content="u8g2 drawBitmap (C array)"     Tag="U8g2DrawBitmap"/>
                                <ComboBoxItem Content="u8g2 drawXBM (LSB first)"      Tag="U8g2DrawXBM"/>
                                <ComboBoxItem Content="Plain C array"                 Tag="PlainCArray"/>
                                <ComboBoxItem Content="MicroPython (bytearray)"       Tag="MicroPython"/>
                                <ComboBoxItem Content="Raw Hex (bytes)"               Tag="RawHex"/>
                                <ComboBoxItem Content="Raw Binary"                    Tag="RawBinary"/>
                                <ComboBoxItem Content="Indexed 2D array (1 byte/px)"  Tag="Indexed2D"/>
                                <ComboBoxItem Content="LiquidCrystal 1602 (createChar)" Tag="LiquidCrystalChar"/>
                                <ComboBoxItem Content="Flipper Bitmap (Compressed)"   Tag="FlipperCompressedBitmap"/>
                                <ComboBoxItem Content="Flipper XBM (LSB first)"       Tag="FlipperXbm"/>
                                <ComboBoxItem Content="Flipper Icon (Asset)"          Tag="FlipperCanvasIcon"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Compression (conditional) -->
                        <StackPanel x:Name="PanelCompression" Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                            <TextBlock Text="Compression" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CboCompression"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="26" Width="125"
                                      SelectionChanged="CboCompression_SelectionChanged">
                                <ComboBoxItem Content="None (raw)"     Tag="None"/>
                                <ComboBoxItem Content="RLE (~120B)"    Tag="Rle"/>
                                <ComboBoxItem Content="LZSS (~200B)"   Tag="Lzss"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Bytes per line -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                            <TextBlock Text="Bytes/line" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <RadioButton x:Name="RbBpl0" Content="Auto" GroupName="WinBytesPerLine" Style="{StaticResource ChipButtonStyle}" Tag="0" Checked="BplChip_Checked" Margin="0,0,3,0"/>
                            <RadioButton x:Name="RbBpl4" Content="4" GroupName="WinBytesPerLine" Style="{StaticResource ChipButtonStyle}" Tag="4" Checked="BplChip_Checked" Margin="0,0,3,0"/>
                            <RadioButton x:Name="RbBpl8" Content="8" GroupName="WinBytesPerLine" Style="{StaticResource ChipButtonStyle}" Tag="8" Checked="BplChip_Checked" Margin="0,0,3,0"/>
                            <RadioButton x:Name="RbBpl16" Content="16" GroupName="WinBytesPerLine" Style="{StaticResource ChipButtonStyle}" Tag="16" Checked="BplChip_Checked"/>
                        </StackPanel>

                        <!-- Hex case -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,14,2" VerticalAlignment="Center">
                            <TextBlock Text="Hex" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <RadioButton x:Name="RbHexUpper" Content="0xFF" GroupName="WinHexCase" Style="{StaticResource ChipButtonStyle}" Tag="upper" Checked="HexCase_Checked" Margin="0,0,3,0"/>
                            <RadioButton x:Name="RbHexLower" Content="0xff" GroupName="WinHexCase" Style="{StaticResource ChipButtonStyle}" Tag="lower" Checked="HexCase_Checked"/>
                        </StackPanel>

                        <!-- Full Sketch Toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkFullSketch"
                                      Content="Full Sketch (.ino / .py)"
                                      Foreground="{DynamicResource Brush.Text.Primary}"
                                      FontSize="11"
                                      FontWeight="Medium"
                                      VerticalAlignment="Center"
                                      Checked="FullSketch_Changed"
                                      Unchecked="FullSketch_Changed"
                                      ToolTip="Generate a complete, ready-to-run sketch/script with display setup and animation loops"/>
                        </StackPanel>

                    </WrapPanel>

                    <!-- Right: Primary Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button x:Name="BtnCopyCode"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="98"
                                Padding="0,5"
                                Margin="0,0,6,0"
                                Click="CopyCode_Click"
                                ToolTip="Copy generated code to clipboard (Ctrl+C)">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCopyIcon" Text="📋" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCopyLabel" Text="Copy Code" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSaveAs"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="9,5"
                                Margin="0,0,6,0"
                                Click="SaveAs_Click"
                                ToolTip="Save code to a file (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save As..." FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnExportSketch"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="9,5"
                                Margin="0,0,6,0"
                                Click="ExportSketch_Click"
                                ToolTip="Export standalone Arduino sketch folder (&lt;name&gt;/&lt;name&gt;.ino + sprites.h)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Export Sketch" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnGenerateCode"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="9,5"
                                Click="GenerateCode_Click"
                                ToolTip="Regenerate code from canvas (F5 / Ctrl+R)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⟳" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Generate" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ SECONDARY TOOLBAR: VIEW CONTROLS & FIND ═══ -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                    BorderThickness="0,0,0,1"
                    Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: View Mode, Word Wrap, Find Trigger -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <!-- View mode chips -->
                        <RadioButton x:Name="RbModeSyntax"
                                     Content="🎨 Highlighted"
                                     GroupName="WinViewMode"
                                     Style="{StaticResource ChipButtonStyle}"
                                     IsChecked="True"
                                     Checked="ViewMode_Changed"
                                     Margin="0,0,4,0"
                                     ToolTip="Syntax highlighted preview"/>
                        <RadioButton x:Name="RbModeSelectable"
                                     Content="📝 Selectable Text"
                                     GroupName="WinViewMode"
                                     Style="{StaticResource ChipButtonStyle}"
                                     Checked="ViewMode_Changed"
                                     Margin="0,0,14,0"
                                     ToolTip="Select and copy text snippets with mouse/keyboard"/>

                        <!-- Word Wrap -->
                        <CheckBox x:Name="ChkWordWrap"
                                  Content="Word Wrap"
                                  Foreground="{DynamicResource Brush.Text.Muted}"
                                  FontSize="11"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0"
                                  Checked="WordWrap_Changed"
                                  Unchecked="WordWrap_Changed"
                                  ToolTip="Wrap lines in selectable mode"/>

                        <!-- Find in Code Button -->
                        <Button x:Name="BtnToggleFind"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="8,3"
                                Click="ToggleFind_Click"
                                ToolTip="Find text in code (Ctrl+F)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Find" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Font Size Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Font" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="−" Width="22" Height="22" Padding="0"
                                Style="{StaticResource ModernButtonStyle}" Click="FontSizeDecrease_Click" ToolTip="Decrease font size (Ctrl+-)" Margin="0,0,2,0"/>
                        <TextBlock x:Name="TxtFontSize" Text="12pt" Width="34" TextAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontWeight="Medium" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <Button Content="+" Width="22" Height="22" Padding="0"
                                Style="{StaticResource ModernButtonStyle}" Click="FontSizeIncrease_Click" ToolTip="Increase font size (Ctrl++)" Margin="0,0,4,0"/>
                        <Button Content="Reset" Padding="5,2"
                                Style="{StaticResource ModernButtonStyle}" Click="FontSizeReset_Click" ToolTip="Reset font size to 12pt (Ctrl+0)" FontSize="10.5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ COLLAPSIBLE FIND / SEARCH BAR ═══ -->
            <Border x:Name="FindBar"
                    Grid.Row="3"
                    Background="{DynamicResource Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                    BorderThickness="0,0,0,1"
                    Padding="12,6"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Find:" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <TextBox x:Name="TxtSearch"
                             Grid.Column="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="24"
                             FontSize="11.5"
                             Padding="6,0"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"
                             KeyDown="TxtSearch_KeyDown"/>

                    <!-- Match counter -->
                    <TextBlock x:Name="TxtMatchCount"
                               Grid.Column="2"
                               Text="No matches"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="10,0,10,0"/>

                    <!-- Previous & Next -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnFindPrev"
                                Content="▲ Prev"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="8,2"
                                Margin="0,0,4,0"
                                Click="FindPrev_Click"
                                ToolTip="Find previous occurrence (Shift+F3 / Shift+Enter)"/>
                        <Button x:Name="BtnFindNext"
                                Content="▼ Next"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="8,2"
                                Click="FindNext_Click"
                                ToolTip="Find next occurrence (F3 / Enter)"/>
                    </StackPanel>

                    <!-- Close Search -->
                    <Button Grid.Column="5"
                            Content="✕"
                            Style="{StaticResource ModernButtonStyle}"
                            Width="22" Height="22"
                            Padding="0"
                            Click="CloseFind_Click"
                            ToolTip="Close search bar (Esc)"/>
                </Grid>
            </Border>

            <!-- ═══ CODE CONTENT ═══ -->
            <Grid Grid.Row="4"
                  Background="{DynamicResource Brush.Surface.Base}"
                  PreviewMouseWheel="CodeContent_PreviewMouseWheel">
                
                <!-- View 1: Syntax Highlighted FrameworkElement -->
                <ScrollViewer x:Name="SyntaxScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="Transparent">
                    <rendering:SyntaxHighlightBox x:Name="CodeHighlightBox"
                                                  FontFamily="{DynamicResource Font.Code}"
                                                  FontSize="12"
                                                  Margin="16,12"/>
                </ScrollViewer>

                <!-- View 2: Selectable Read-Only TextBox inside ScrollViewer -->
                <ScrollViewer x:Name="SelectableScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="Transparent"
                              Visibility="Collapsed">
                    <Grid Margin="16,12">
                        <!-- Search match highlight background overlay for all matches in selectable mode -->
                        <rendering:SearchMatchOverlay x:Name="SelectableSearchOverlay"
                                                      IsHitTestVisible="False"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>

                        <TextBox x:Name="CodeSelectableBox"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 IsReadOnly="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 SelectionBrush="{DynamicResource Brush.Accent.Base}"
                                 SelectionOpacity="0.45"
                                 TextWrapping="NoWrap"
                                 FontFamily="{DynamicResource Font.Code}"
                                 FontSize="12"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderThickness="0"
                                 Margin="0"
                                 Padding="0"
                                 SelectionChanged="CodeSelectableBox_SelectionChanged"
                                 PreviewMouseWheel="CodeSelectableBox_PreviewMouseWheel"/>
                    </Grid>
                </ScrollViewer>

                <!-- Empty State Message -->
                <Border x:Name="EmptyStateBorder"
                        Background="{DynamicResource Brush.Surface.Base}"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📄" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5"/>
                        <TextBlock Text="No code generated yet." Foreground="{DynamicResource Brush.Text.Primary}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Click 'Generate' to create code from your canvas." Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11.5" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ STATUS BAR ═══ -->
            <Border Grid.Row="5"
                    Background="{DynamicResource Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}"
                    BorderThickness="0,1,0,0"
                    Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Outdated / Stale Clickable Badge -->
                    <Border x:Name="BadgeStale"
                            Grid.Column="0"
                            Background="{DynamicResource Brush.Status.Warning}"
                            Opacity="0.85"
                            CornerRadius="4"
                            Padding="8,2"
                            Margin="0,0,12,0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            MouseLeftButtonDown="BadgeStale_Click"
                            ToolTip="Canvas has changed. Click here or press F5 to regenerate code.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟳ Code is outdated — click to regenerate"
                                       Foreground="#1E1E1E"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Stats & Info -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStats"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource Font.Code}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right Status: Cursor Pos & Shortcuts Info -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCursorPos"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource Font.Code}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtSpriteInfo"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
