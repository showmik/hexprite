<Window x:Class="Hexprite.Views.KeyboardShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Hexprite.Core"
        xmlns:vm="clr-namespace:Hexprite.ViewModels"
        xmlns:converters="clr-namespace:Hexprite.Converters"
        Title="Keyboard Shortcuts"
        Width="740" Height="560"
        MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface.Base}"
        FontFamily="{DynamicResource Font.Primary}"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="False"
        core:WindowChromeHelper.ForceRoundedCorners="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToInverseVisibilityConverter x:Key="BooleanToInverseVisibilityConverter" />
        <converters:BooleanToInverseVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource DialogWindowBorderStyle}">
        <Border.RenderTransform>
            <TranslateTransform Y="15" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction>
                                <ExponentialEase EasingMode="EaseOut" Exponent="4" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Title Bar -->
                <RowDefinition Height="Auto" /> <!-- Search Bar -->
                <RowDefinition Height="*" />    <!-- Content List -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. TITLE BAR -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.MenuBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource Brush.Accent.Base}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Keyboard Shortcuts"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   FontWeight="SemiBold"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Brush.Surface.Elevated}"
                                CornerRadius="10" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalShortcutCount, StringFormat='{}{0} shortcuts'}"
                                       FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" FontWeight="Normal"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="CaptionClose_Click" ToolTip="Close (Esc)" Width="44" Height="34"
                                Style="{StaticResource CaptionCloseButtonStyle}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. SEARCH BAR -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Base}" Padding="16,12,16,8">
                <Border Background="{DynamicResource Brush.Surface.Elevated}"
                        BorderBrush="{DynamicResource Brush.Border.Base}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <TextBox x:Name="TxtSearch"
                                 Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 CaretBrush="{DynamicResource Brush.Text.Primary}"
                                 FontSize="13"
                                 VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Search shortcuts (e.g. pencil, undo, layer, zoom)..."
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsSearchEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Grid.Column="2"
                                Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Width="20" Height="20"
                                Style="{StaticResource ModernButtonStyle}"
                                Click="ClearSearch_Click"
                                Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Clear search"/>
                    </Grid>
                </Border>
            </Border>

            <!-- 3. SHORTCUTS CONTENT -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,4,16,10">
                <Grid>
                    <!-- Groups View -->
                    <ItemsControl ItemsSource="{Binding FilteredGroups}"
                                  Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ShortcutCategoryGroup}">
                                <Border Margin="0,0,0,16"
                                        Background="{DynamicResource Brush.Surface.Elevated}"
                                        BorderBrush="{DynamicResource Brush.Border.Base}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10">
                                    <StackPanel>
                                        <!-- Category Header -->
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding CategoryIcon}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" FontSize="14"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                    Background="{DynamicResource Brush.Surface.Base}" CornerRadius="8" Padding="6,1">
                                                <TextBlock Text="{Binding Items.Count, StringFormat='{}{0}'}"
                                                           FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                            </Border>
                                        </DockPanel>

                                        <Rectangle Height="1" Fill="{DynamicResource Brush.Border.Separator}" Margin="0,0,0,8"/>

                                        <!-- Shortcut Items Grid -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ShortcutItemViewModel}">
                                                    <Border Padding="6,6" Margin="0,1"
                                                            CornerRadius="4"
                                                            Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Action info -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <!-- Key Badges -->
                                                            <ItemsControl Grid.Column="1"
                                                                          ItemsSource="{Binding KeyBadges}"
                                                                          VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource Brush.Surface.Base}"
                                                                                BorderBrush="{DynamicResource Brush.Border.Base}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="7,2"
                                                                                Margin="2,0"
                                                                                MinWidth="22">
                                                                            <TextBlock Text="{Binding}"
                                                                                       FontFamily="Consolas, Segoe UI, sans-serif"
                                                                                       FontWeight="SemiBold"
                                                                                       FontSize="11"
                                                                                       TextAlignment="Center"
                                                                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                                Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                   Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="No matching shortcuts found" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Try searching for a different keyword like 'undo', 'brush', or 'layer'."
                                   FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 4. FOOTER -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.MenuBar}" Padding="16,10"
                    BorderBrush="{DynamicResource Brush.Border.Separator}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tip: Press " FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                        <Border Background="{DynamicResource Brush.Surface.Elevated}"
                                BorderBrush="{DynamicResource Brush.Border.Base}"
                                BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="2,0">
                            <TextBlock Text="Ctrl + /" FontFamily="Consolas, sans-serif" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </Border>
                        <TextBlock Text=" anytime to toggle this cheat sheet" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Content="Close"
                            Width="80"
                            Height="28"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Close_Click"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
