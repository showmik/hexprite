<UserControl x:Class="Hexprite.Views.FontEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Hexprite.ViewModels"
             xmlns:core="clr-namespace:Hexprite.Core"
             xmlns:behaviors="clr-namespace:Hexprite.Behaviors"
             xmlns:converters="clr-namespace:Hexprite.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:FontViewModel}">

    <UserControl.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:FontExportFormatDisplayConverter x:Key="FontExportFormatDisplayConverter" />
        <converters:DisplayTypeDescriptionConverter x:Key="DisplayTypeDescriptionConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Minimal Pristine Flat Styles (Eliminates Wireframe Outlines in Dim Theme) -->
        <Style x:Key="FlatInspectorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Separator}" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatInspectorNumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource NumericTextBoxStyle}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Separator}" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatActionChipStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}" />
        </Style>

        <Style x:Key="FlatToggleChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource ModernToggleButtonStyle}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}" />
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Column 0: Glyph Map (Left Sidebar) -->
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="450" />
            <!-- Column 1: Splitter -->
            <ColumnDefinition Width="4" />
            <!-- Column 2: Canvas & Preview (Center) -->
            <ColumnDefinition Width="*" MinWidth="350" />
            <!-- Column 3: Splitter -->
            <ColumnDefinition Width="4" />
            <!-- Column 4: Properties & Export (Right Sidebar) -->
            <ColumnDefinition Width="280" MinWidth="230" MaxWidth="480" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             LEFT SIDEBAR: Glyph Map
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Base}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Header with Total & Filtered Count -->
                <Grid Grid.Row="0" Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="GLYPH MAP" Style="{StaticResource HeaderStyle}" Margin="0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" FontFamily="{DynamicResource Font.Code}">
                        <Run Text="{Binding FilteredGlyphCount, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding TotalGlyphCount, Mode=OneWay}" />
                    </TextBlock>
                </Grid>

                <!-- Search / Filter Box with Clear Button -->
                <Grid Grid.Row="1" Margin="8,0,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource FlatInspectorTextBoxStyle}" Height="26" FontSize="11" Padding="6,3"
                             Text="{Binding GlyphFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter glyphs by character, name, or hex (e.g. 'A', '41', 0x41)" />
                    <Button Grid.Column="1" Content="✕" Style="{StaticResource FlatActionChipStyle}"
                            Height="26" Width="26" Margin="4,0,0,0" Padding="0" FontSize="10"
                            Command="{Binding ClearFilterCommand}"
                            ToolTip="Clear search filter" />
                </Grid>

                <!-- Category Filter Pills (All, Letters, 0-9, Symbols, Edited) -->
                <UniformGrid Grid.Row="2" Rows="1" Margin="8,0,8,6">
                    <RadioButton Content="All" Style="{StaticResource ChipButtonStyle}" Margin="0,0,2,0" Height="22" Padding="0"
                                 HorizontalContentAlignment="Center"
                                 IsChecked="{Binding SelectedCategoryFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" />
                    <RadioButton Content="A-Z" Style="{StaticResource ChipButtonStyle}" Margin="0,0,2,0" Height="22" Padding="0"
                                 HorizontalContentAlignment="Center"
                                 ToolTip="Letters (A-Z, a-z)"
                                 IsChecked="{Binding SelectedCategoryFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Letters}" />
                    <RadioButton Content="0-9" Style="{StaticResource ChipButtonStyle}" Margin="0,0,2,0" Height="22" Padding="0"
                                 HorizontalContentAlignment="Center"
                                 ToolTip="Digits (0-9)"
                                 IsChecked="{Binding SelectedCategoryFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Numbers}" />
                    <RadioButton Content="Sym" Style="{StaticResource ChipButtonStyle}" Margin="0,0,2,0" Height="22" Padding="0"
                                 HorizontalContentAlignment="Center"
                                 ToolTip="Symbols &amp; Punctuation"
                                 IsChecked="{Binding SelectedCategoryFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Symbols}" />
                    <RadioButton Content="★ Edit" Style="{StaticResource ChipButtonStyle}" Margin="0" Height="22" Padding="0"
                                 HorizontalContentAlignment="Center"
                                 ToolTip="Customized glyphs only"
                                 IsChecked="{Binding SelectedCategoryFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CustomizedOnly}" />
                </UniformGrid>

                <!-- Glyph List -->
                <ListBox Grid.Row="3" ItemsSource="{Binding FilteredGlyphMap}"
                         SelectedItem="{Binding SelectedGlyphItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Margin="4,0,4,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,3" />
                            <Setter Property="Margin" Value="2,1" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.Surface.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.Surface.Active}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                </Grid.ColumnDefinitions>

                                <!-- Mini Preview Box (clean, borderless thumbnail) -->
                                <Border Grid.Column="0"
                                        CornerRadius="2"
                                        Background="#FF1A1A1A"
                                        Width="20" Height="20">
                                    <Image Source="{Binding MiniPreviewBitmap}" Width="16" Height="16"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Display Label -->
                                <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0" />

                                <!-- Hex Code Pill -->
                                <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Control}"
                                        CornerRadius="3" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HexCode}" FontSize="9"
                                               FontFamily="{DynamicResource Font.Code}"
                                               Foreground="{DynamicResource Brush.Text.Muted}" />
                                </Border>

                                <!-- Customized Indicator Dot -->
                                <Ellipse Grid.Column="3" Width="5" Height="5"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{DynamicResource Brush.Accent.Base}"
                                         ToolTip="Glyph has custom artwork"
                                         Visibility="{Binding IsCustomized, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Left Splitter -->
        <GridSplitter Grid.Column="1"
                      Style="{StaticResource ModernGridSplitterStyle}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" />

        <!-- ═══════════════════════════════════════════════════════════════
             CENTER: Canvas + Preview
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Canvas Toolbar -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}" BorderThickness="0,0,0,1"
                    Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active Glyph Status (Clean flat indicator) -->
                    <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Control}"
                            CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="'" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12" />
                            <TextBlock Text="{Binding ActiveGlyphChar, Mode=OneWay}"
                                       FontSize="12" FontWeight="Bold" Width="16" TextAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent.Base}" />
                            <TextBlock Text="'" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12" Margin="0,0,4,0" />

                            <TextBlock Text="{Binding HexCode, Mode=OneWay}"
                                       FontFamily="{DynamicResource Font.Code}" Width="36" TextAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11" FontWeight="SemiBold" />

                            <Rectangle Width="1" Height="12" Fill="{DynamicResource Brush.Border.Separator}" Margin="8,0" VerticalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" Width="56" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding GlyphWidth, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11" />
                                <TextBlock Text="×" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" />
                                <TextBlock Text="{Binding GlyphHeight, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11" />
                                <TextBlock Text=" px" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" />
                            </StackPanel>

                            <Rectangle Width="1" Height="12" Fill="{DynamicResource Brush.Border.Separator}" Margin="8,0" VerticalAlignment="Center" />

                            <TextBlock Text="Cursor: " Foreground="{DynamicResource Brush.Text.Muted}" FontSize="11" />
                            <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource Font.Code}" Width="44" TextAlignment="Left">
                                <Run Text="{Binding CursorX, Mode=OneWay}" /><Run Text="," /><Run Text="{Binding CursorY, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Nudge Tools (Clean inline D-Pad) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="NUDGE" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <StackPanel Orientation="Horizontal">
                            <!-- Shift Left -->
                            <Button Style="{StaticResource CompactIconButtonStyle}" Width="24" Height="24"
                                    Command="{Binding NudgeLeftCommand}" ToolTip="Shift Left (Ctrl+←)">
                                <Path Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 14,5 L 7,12 L 14,19" Stretch="Uniform" Width="8" Height="10" />
                            </Button>
                            <!-- Shift Right -->
                            <Button Style="{StaticResource CompactIconButtonStyle}" Width="24" Height="24"
                                    Command="{Binding NudgeRightCommand}" ToolTip="Shift Right (Ctrl+→)">
                                <Path Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 10,5 L 17,12 L 10,19" Stretch="Uniform" Width="8" Height="10" />
                            </Button>
                            <!-- Shift Up -->
                            <Button Style="{StaticResource CompactIconButtonStyle}" Width="24" Height="24"
                                    Command="{Binding NudgeUpCommand}" ToolTip="Shift Up (Ctrl+↑)">
                                <Path Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 5,14 L 12,7 L 19,14" Stretch="Uniform" Width="10" Height="8" />
                            </Button>
                            <!-- Shift Down -->
                            <Button Style="{StaticResource CompactIconButtonStyle}" Width="24" Height="24"
                                    Command="{Binding NudgeDownCommand}" ToolTip="Shift Down (Ctrl+↓)">
                                <Path Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 5,10 L 12,17 L 19,10" Stretch="Uniform" Width="10" Height="8" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- View Toggles & Zoom Bar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Overlays: Grid, Guides, Advance -->
                        <ToggleButton Content="Grid" IsChecked="{Binding ShowGridLines, Mode=TwoWay}"
                                      Style="{StaticResource FlatToggleChipStyle}" Padding="8,0" Height="24"
                                      ToolTip="Toggle Pixel Grid Lines" Margin="0,0,2,0" />
                        <ToggleButton Content="Guides" IsChecked="{Binding ShowMetricsGuides, Mode=TwoWay}"
                                      Style="{StaticResource FlatToggleChipStyle}" Padding="8,0" Height="24"
                                      ToolTip="Toggle Baseline, Ascent &amp; Descent Lines" Margin="0,0,2,0" />
                        <ToggleButton Content="Advance" IsChecked="{Binding ShowAdvanceGuide, Mode=TwoWay}"
                                      Style="{StaticResource FlatToggleChipStyle}" Padding="8,0" Height="24"
                                      ToolTip="Toggle X-Advance Guide Line" Margin="0,0,8,0" />

                        <Rectangle Width="1" Height="16" Fill="{DynamicResource Brush.Border.Separator}" Margin="0,0,8,0" VerticalAlignment="Center" />

                        <!-- Zoom Controls -->
                        <Button Style="{StaticResource CompactIconButtonStyle}" Width="22" Height="22"
                                Click="BtnZoomOut_Click" ToolTip="Zoom Out (Ctrl+-)">
                            <Path Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.5"
                                  Data="M 4,10 H 16" Stretch="Uniform" Width="8" Height="2" />
                        </Button>

                        <Slider Value="{Binding CellSize, Mode=TwoWay}" Minimum="4" Maximum="128"
                                Width="85" VerticalAlignment="Center" Margin="4,0"
                                TickFrequency="2" IsSnapToTickEnabled="True"
                                ToolTip="Zoom Scale (Ctrl+Scroll)" />

                        <Button Style="{StaticResource CompactIconButtonStyle}" Width="22" Height="22"
                                Click="BtnZoomIn_Click" ToolTip="Zoom In (Ctrl++)">
                            <Path Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="1.5"
                                  Data="M 4,10 H 16 M 10,4 V 16" Stretch="Uniform" Width="8" Height="8" />
                        </Button>

                        <TextBlock Text="{Binding CellSize, StringFormat={}{0}x}"
                                   Foreground="{DynamicResource Brush.Accent.Base}"
                                   FontWeight="Bold" FontSize="11"
                                   VerticalAlignment="Center" Margin="4,0,4,0" Width="30" TextAlignment="Center" />

                        <Button Style="{StaticResource FlatActionChipStyle}"
                                ToolTip="Fit Glyph to Screen"
                                Padding="8,0" Height="24"
                                Click="BtnResetZoom_Click">
                            <TextBlock Text="Fit" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Glyph Canvas Viewport (Single clean frame, no duplicate borders) -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Elevated}"
                    Margin="6" CornerRadius="4" ClipToBounds="True"
                    BorderBrush="{DynamicResource Brush.Border.Separator}" BorderThickness="1">
                <ScrollViewer x:Name="MainScrollViewer"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="Canvas_PreviewMouseWheel"
                              PreviewMouseDown="Canvas_ScrollViewer_MouseDown"
                              PreviewMouseMove="Canvas_ScrollViewer_MouseMove"
                              PreviewMouseUp="Canvas_ScrollViewer_MouseUp">
                    <Grid MinWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                          MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <Image Source="{Binding CanvasBitmap}" 
                               RenderOptions.BitmapScalingMode="NearestNeighbor" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Stretch="None"
                               MouseLeftButtonDown="Canvas_MouseDown"
                               MouseRightButtonDown="Canvas_MouseDown"
                               MouseMove="Canvas_MouseMove"
                               MouseLeftButtonUp="Canvas_MouseUp"
                               MouseRightButtonUp="Canvas_MouseUp"
                               MouseLeave="Canvas_MouseLeave"
                               LostMouseCapture="Canvas_LostMouseCapture" />
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Live Hardware Preview Studio -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Brush.Border.Separator}" BorderThickness="0,1,0,0"
                    Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview Controls Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Hardware Display Simulator + Scale -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DISPLAY" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox SelectedItem="{Binding PreviewDisplayType, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Width="105" Height="24" Padding="4,2" FontSize="11" Margin="0,0,6,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource DisplayTypeDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <core:DisplayType>GenericWhite</core:DisplayType>
                                <core:DisplayType>SSD1306Blue</core:DisplayType>
                                <core:DisplayType>SSD1306Green</core:DisplayType>
                                <core:DisplayType>FlipperZero</core:DisplayType>
                                <core:DisplayType>ePaper</core:DisplayType>
                            </ComboBox>

                            <!-- Scale Switcher (1x, 2x, 4x, Auto) -->
                            <TextBlock Text="SCALE" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <RadioButton Content="1x" Style="{StaticResource ChipButtonStyle}" Margin="0,0,2,0" Height="22" Padding="5,1"
                                         IsChecked="{Binding PreviewScale, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=1}" ToolTip="1x Native Hardware Scale" />
                            <RadioButton Content="2x" Style="{StaticResource ChipButtonStyle}" Margin="0,0,2,0" Height="22" Padding="5,1"
                                         IsChecked="{Binding PreviewScale, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=2}" ToolTip="2x Scaled" />
                            <RadioButton Content="4x" Style="{StaticResource ChipButtonStyle}" Margin="0,0,2,0" Height="22" Padding="5,1"
                                         IsChecked="{Binding PreviewScale, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=4}" ToolTip="4x Scaled" />
                            <RadioButton Content="Auto" Style="{StaticResource ChipButtonStyle}" Margin="0,0,4,0" Height="22" Padding="5,1"
                                         IsChecked="{Binding PreviewScale, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=0}" ToolTip="Auto-fit to Container" />

                            <!-- Invert Toggle -->
                            <ToggleButton Content="Invert" IsChecked="{Binding PreviewInverted, Mode=TwoWay}"
                                          Style="{StaticResource FlatToggleChipStyle}" Padding="5,0" Height="22"
                                          FontSize="10" ToolTip="Invert Ink and Background colors" />
                        </StackPanel>

                        <!-- String Presets -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PRESETS" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Style="{StaticResource FlatActionChipStyle}" Content="Fox" Padding="5,0" Height="22" Margin="0,0,2,0"
                                    Command="{Binding SetPreviewPresetCommand}" CommandParameter="The quick brown fox jumps over the lazy dog"
                                    ToolTip="Full alphabet sentence" />
                            <Button Style="{StaticResource FlatActionChipStyle}" Content="0-9" Padding="5,0" Height="22" Margin="0,0,2,0"
                                    Command="{Binding SetPreviewPresetCommand}" CommandParameter="0123456789 +-/*= (%)"
                                    ToolTip="Digits &amp; Math symbols" />
                            <Button Style="{StaticResource FlatActionChipStyle}" Content="Aa" Padding="5,0" Height="22" Margin="0,0,2,0"
                                    Command="{Binding SetPreviewPresetCommand}" CommandParameter="ABCDEFGHIJKLMNOPQRSTUVWXYZ&#x0a;abcdefghijklmnopqrstuvwxyz"
                                    ToolTip="Uppercase &amp; Lowercase pairs" />
                            <Button Style="{StaticResource FlatActionChipStyle}" Content="Sym" Padding="5,0" Height="22" Margin="0,0,2,0"
                                    Command="{Binding SetPreviewPresetCommand}" CommandParameter="!@#$%^&amp;*()_+-=[]{}|;:&apos;&quot;,&lt;.&gt;?/`~"
                                    ToolTip="Special punctuation symbols" />
                            <Button Style="{StaticResource FlatActionChipStyle}" Content="Copy" Padding="6,0" Height="22"
                                    Command="{Binding CopyPreviewTextCommand}" ToolTip="Copy Preview Text to Clipboard" />
                        </StackPanel>
                    </Grid>

                    <!-- Preview Text Input (Direct sleek TextBox) -->
                    <TextBox Grid.Row="1" Style="{StaticResource FlatInspectorTextBoxStyle}"
                             Text="{Binding PreviewText, UpdateSourceTrigger=PropertyChanged}"
                             Height="26" Padding="8,3" FontSize="11" Margin="0,0,0,6"
                             ToolTip="Type custom text to preview with this font in real-time" />

                    <!-- Live Hardware Preview Display -->
                    <Border Grid.Row="2" Background="#FF161B22"
                            BorderBrush="{DynamicResource Brush.Border.Separator}" BorderThickness="1"
                            Height="72" CornerRadius="4" Padding="6">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image Source="{Binding PreviewBitmap}"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Stretch="None" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Splitter -->
        <GridSplitter Grid.Column="3"
                      Style="{StaticResource ModernGridSplitterStyle}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" />

        <!-- ═══════════════════════════════════════════════════════════════
             RIGHT SIDEBAR: Properties & Export
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="4" Background="{DynamicResource Brush.Surface.Base}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <StackPanel Margin="10,8,10,10">

                    <!-- ── Card 1: Font Properties ── -->
                    <Border Background="{DynamicResource Brush.Surface.Panel}"
                            BorderThickness="0"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="FONT PROPERTIES" Style="{StaticResource HeaderStyle}" Margin="0,0,0,8" />

                            <TextBlock Text="Font Name" Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="11" Margin="0,0,0,3" />
                            <TextBox Style="{StaticResource FlatInspectorTextBoxStyle}" Text="{Binding FontName, UpdateSourceTrigger=LostFocus}"
                                     Padding="6,3" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cell Height (px)" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="11" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource FlatInspectorNumericTextBoxStyle}" Text="{Binding CellHeight, UpdateSourceTrigger=LostFocus}"
                                             behaviors:NumericScrubBehavior.ScrubStartedCommand="{Binding ScrubStartedCommand}" behaviors:NumericScrubBehavior.ScrubEndedCommand="{Binding ScrubEndedCommand}"
                                             behaviors:NumericScrubBehavior.KeyboardScrubStartedCommand="{Binding KeyboardScrubStartedCommand}" behaviors:NumericScrubBehavior.KeyboardScrubEndedCommand="{Binding KeyboardScrubEndedCommand}"
                                             Padding="6,3" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Baseline (px)" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="11" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource FlatInspectorNumericTextBoxStyle}" Text="{Binding Baseline, UpdateSourceTrigger=LostFocus}"
                                             behaviors:NumericScrubBehavior.ScrubStartedCommand="{Binding ScrubStartedCommand}" behaviors:NumericScrubBehavior.ScrubEndedCommand="{Binding ScrubEndedCommand}"
                                             behaviors:NumericScrubBehavior.KeyboardScrubStartedCommand="{Binding KeyboardScrubStartedCommand}" behaviors:NumericScrubBehavior.KeyboardScrubEndedCommand="{Binding KeyboardScrubEndedCommand}"
                                             Padding="6,3" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Y-Advance (px)" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="11" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource FlatInspectorNumericTextBoxStyle}" Text="{Binding YAdvance, UpdateSourceTrigger=LostFocus}"
                                             behaviors:NumericScrubBehavior.ScrubStartedCommand="{Binding ScrubStartedCommand}" behaviors:NumericScrubBehavior.ScrubEndedCommand="{Binding ScrubEndedCommand}"
                                             behaviors:NumericScrubBehavior.KeyboardScrubStartedCommand="{Binding KeyboardScrubStartedCommand}" behaviors:NumericScrubBehavior.KeyboardScrubEndedCommand="{Binding KeyboardScrubEndedCommand}"
                                             Padding="6,3" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Max Width (px)" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="11" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource FlatInspectorNumericTextBoxStyle}" Text="{Binding MaxCellWidth, UpdateSourceTrigger=LostFocus}"
                                             behaviors:NumericScrubBehavior.ScrubStartedCommand="{Binding ScrubStartedCommand}" behaviors:NumericScrubBehavior.ScrubEndedCommand="{Binding ScrubEndedCommand}"
                                             behaviors:NumericScrubBehavior.KeyboardScrubStartedCommand="{Binding KeyboardScrubStartedCommand}" behaviors:NumericScrubBehavior.KeyboardScrubEndedCommand="{Binding KeyboardScrubEndedCommand}"
                                             Padding="6,3" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Monospaced (Fixed Width)" IsChecked="{Binding IsMonospaced, Mode=TwoWay}"
                                      Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4" />
                            <CheckBox Content="Auto-Advance" IsChecked="{Binding AutoAdvance, Mode=TwoWay}"
                                      Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8" />

                            <!-- Character Range -->
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="First Char (ASCII)" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="11" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource FlatInspectorNumericTextBoxStyle}" Text="{Binding FirstChar, UpdateSourceTrigger=LostFocus}"
                                             Padding="6,3" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Last Char (ASCII)" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="11" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource FlatInspectorNumericTextBoxStyle}" Text="{Binding LastChar, UpdateSourceTrigger=LostFocus}"
                                             Padding="6,3" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 2: Active Glyph Metrics ── -->
                    <Border Background="{DynamicResource Brush.Surface.Panel}"
                            BorderThickness="0"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="ACTIVE GLYPH METRICS" Style="{StaticResource HeaderStyle}" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Width (px)" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="11" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource FlatInspectorNumericTextBoxStyle}" Text="{Binding GlyphWidth, UpdateSourceTrigger=LostFocus}"
                                             behaviors:NumericScrubBehavior.ScrubStartedCommand="{Binding ScrubStartedCommand}" behaviors:NumericScrubBehavior.ScrubEndedCommand="{Binding ScrubEndedCommand}"
                                             behaviors:NumericScrubBehavior.KeyboardScrubStartedCommand="{Binding KeyboardScrubStartedCommand}" behaviors:NumericScrubBehavior.KeyboardScrubEndedCommand="{Binding KeyboardScrubEndedCommand}"
                                             Padding="6,3" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="X-Advance (px)" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="11" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource FlatInspectorNumericTextBoxStyle}" Text="{Binding XAdvance, UpdateSourceTrigger=LostFocus}"
                                             behaviors:NumericScrubBehavior.ScrubStartedCommand="{Binding ScrubStartedCommand}" behaviors:NumericScrubBehavior.ScrubEndedCommand="{Binding ScrubEndedCommand}"
                                             behaviors:NumericScrubBehavior.KeyboardScrubStartedCommand="{Binding KeyboardScrubStartedCommand}" behaviors:NumericScrubBehavior.KeyboardScrubEndedCommand="{Binding KeyboardScrubEndedCommand}"
                                             Padding="6,3" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X-Offset (px)" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="11" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource FlatInspectorNumericTextBoxStyle}" Text="{Binding XOffset, UpdateSourceTrigger=LostFocus}"
                                             behaviors:NumericScrubBehavior.MinValue="-128"
                                             behaviors:NumericScrubBehavior.ScrubStartedCommand="{Binding ScrubStartedCommand}" behaviors:NumericScrubBehavior.ScrubEndedCommand="{Binding ScrubEndedCommand}"
                                             behaviors:NumericScrubBehavior.KeyboardScrubStartedCommand="{Binding KeyboardScrubStartedCommand}" behaviors:NumericScrubBehavior.KeyboardScrubEndedCommand="{Binding KeyboardScrubEndedCommand}"
                                             Padding="6,3" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y-Offset (px)" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               FontSize="11" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource FlatInspectorNumericTextBoxStyle}" Text="{Binding YOffset, UpdateSourceTrigger=LostFocus}"
                                             behaviors:NumericScrubBehavior.MinValue="-128"
                                             behaviors:NumericScrubBehavior.ScrubStartedCommand="{Binding ScrubStartedCommand}" behaviors:NumericScrubBehavior.ScrubEndedCommand="{Binding ScrubEndedCommand}"
                                             behaviors:NumericScrubBehavior.KeyboardScrubStartedCommand="{Binding KeyboardScrubStartedCommand}" behaviors:NumericScrubBehavior.KeyboardScrubEndedCommand="{Binding KeyboardScrubEndedCommand}"
                                             Padding="6,3" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── Card 3: Export Settings & Flash ── -->
                    <Border Background="{DynamicResource Brush.Surface.Panel}"
                            BorderThickness="0"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="EXPORT &amp; FLASH BUDGET" Style="{StaticResource HeaderStyle}" Margin="0,0,0,8" />

                            <TextBlock Text="Target Format" Foreground="{DynamicResource Brush.Text.Secondary}"
                                       FontSize="11" Margin="0,0,0,3" />
                            <ComboBox Style="{StaticResource ModernComboBoxStyle}" SelectedItem="{Binding ExportFormat, Mode=TwoWay}"
                                      Margin="0,0,0,8" Padding="6,4">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource FontExportFormatDisplayConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <core:FontExportFormat>AdafruitGfx</core:FontExportFormat>
                                <core:FontExportFormat>U8g2Bdf</core:FontExportFormat>
                                <core:FontExportFormat>Lvgl</core:FontExportFormat>
                                <core:FontExportFormat>RawCArray</core:FontExportFormat>
                                <core:FontExportFormat>FlipperZero</core:FontExportFormat>
                            </ComboBox>

                            <CheckBox Content="Include Glyph Previews"
                                      IsChecked="{Binding IncludeGlyphPreview, Mode=TwoWay}"
                                      Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4" />
                            <CheckBox Content="Include Metric Comments"
                                      IsChecked="{Binding IncludeMetricComments, Mode=TwoWay}"
                                      Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4" />
                            <CheckBox Content="Uppercase Hex Literals"
                                      IsChecked="{Binding UppercaseHex, Mode=TwoWay}"
                                      Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8" />

                            <!-- Flash Size Indicator (Clean flat stat block, no box-in-box) -->
                            <StackPanel Margin="0,4,0,8">
                                <TextBlock Text="ESTIMATED FLASH USAGE" Foreground="{DynamicResource Brush.Text.Muted}"
                                           FontSize="9" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <TextBlock Foreground="{DynamicResource Brush.Accent.Base}" FontSize="15" FontWeight="Bold">
                                    <Run Text="{Binding EstimatedFlashBytes, Mode=OneWay}" /><Run Text=" bytes" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource Brush.Text.Muted}" />
                                </TextBlock>
                            </StackPanel>

                            <Button Style="{StaticResource ModernButtonStyle}" Content="Import Font..." Command="{Binding ImportFontCommand}"
                                    Padding="8,5" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                            <Button Style="{StaticResource AccentButtonStyle}" Content="Export Font..." Command="{Binding ExportFontCommand}"
                                    Background="{DynamicResource Brush.Accent.Base}" Foreground="White"
                                    Padding="8,5" Margin="0,0,0,0" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- ── Card 4: Keyboard Shortcuts Cheatsheet ── -->
                    <Border Background="{DynamicResource Brush.Surface.Panel}"
                            BorderThickness="0"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource HeaderStyle}" Margin="0,0,0,6" />

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Control}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                    <TextBlock Text="← →" FontFamily="{DynamicResource Font.Code}" FontSize="10" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Navigate glyphs" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Control}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl+Arrows" FontFamily="{DynamicResource Font.Code}" FontSize="10" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Nudge pixels" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Control}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl+Z / Y" FontFamily="{DynamicResource Font.Code}" FontSize="10" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Undo / Redo" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Control}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                    <TextBlock Text="Ctrl+±" FontFamily="{DynamicResource Font.Code}" FontSize="10" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Zoom in / out" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Control}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                    <TextBlock Text="Scroll" FontFamily="{DynamicResource Font.Code}" FontSize="10" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Mouse wheel zoom" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Control}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                    <TextBlock Text="Mid / Space" FontFamily="{DynamicResource Font.Code}" FontSize="10" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Pan canvas" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Control}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left">
                                    <TextBlock Text="Right-click" FontFamily="{DynamicResource Font.Code}" FontSize="10" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Erase pixel" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
