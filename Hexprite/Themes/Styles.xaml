    <!-- ═══════════════════════════════════════════════════════════════
         Dark-themed Menu bar
         ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="ThemedMenuStyle" TargetType="{x:Type Menu}">
        <Setter Property="Background"
                Value="{DynamicResource Brush.Surface.MenuBar}" />
        <Setter Property="Foreground"
                Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontSize"
                Value="12" />
        <Setter Property="Padding"
                Value="4,2" />
    </Style>
    <Style TargetType="{x:Type Menu}" BasedOn="{StaticResource ThemedMenuStyle}" />

    <!-- Checkmark geometry shared by checkable MenuItems -->
